program Pst

## The command line tool (SPEC §15): `check`, `build`, `run`, `test`, `fmt`, `lsp`, `mcp`,
## `query`, `index`, and the `tokens` and `ast` dumps. The standard units are found in
## `units` next to the executable.

uses IO, OS, Strings, Source, Ast, Diagnostics, Typecheck, Emit, Fmt, Lsp, Mcp, Query, Paths, LexDump, AstDump

const
    Usage = "usage: pst check FILE [--json]\n       pst build FILE [-o OUT] [--unchecked] [--json]\n       pst run [--unchecked] FILE [-- ARGS]\n       pst test PATH [--filter TEXT] [--unchecked] [--json]\n       pst fmt PATH [--check]\n       pst lsp\n       pst mcp [--root DIR]\n       pst query def|refs|type|hover|impls|callers|callees|accepts|instances FILE:LINE:COL|NAME\n       pst query complete FILE:LINE:COL\n       pst query explain CODE\n       pst query symbols [PATH]\n       pst index [PATH]\n       pst tokens FILE\n       pst ast FILE"

type
    Options = record
        command: String
        file: String
        output: String
        json: Boolean
        unchecked: Boolean
        filter: String
        check: Boolean
        rest: List[String]

procedure usage(message: String)
    writelnErr(Usage)
    writelnErr("pst: error: {message}")
    exit(2)

## The command line, or exits with status 2 after a usage message.
function parseArgs(a: List[String]): Options
    if len(a) = 0 then
        usage("missing command")
    var o := Options(
        command: a[0],
        file: "",
        output: "",
        json: false,
        unchecked: false,
        filter: "",
        check: false,
        rest: [],
    )
    if not (o.command in [
        "check",
        "build",
        "run",
        "test",
        "fmt",
        "lsp",
        "mcp",
        "query",
        "index",
        "tokens",
        "ast",
    ]) then
        usage("unknown command '{o.command}'")
    if o.command = "query" then
        return queryArgs(a, o)
    if o.command = "index" then
        return indexArgs(a, o)
    if o.command = "mcp" then
        return mcpArgs(a, o)
    let dump := o.command in ["tokens", "ast", "fmt", "lsp"]
    var i := 1
    while i < len(a) do
        let x := a[i]
        i := i + 1
        if o.command = "run" and o.file <> "" then
            add(var o.rest, x)
        else if x = "--json" and o.command <> "run" and not dump then
            o.json := true
        else if x = "--unchecked" and o.command <> "check" and not dump then
            o.unchecked := true
        else if (x = "-o" or x = "--output") and o.command = "build" then
            if i = len(a) then
                usage("argument -o/--output: expected one argument")
            o.output := a[i]
            i := i + 1
        else if x = "--check" and o.command = "fmt" then
            o.check := true
        else if x = "--filter" and o.command = "test" then
            if i = len(a) then
                usage("argument --filter: expected one argument")
            o.filter := a[i]
            i := i + 1
        else if startsWith(x, prefix: "-") or o.file <> "" then
            usage("unrecognized argument '{x}'")
        else
            o.file := x
    if o.command = "lsp" then
        if o.file <> "" then
            usage("unrecognized argument '{o.file}'")
    else if o.file = "" then
        usage("missing FILE or PATH")
    if len(o.rest) > 0 and o.rest[0] = "--" then
        remove(var o.rest, 0)
    return o

## The arguments of `pst query`: the request in `filter`, its position or path in
## `file`. `--json` is accepted, since the output is always JSON.
function queryArgs(a: List[String], o: Options): Options
    var q := o
    var words: List[String] := []
    for i := 1 to len(a) - 1 do
        if a[i] <> "--json" then
            add(var words, a[i])
    if len(words) = 0 then
        usage("missing query")
    q.filter := words[0]
    if q.filter = "symbols" then
        q.file := "."
        if len(words) = 2 then
            q.file := words[1]
    else if q.filter in [
        "def",
        "refs",
        "type",
        "hover",
        "complete",
        "impls",
        "callers",
        "callees",
        "accepts",
        "instances",
        "explain",
    ] then
        if len(words) < 2 and q.filter = "explain" then
            usage("missing CODE")
        if len(words) < 2 then
            usage("missing FILE:LINE:COL or NAME")
        q.file := words[1]
    else
        usage("unknown query '{q.filter}'")
    if len(words) > 2 or (q.filter <> "symbols" and len(words) <> 2) then
        usage("unrecognized argument '{words[len(words) - 1]}'")
    return q

## The arguments of `pst index`: the path in `file`, by default the current directory.
## `--json` is accepted, since the output is always JSON.
function indexArgs(a: List[String], o: Options): Options
    var q := o
    for i := 1 to len(a) - 1 do
        if a[i] = "--json" then
            continue
        if startsWith(a[i], prefix: "-") or q.file <> "" then
            usage("unrecognized argument '{a[i]}'")
        q.file := a[i]
    if q.file = "" then
        q.file := "."
    return q

## The arguments of `pst mcp`: the project root in `file`, by default the current
## directory.
function mcpArgs(a: List[String], o: Options): Options
    var q := o
    q.file := "."
    var i := 1
    while i < len(a) do
        if a[i] = "--root" and i + 1 < len(a) then
            q.file := a[i + 1]
            i := i + 2
        else
            usage("unrecognized argument '{a[i]}'")
    return q

## The directory part of `path`: `.` if it has none.
function dirName(path: String): String
    var parts := split(path, sep: "/")
    removeLast(var parts)
    if len(parts) = 0 then
        return "."
    if len(parts) = 1 and parts[0] = "" then
        return "/"
    return join(parts, sep: "/")

## The file name of `path` without its directory and extension.
function stem(path: String): String
    let parts := split(path, sep: "/")
    let name := parts[len(parts) - 1]
    var pieces := split(name, sep: ".")
    if len(pieces) > 1 and pieces[0] <> "" then
        removeLast(var pieces)
        return join(pieces, sep: ".")
    return name

procedure report(ds: List[Diagnostic], asJson: Boolean)
    for d in ds do
        if asJson then
            writeln(json(d))
        else
            writelnErr(human(d))

function hasErrors(ds: List[Diagnostic]): Boolean
    for d in ds do
        if d.severity = Severity.Error then
            return true
    return false

procedure fatal(message: String)
    writelnErr("pst: error: {message}")
    exit(1)

## Drops the type checkers that `typecheck(..., keep: true)` kept: they refer to the
## environment, a cycle.
procedure forget(result: Checked)
    case result.env of
        Some(env):
            env.value.checkers := {}
            env.value.constCheckers := {}
        None:
            return

## Checks and compiles `path` into the executable `out`, and prints the diagnostics.
## Whether it succeeded.
function buildTo(
    path: String,
    stdDir: String,
    out: String,
    asJson: Boolean,
    checked: Boolean,
): Boolean
    let result := typecheck(path, stdDir: stdDir, keep: true)
    let ds := result.resolved.checker.diagnostics
    if hasErrors(ds) then
        forget(result)
        report(ds, asJson: asJson)
        return false
    let built := build(result, checked: checked)
    forget(result)
    report(ds, asJson: asJson)
    report(built.diagnostics, asJson: asJson)
    case built.executable of
        Some(exe):
            writeExe(out, exe.value)
            return true
        None:
            return false

## Writes the executable `exe` to `out`, with mode 0o755.
procedure writeExe(out: String, exe: List[Byte])
    case create(out, mode: 0o755) of
        Ok(f):
            case writeBytes(f.value, exe) of
                Ok(_):
                    _ := close(f.value)
                Err(e):
                    fatal(e.error)
        Err(e):
            fatal(e.error)

## The lines of `text`, without their newlines.
function lines(text: String): List[String]
    var ls := split(text, sep: "\n")
    if ls[len(ls) - 1] = "" then
        removeLast(var ls)
    return ls

## The test blocks of a file.
function testsOf(file: SourceFile): List[TestBlock]
    var tests: List[TestBlock] := []
    for item in file.items do
        case item of
            Decl(d):
                case d of
                    TestBlock(t):
                        add(var tests, t)
                    else:
                        pass
            else:
                pass
    return tests

type
    Tally = record
        passed: Integer
        failed: Integer
        built: Boolean

## Builds and runs the tests of one file (SPEC §13) in directory `tmp`.
function testFile(path: String, stdDir: String, o: Options, tmp: String): Tally
    var tally := Tally(passed: 0, failed: 0, built: false)
    let result := typecheck(path, stdDir: stdDir, keep: true)
    let ds := result.resolved.checker.diagnostics
    if hasErrors(ds) then
        forget(result)
        report(ds, asJson: o.json)
        return tally
    let built := build(result, checked: not o.unchecked, tests: true)
    forget(result)
    report(ds, asJson: o.json)
    report(built.diagnostics, asJson: o.json)
    if built.executable.isNone() then
        return tally
    tally.built := true
    let exe := "{tmp}/tests"
    let output := "{tmp}/output"
    writeExe(exe, built.executable.get())
    let tests := testsOf(result.resolved.main.get().parsed.file)
    for i := 0 to len(tests) - 1 do
        let t := tests[i]
        if find(t.name, sub: o.filter).isNone() then
            continue
        var code := 1
        case run(exe, ["{i}"], output: output) of
            Ok(c):
                code := c.value
            Err(e):
                fatal(e.error)
        var text := ""
        case open(output) of
            Ok(f):
                text := readAll(f.value).getOr("")
            Err(e):
                fatal(e.error)
        let ok := code = 0
        if ok then
            tally.passed := tally.passed + 1
        else
            tally.failed := tally.failed + 1
        if o.json then
            writeln("\{\"file\": {jsonString(path)}, {jsonSpan(t.span)}, \"test\": {jsonString(t.name)}, \"passed\": {ok}, \"output\": {jsonString(text)}}")
        else if ok then
            writeln("ok   {path}:{t.span.line}: {t.name}")
        else
            writeln("FAIL {path}:{t.span.line}: {t.name}")
            for l in lines(text) do
                writeln("    {l}")
            if code <> 70 then
                writeln("    exit status {code}")
    _ := removeFile(output)
    _ := removeFile(exe)
    return tally

## `path`, or the `.pst` files in it if it's a directory, sorted.
function sourceFiles(path: String): List[String]
    case pstFiles(path) of
        Ok(files):
            return files.value
        Err(e):
            fatal(e.error)
            return []

## The text of the file at `path`.
function readSource(path: String): String
    var text := ""
    case open(path) of
        Ok(f):
            case readAll(f.value) of
                Ok(t):
                    text := t.value
                Err(e):
                    fatal(e.error)
            _ := close(f.value)
        Err(e):
            fatal(e.error)
    return text

## Formats the files of `o.file` in place, or with `--check` only lists those that would
## change (SPEC §15.3). The changed files are listed.
procedure fmtCommand(o: Options)
    var changed := false
    var failed := false
    for path in sourceFiles(o.file) do
        let text := readSource(path)
        case format(text, file: path) of
            Ok(f):
                if f.value <> text then
                    writeln(path)
                    changed := true
                    if not o.check then
                        case create(path) of
                            Ok(out):
                                case writeAll(out.value, text: f.value) of
                                    Ok(_):
                                        _ := close(out.value)
                                    Err(e):
                                        fatal(e.error)
                            Err(e):
                                fatal(e.error)
            Err(ds):
                report(ds.error, asJson: false)
                failed := true
    if failed or (o.check and changed) then
        exit(1)

procedure testCommand(o: Options, stdDir: String)
    let files := sourceFiles(o.file)
    var dir := ""
    case tempDir() of
        Ok(d):
            dir := d.value
        Err(e):
            fatal(e.error)
    var passed := 0
    var failed := 0
    var built := true
    for path in files do
        let t := testFile(path, stdDir: stdDir, o: o, tmp: dir)
        passed := passed + t.passed
        failed := failed + t.failed
        built := built and t.built
    _ := removeDir(dir)
    if not o.json then
        writeln("{passed} passed, {failed} failed")
    if not built or failed > 0 then
        exit(1)

let o := parseArgs(args())
let stdDir := "{dirName(programPath())}/units"
if o.command = "check" then
    let ds := typecheck(o.file, stdDir: stdDir).resolved.checker.diagnostics
    report(ds, asJson: o.json)
    if hasErrors(ds) then
        exit(1)
else if o.command = "build" then
    var out := o.output
    if out = "" then
        out := stem(o.file)
    if not buildTo(o.file, stdDir: stdDir, out: out, asJson: o.json, checked: not o.unchecked) then
        exit(1)
else if o.command = "test" then
    testCommand(o, stdDir: stdDir)
else if o.command = "lsp" then
    serve(stdDir)
else if o.command = "mcp" then
    let units := absolute(stdDir)
    case changeDir(o.file) of
        Ok(_):
            serveMcp(units)
        Err(e):
            fatal(e.error)
else if o.command = "fmt" then
    fmtCommand(o)
else if o.command = "query" then
    var result: Result[String, String] := Ok("")
    if o.filter = "explain" then
        result := queryExplain(o.file)
    else if o.filter = "symbols" then
        if not (isFile(o.file) or isDir(o.file)) then
            fatal("can't read '{o.file}'")
        result := querySymbols(sourceFiles(o.file), stdDir: stdDir)
    else
        result := queryAt(o.filter, position: o.file, stdDir: stdDir)
    case result of
        Ok(text):
            writeln(text.value)
        Err(e):
            fatal(e.error)
else if o.command = "index" then
    if not (isFile(o.file) or isDir(o.file)) then
        fatal("can't read '{o.file}'")
    case queryIndex(sourceFiles(o.file), stdDir: stdDir) of
        Ok(text):
            writeln(text.value)
        Err(e):
            fatal(e.error)
else if o.command = "tokens" or o.command = "ast" then
    let text := readSource(o.file)
    var failed := false
    if o.command = "tokens" then
        failed := dumpTokens(text, file: o.file)
    else
        failed := dumpAst(text, file: o.file)
    if failed then
        exit(1)
else
    var dir := ""
    case tempDir() of
        Ok(d):
            dir := d.value
        Err(e):
            fatal(e.error)
    let exe := "{dir}/{stem(o.file)}"
    var code := 1
    if buildTo(o.file, stdDir: stdDir, out: exe, asJson: false, checked: not o.unchecked) then
        case run(exe, o.rest) of
            Ok(c):
                code := c.value
            Err(e):
                writelnErr("pst: error: {e.error}")
        _ := removeFile(exe)
    _ := removeDir(dir)
    exit(code)
