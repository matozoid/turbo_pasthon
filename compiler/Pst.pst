program Pst

## The command line tool, as `python3 -m pst` (SPEC §15): `check`, `build`, `run` and
## `test`. The standard units are found in `units` next to the executable.

uses IO, OS, Strings, Source, Ast, Diagnostics, Typecheck, Emit

const
    Usage = "usage: pst check FILE [--json]\n       pst build FILE [-o OUT] [--unchecked] [--json]\n       pst run [--unchecked] FILE [-- ARGS]\n       pst test PATH [--filter TEXT] [--unchecked] [--json]"

type
    Options = record
        command: String
        file: String
        output: String
        json: Boolean
        unchecked: Boolean
        filter: String
        rest: List[String]

procedure usage(message: String)
    writelnErr(Usage)
    writelnErr("pst: error: {message}")
    exit(2)

## The command line, or exits with status 2 after a usage message.
function parseArgs(a: List[String]): Options
    if len(a) = 0 then
        usage("missing command")
    var o := Options(command: a[0], file: "", output: "", json: false, unchecked: false, filter: "", rest: [])
    if o.command <> "check" and o.command <> "build" and o.command <> "run" and o.command <> "test" then
        usage("unknown command '{o.command}'")
    var i := 1
    while i < len(a) do
        let x := a[i]
        i := i + 1
        if o.command = "run" and o.file <> "" then
            add(var o.rest, x)
        else if x = "--json" and o.command <> "run" then
            o.json := true
        else if x = "--unchecked" and o.command <> "check" then
            o.unchecked := true
        else if (x = "-o" or x = "--output") and o.command = "build" then
            if i = len(a) then
                usage("argument -o/--output: expected one argument")
            o.output := a[i]
            i := i + 1
        else if x = "--filter" and o.command = "test" then
            if i = len(a) then
                usage("argument --filter: expected one argument")
            o.filter := a[i]
            i := i + 1
        else if startsWith(x, prefix: "-") or o.file <> "" then
            usage("unrecognized argument '{x}'")
        else
            o.file := x
    if o.file = "" then
        usage("missing FILE or PATH")
    if len(o.rest) > 0 and o.rest[0] = "--" then
        remove(var o.rest, 0)
    return o

## The directory part of `path`: `.` if it has none.
function dirName(path: String): String
    var parts := split(path, sep: "/")
    removeLast(var parts)
    if len(parts) = 0 then
        return "."
    if len(parts) = 1 and parts[0] = "" then
        return "/"
    return join(parts, sep: "/")

## The file name of `path` without its directory and extension.
function stem(path: String): String
    let parts := split(path, sep: "/")
    let name := parts[len(parts) - 1]
    var pieces := split(name, sep: ".")
    if len(pieces) > 1 and pieces[0] <> "" then
        removeLast(var pieces)
        return join(pieces, sep: ".")
    return name

procedure report(ds: List[Diagnostic], asJson: Boolean)
    for d in ds do
        if asJson then
            writeln(json(d))
        else
            writelnErr(human(d))

function hasErrors(ds: List[Diagnostic]): Boolean
    for d in ds do
        if d.severity = Severity.Error then
            return true
    return false

procedure fatal(message: String)
    writelnErr("pst: error: {message}")
    exit(1)

## Drops the type checkers that `typecheck(..., keep: true)` kept: they refer to the
## environment, a cycle.
procedure forget(result: Checked)
    case result.env of
        Some(env):
            env.value.checkers := {}
            env.value.constCheckers := {}
        None:
            return

## Checks and compiles `path` into the executable `out`, and prints the diagnostics.
## Whether it succeeded.
function buildTo(path: String, stdDir: String, out: String, asJson: Boolean, checked: Boolean): Boolean
    let result := typecheck(path, stdDir: stdDir, keep: true)
    let ds := result.resolved.checker.diagnostics
    if hasErrors(ds) then
        forget(result)
        report(ds, asJson: asJson)
        return false
    let built := build(result, checked: checked)
    forget(result)
    report(ds, asJson: asJson)
    report(built.diagnostics, asJson: asJson)
    case built.executable of
        Some(exe):
            writeExe(out, exe.value)
            return true
        None:
            return false

## Writes the executable `exe` to `out`, with mode 0o755.
procedure writeExe(out: String, exe: List[Byte])
    case create(out, mode: 0o755) of
        Ok(f):
            case writeBytes(f.value, exe) of
                Ok(_):
                    _ := close(f.value)
                Err(e):
                    fatal(e.error)
        Err(e):
            fatal(e.error)

## The strings in order.
function sorted(xs: List[String]): List[String]
    var out: List[String] := []
    for x in xs do
        add(var out, x)
        var j := len(out) - 1
        while j > 0 and x < out[j - 1] do
            out[j] := out[j - 1]
            j := j - 1
        out[j] := x
    return out

## `dir/name` without `.` and empty parts, like Python's `os.path.normpath`.
function joinPath(dir: String, name: String): String
    var parts: List[String] := []
    let all := split("{dir}/{name}", sep: "/")
    for i := 0 to len(all) - 1 do
        if (all[i] <> "" or i = 0) and all[i] <> "." then
            add(var parts, all[i])
    if len(parts) = 1 and parts[0] = "" then
        return "/"
    return join(parts, sep: "/")

## The lines of `text`, without their newlines.
function lines(text: String): List[String]
    var ls := split(text, sep: "\n")
    if ls[len(ls) - 1] = "" then
        removeLast(var ls)
    return ls

## Does nothing: an `else` arm that ignores the other cases.
procedure pass()
    return

## The test blocks of a file.
function testsOf(file: SourceFile): List[TestBlock]
    var tests: List[TestBlock] := []
    for item in file.items do
        case item of
            Decl(d):
                case d of
                    TestBlock(t):
                        add(var tests, t)
                    else:
                        pass()
            else:
                pass()
    return tests

type
    Tally = record
        passed: Integer
        failed: Integer
        built: Boolean

## Builds and runs the tests of one file (SPEC §13) in directory `tmp`.
function testFile(path: String, stdDir: String, o: Options, tmp: String): Tally
    var tally := Tally(passed: 0, failed: 0, built: false)
    let result := typecheck(path, stdDir: stdDir, keep: true)
    let ds := result.resolved.checker.diagnostics
    if hasErrors(ds) then
        forget(result)
        report(ds, asJson: o.json)
        return tally
    let built := build(result, checked: not o.unchecked, tests: true)
    forget(result)
    report(ds, asJson: o.json)
    report(built.diagnostics, asJson: o.json)
    if built.executable.isNone() then
        return tally
    tally.built := true
    let exe := "{tmp}/tests"
    let output := "{tmp}/output"
    writeExe(exe, built.executable.get())
    let tests := testsOf(result.resolved.main.get().parsed.file)
    for i := 0 to len(tests) - 1 do
        let t := tests[i]
        if find(t.name, sub: o.filter).isNone() then
            continue
        var code := 1
        case run(exe, ["{i}"], output: output) of
            Ok(c):
                code := c.value
            Err(e):
                fatal(e.error)
        var text := ""
        case open(output) of
            Ok(f):
                text := readAll(f.value).getOr("")
            Err(e):
                fatal(e.error)
        let ok := code = 0
        if ok then
            tally.passed := tally.passed + 1
        else
            tally.failed := tally.failed + 1
        if o.json then
            writeln("\{\"file\": {jsonString(path)}, {jsonSpan(t.span)}, \"test\": {jsonString(t.name)}, \"passed\": {ok}, \"output\": {jsonString(text)}}")
        else if ok then
            writeln("ok   {path}:{t.span.line}: {t.name}")
        else
            writeln("FAIL {path}:{t.span.line}: {t.name}")
            for l in lines(text) do
                writeln("    {l}")
            if code <> 70 then
                writeln("    exit status {code}")
    _ := removeFile(output)
    _ := removeFile(exe)
    return tally

procedure testCommand(o: Options, stdDir: String)
    var files := [o.file]
    if isDir(o.file) then
        files := []
        case listDir(o.file) of
            Ok(names):
                for name in sorted(names.value) do
                    if endsWith(name, suffix: ".pst") then
                        add(var files, joinPath(o.file, name: name))
            Err(e):
                fatal(e.error)
    var dir := ""
    case tempDir() of
        Ok(d):
            dir := d.value
        Err(e):
            fatal(e.error)
    var passed := 0
    var failed := 0
    var built := true
    for path in files do
        let t := testFile(path, stdDir: stdDir, o: o, tmp: dir)
        passed := passed + t.passed
        failed := failed + t.failed
        built := built and t.built
    _ := removeDir(dir)
    if not o.json then
        writeln("{passed} passed, {failed} failed")
    if not built or failed > 0 then
        exit(1)

let o := parseArgs(args())
let stdDir := "{dirName(programPath())}/units"
if o.command = "check" then
    let ds := typecheck(o.file, stdDir: stdDir).resolved.checker.diagnostics
    report(ds, asJson: o.json)
    if hasErrors(ds) then
        exit(1)
else if o.command = "build" then
    var out := o.output
    if out = "" then
        out := stem(o.file)
    if not buildTo(o.file, stdDir: stdDir, out: out, asJson: o.json, checked: not o.unchecked) then
        exit(1)
else if o.command = "test" then
    testCommand(o, stdDir: stdDir)
else
    var dir := ""
    case tempDir() of
        Ok(d):
            dir := d.value
        Err(e):
            fatal(e.error)
    let exe := "{dir}/{stem(o.file)}"
    var code := 1
    if buildTo(o.file, stdDir: stdDir, out: exe, asJson: false, checked: not o.unchecked) then
        case run(exe, o.rest) of
            Ok(c):
                code := c.value
            Err(e):
                writelnErr("pst: error: {e.error}")
        _ := removeFile(exe)
    _ := removeDir(dir)
    exit(code)
