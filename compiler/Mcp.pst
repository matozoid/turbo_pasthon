unit Mcp

## The MCP server for AI agents (SPEC §15.7): JSON-RPC over standard input and output, one
## message per line. Each tool answers like the `pst` command or query it wraps, reading
## the files from disk on every call, so edits made by other tools are always seen.

uses IO, OS, Strings, Source, Diagnostics, Symbols, Typecheck, Fmt, Json, PosixPaths, Lsp, Query

const
    ProtocolVersion = "2025-06-18"
    ## The most items of each list a tool's result holds; the rest is paged with `cursor`.
    PageSize = 200

# ------------------------------------------------------------------------- messages

procedure send(body: String)
    writeln(body)

procedure respond(id: JValue, result: String)
    send("\{\"jsonrpc\":\"2.0\",\"id\":{toText(id)},\"result\":{result}}")

procedure respondError(id: JValue, code: Integer, message: String)
    send(
        "\{\"jsonrpc\":\"2.0\",\"id\":{toText(id)},\"error\":\{\"code\":{code},\"message\":{quote(message)}}}",
    )

# ------------------------------------------------------------------------- tools

## A tool's description for `tools/list`: its input's properties, as JSON members, and the
## names of those that are required.
function tool(name, description: String, properties: List[String], required: List[String]): String
    var names: List[String] := []
    for r in required do
        add(var names, quote(r))
    var props := properties
    if pages(name) then
        add(var props, property(
            "cursor",
            kind: "string",
            description: "The `nextCursor` of the previous page, to get the next one.",
        ))
    let schema := "\{\"type\":\"object\",\"properties\":\{{join(props, sep: ",")}},\"required\":[{join(names, sep: ",")}]}"
    return "\{\"name\":{quote(name)},\"description\":{quote(description)},\"inputSchema\":{schema}}"

## Whether a tool's result is paged: all but those that write files, which must not be
## called again for the rest.
function pages(name: String): Boolean
    return not (name in ["pst_fmt", "pst_apply_fix", "pst_rename"])

## The page of a tool's JSON result that `cursor` asks for: each list of the object cut to
## `PageSize` items from the cursor's offset, with `"nextCursor"` if any list goes on.
function paged(text, cursor: String): Result[String, String]
    var start := 0
    if cursor <> "" then
        case parseInt(cursor) of
            Ok(n):
                start := n.value
            Err(_):
                start := -1
        if start < 0 then
            return Err("bad cursor '{cursor}'")
    var members: List[Member] := []
    var more := false
    case parse(text) of
        Ok(j):
            case j.value of
                JObject(o):
                    members := o.members
                else:
                    return Ok(text)
        Err(_):
            return Ok(text)
    if start = 0 then
        var long := false
        for m in members do
            case m.value of
                JArray(a):
                    long := long or len(a.items) > PageSize
                else:
                    pass
        if not long then
            return Ok(text)
    var out: List[Member] := []
    for m in members do
        case m.value of
            JArray(a):
                var page: List[JValue] := []
                var i := start
                while i < len(a.items) and i < start + PageSize do
                    add(var page, a.items[i])
                    i := i + 1
                more := more or len(a.items) > start + PageSize
                add(var out, Member(key: m.key, value: JArray(items: page)))
            else:
                add(var out, m)
    if more then
        add(var out, Member(key: "nextCursor", value: JString(value: "{start + PageSize}")))
    return Ok(toText(JObject(members: out)))

function property(name, kind, description: String): String
    return "{quote(name)}:\{\"type\":{quote(kind)},\"description\":{quote(description)}}"

function pathsProperty(description: String): String
    return "\"paths\":\{\"type\":\"array\",\"items\":\{\"type\":\"string\"},\"description\":{quote(description)}}"

## The properties of a tool that takes a position or a symbol's name.
function positionProperties(): List[String]
    return [
        property("file", kind: "string", description: "A .pst file, relative to the project root."),
        property("line", kind: "integer", description: "The line, from 1."),
        property("col", kind: "integer", description: "The column in code points, from 1."),
        property(
            "symbol",
            kind: "string",
            description: "Instead of a position: a name, Unit.name or Type.name.",
        ),
    ]

function tools(): String
    let at := positionProperties()
    let named := [property(
        "symbol",
        kind: "string",
        description: "A name, Unit.name or Type.name.",
    )]
    let list := [
        tool(
            "pst_check",
            description: "Type-checks .pst files and returns their diagnostics, with fixes.",
            properties: [pathsProperty("Files or directories; by default the project root.")],
            required: [],
        ),
        tool(
            "pst_symbols",
            description: "The types, constants, routines, fields and enum members declared in a file or directory, with signatures and doc comments.",
            properties: [
                property(
                    "file",
                    kind: "string",
                    description: "A file or directory; by default the project root.",
                ),
                property(
                    "query",
                    kind: "string",
                    description: "Only names containing these letters, in order.",
                ),
            ],
            required: [],
        ),
        tool(
            "pst_index",
            description: "The complete symbol index: every symbol declared or used, and every name with the symbol it means.",
            properties: [pathsProperty("Files or directories; by default the project root.")],
            required: [],
        ),
        tool(
            "pst_def",
            description: "Where the symbol at a position, or with a name, is defined.",
            properties: at,
            required: [],
        ),
        tool(
            "pst_refs",
            description: "The definition and every use of a symbol, method calls included.",
            properties: at,
            required: [],
        ),
        tool(
            "pst_type",
            description: "The type of the value at a position, and where its types are declared.",
            properties: at,
            required: [],
        ),
        tool(
            "pst_hover",
            description: "A symbol's kind, type, declaration, doc comment and location.",
            properties: at,
            required: [],
        ),
        tool(
            "pst_impls",
            description: "The types that satisfy a trait, or the routines that provide a trait routine.",
            properties: [property(
                "trait",
                kind: "string",
                description: "A trait or trait routine: a name, Unit.name or Type.name.",
            )],
            required: ["trait"],
        ),
        tool(
            "pst_accepts",
            description: "The routines whose first parameter takes a type, i.e. what `x.` can call on its values, as seen where the type (or value) is declared.",
            properties: [at[0], at[1], at[2], property(
                "type",
                kind: "string",
                description: "Instead of a position: a type or value's name, Unit.name or Type.name.",
            )],
            required: [],
        ),
        tool(
            "pst_callers",
            description: "The routines (or unit levels) that call a routine, with the calls' locations.",
            properties: named,
            required: ["symbol"],
        ),
        tool(
            "pst_callees",
            description: "The routines declared in source that a routine calls, with the calls' locations.",
            properties: named,
            required: ["symbol"],
        ),
        tool(
            "pst_instances",
            description: "The instances of a generic routine or type: its type arguments, and where each is created.",
            properties: named,
            required: ["symbol"],
        ),
        tool(
            "pst_explain",
            description: "What an error or panic code means, such as E0502, and the SPEC section that lists it.",
            properties: [property("code", kind: "string", description: "The code, such as E0502.")],
            required: ["code"],
        ),
        tool(
            "pst_run",
            description: "Builds and runs a program, and returns its exit code, output and panic, or the diagnostics if it doesn't build. Executes the program.",
            properties: [
                property("file", kind: "string", description: "The program's .pst file."),
                "\"args\":\{\"type\":\"array\",\"items\":\{\"type\":\"string\"},\"description\":\"Its command line arguments.\"}",
                property(
                    "stdin",
                    kind: "string",
                    description: "Its standard input; by default empty.",
                ),
                property(
                    "timeoutMs",
                    kind: "integer",
                    description: "When to end it, in milliseconds, rounded up to seconds; by default 10000.",
                ),
            ],
            required: ["file"],
        ),
        tool(
            "pst_test",
            description: "Runs the test blocks of .pst files, and returns each test's result with its output, and any diagnostics.",
            properties: [
                pathsProperty("Files or directories; by default the project root."),
                property(
                    "filter",
                    kind: "string",
                    description: "Only tests whose names contain this text.",
                ),
                property(
                    "timeoutMs",
                    kind: "integer",
                    description: "When to end each test, in milliseconds, rounded up to seconds; by default 10000.",
                ),
            ],
            required: [],
        ),
        tool(
            "pst_fmt",
            description: "Formats .pst files in place, or with check only lists the files that would change. Writes files.",
            properties: [
                pathsProperty("Files or directories; by default the project root."),
                property(
                    "check",
                    kind: "boolean",
                    description: "Only list the files; write nothing.",
                ),
            ],
            required: [],
        ),
        tool(
            "pst_apply_fix",
            description: "Applies the fix of the diagnostic with the code at a position, and returns the edits made and the file's new diagnostics. Writes the file.",
            properties: [
                property(
                    "file",
                    kind: "string",
                    description: "A .pst file, relative to the project root.",
                ),
                property(
                    "line",
                    kind: "integer",
                    description: "A line in the diagnostic's range, from 1.",
                ),
                property(
                    "col",
                    kind: "integer",
                    description: "A column in the diagnostic's range, from 1.",
                ),
                property(
                    "code",
                    kind: "string",
                    description: "The diagnostic's code, such as E0502.",
                ),
                property(
                    "fix",
                    kind: "integer",
                    description: "Which of its fixes, from 0; by default the first.",
                ),
            ],
            required: ["file", "line", "col", "code"],
        ),
        tool(
            "pst_rename",
            description: "Renames a symbol and every use of it in the project, refused if it is in a standard unit or would cause errors. Writes files unless dryRun.",
            properties: [
                property("symbol", kind: "string", description: "A name, Unit.name or Type.name."),
                property("file", kind: "string", description: "Instead of symbol: a .pst file."),
                property("line", kind: "integer", description: "With file: the line, from 1."),
                property("col", kind: "integer", description: "With file: the column, from 1."),
                property("newName", kind: "string", description: "The new name."),
                property(
                    "dryRun",
                    kind: "boolean",
                    description: "Only return the edits; write nothing.",
                ),
            ],
            required: ["newName"],
        ),
    ]
    return "\{\"tools\":[{join(list, sep: ",")}]}"

## The paths given as `paths`, or the project root.
function pathsOf(arguments: JValue): List[String]
    var paths: List[String] := []
    for p in items(field(arguments, key: "paths")) do
        case asString(p) of
            Some(text):
                add(var paths, text.value)
            None:
                pass
    if len(paths) = 0 then
        add(var paths, ".")
    return paths

## The `.pst` files of `paths`.
function filesOf(paths: List[String]): Result[List[String], String]
    var files: List[String] := []
    for path in paths do
        if not (isFile(path) or isDir(path)) then
            return Err("can't read '{path}'")
        case pstFiles(path) of
            Ok(found):
                for f in found.value do
                    add(var files, f)
            Err(e):
                return Err(e.error)
    return Ok(files)

## The position the arguments name, as `pst query` takes it: `symbol`, or `file:line:col`.
function positionOf(arguments: JValue, key: String): Result[String, String]
    case asString(field(arguments, key: key)) of
        Some(name):
            return Ok(name.value)
        None:
            pass
    let file := asString(field(arguments, key: "file"))
    let line := asInteger(field(arguments, key: "line"))
    let col := asInteger(field(arguments, key: "col"))
    if file.isNone() or line.isNone() or col.isNone() then
        return Err("expected 'file', 'line' and 'col', or '{key}'")
    return Ok("{file.get()}:{line.get()}:{col.get()}")

## The diagnostics of `files`, each reported once.
function check(files: List[String], stdDir: String): String
    var items: List[String] := []
    var seen: Map[String, Boolean] := {}
    var errors := 0
    for file in files do
        for d in typecheck(file, stdDir: stdDir).resolved.checker.diagnostics do
            let text := json(d)
            if not (text in seen) then
                seen[text] := true
                add(var items, text)
                if d.severity = Severity.Error then
                    errors := errors + 1
    return "\{\"errors\":{errors},\"diagnostics\":[{join(items, sep: ",")}]}"

## Whether `path` is inside the project root, the only place tools may write.
function inside(path: String): Boolean
    return startsWith(absolute(path), prefix: "{currentDir()}/")

## Replaces the file at `path` with `text`, if it is inside the project root.
function save(path, text: String): Result[Integer, String]
    if not inside(path) then
        return Err("'{shown(absolute(path))}' is outside the project root")
    return writeText(path, text: text)

## Replaces the file at `path` with `text`.
function writeText(path, text: String): Result[Integer, String]
    case create(path) of
        Ok(out):
            let written := writeAll(out.value, text: text)
            _ := close(out.value)
            case written of
                Ok(_):
                    return Ok(0)
                Err(e):
                    return Err(e.error)
        Err(e):
            return Err(e.error)

## Formats `files`, and writes those that change unless `check`.
function fmt(files: List[String], check: Boolean): Result[String, String]
    var changed: List[String] := []
    var problems: List[String] := []
    for file in files do
        case readFile(file) of
            Ok(text):
                case format(text.value, file: file) of
                    Ok(f):
                        if f.value <> text.value then
                            add(var changed, quote(file))
                            if not check then
                                case save(file, text: f.value) of
                                    Ok(_):
                                        pass
                                    Err(e):
                                        return Err(e.error)
                    Err(ds):
                        for d in ds.error do
                            add(var problems, json(d))
            Err(e):
                return Err(e.error)
    let listed := "\"changed\":[{join(changed, sep: ",")}]"
    return Ok("\{{listed},\"written\":{not check},\"diagnostics\":[{join(problems, sep: ",")}]}")

## Whether line `line`, column `col` is in `s`, its ends included.
function holds(s: Span, line, col: Integer): Boolean
    if line < s.line or line > s.endLine then
        return false
    if line = s.line and col < s.col then
        return false
    return not (line = s.endLine and col > s.endCol)

## Applies fix `which` of the diagnostic with `code` at the position in `file`.
function applyFix(arguments: JValue, stdDir: String): Result[String, String]
    let file := asString(field(arguments, key: "file"))
    let line := asInteger(field(arguments, key: "line"))
    let col := asInteger(field(arguments, key: "col"))
    let code := asString(field(arguments, key: "code"))
    if file.isNone() or line.isNone() or col.isNone() or code.isNone() then
        return Err("expected 'file', 'line', 'col' and 'code'")
    let path := file.get()
    let which := asInteger(field(arguments, key: "fix")).getOr(0)
    var source := ""
    case readFile(path) of
        Ok(text):
            source := text.value
        Err(e):
            return Err(e.error)
    for d in typecheck(path, stdDir: stdDir).resolved.checker.diagnostics do
        if absolute(d.file) <> absolute(path) or d.code <> code.get() then
            continue
        if not holds(d.span, line.get(), col: col.get()) then
            continue
        if which < 0 or which >= len(d.fixes) then
            return Err("{code.get()} at {path}:{line.get()}:{col.get()} has no fix {which}")
        ## The edits, applied from the last so that the earlier offsets still hold.
        var edits := d.fixes[which].edits
        sort(var edits, less: later)
        let t := textOf(source)
        var out := t.str
        var shown: List[String] := []
        for e in edits do
            out := "{slice(out, 0, t.offsets[e.span.start])}{e.text}{slice(out, t.offsets[e.span.end], byteLen(out))}"
            insert(var shown, 0, x: "\{{jsonSpan(e.span)}, \"text\": {jsonString(e.text)}}")
        case save(path, text: out) of
            Ok(_):
                pass
            Err(e):
                return Err(e.error)
        let result := check([path], stdDir: stdDir)
        let after := slice(result, 1, byteLen(result))
        return Ok("\{\"file\":{quote(path)},\"edits\":[{join(shown, sep: ",")}],{after}")
    return Err("no {code.get()} diagnostic at {path}:{line.get()}:{col.get()}")

## Whether edit `a` starts after `b`.
function later(a, b: Edit): Boolean
    return a.span.start > b.span.start

## Renames the symbol the arguments name to `newName`, and writes the files unless
## `dryRun`.
function renameSymbol(arguments: JValue, stdDir: String): Result[String, String]
    let newName := asString(field(arguments, key: "newName")).getOr("")
    let dryRun := asBoolean(field(arguments, key: "dryRun")).getOr(false)
    var file := ""
    var line := 0
    var col := 0
    case positionOf(arguments, key: "symbol") of
        Ok(position):
            case locate(position.value, stdDir: stdDir) of
                Ok(p):
                    file := p.value.first
                    line := p.value.second[0]
                    col := p.value.second[1]
                Err(e):
                    return Err(e.error)
        Err(e):
            return Err(e.error)
    var files: List[String] := []
    case neighbours(file) of
        Ok(f):
            files := f.value
        Err(e):
            return Err(e.error)
    case serverFor(stdDir, files) of
        Ok(s):
            let a := analyze(s.value, file)
            let found := refAtLine(a, file, line, col: col)
            case renamingOf(s.value, occurrencesOf(s.value, a, found: found), newName: newName) of
                Ok(r):
                    var edits: List[String] := []
                    var changed: List[String] := []
                    for path, refs in r.value.byFile do
                        if not inside(path) then
                            return Err("'{shown(path)}' is outside the project root")
                        add(var changed, quote(shown(path)))
                        for u in refs do
                            add(var edits, location(u.file, span: u.span))
                    if not dryRun then
                        for path, text in r.value.texts do
                            case save(path, text: text) of
                                Ok(_):
                                    pass
                                Err(e):
                                    return Err(e.error)
                    let listed := "\"files\":[{join(changed, sep: ",")}],\"edits\":[{join(edits, sep: ",")}]"
                    return Ok("\{{listed},\"written\":{not dryRun}}")
                Err(e):
                    return Err(e.error)
        Err(e):
            return Err(e.error)

## The strings in the array `j`.
function strings(j: JValue): List[String]
    var out: List[String] := []
    for x in items(j) do
        case asString(x) of
            Some(text):
                add(var out, text.value)
            None:
                pass
    return out

## The text of the file at `path`, or "" if it can't be read.
function contents(path: String): String
    return readFile(path).getOr("")

## The JSON lines of a `pst` command's output, and its other lines.
function jsonLines(text: String): Pair[List[String], List[String]]
    var json: List[String] := []
    var other: List[String] := []
    for line in split(text, sep: "\n") do
        if startsWith(line, prefix: "\{") then
            add(var json, line)
        else if line <> "" then
            add(var other, line)
    return Pair(first: json, second: other)

## The panic that `stderr` reports, as JSON members, or "": `panic P0001: message` then
## `    at File.pst:3:5`.
function panicOf(stderr: String): String
    let lines := split(stderr, sep: "\n")
    for i := 0 to len(lines) - 1 do
        if not startsWith(lines[i], prefix: "panic P") then
            continue
        let rest := slice(lines[i], byteLen("panic "), byteLen(lines[i]))
        let colon := find(rest, sub: ": ").getOr(byteLen(rest))
        var members := "\"code\":{quote(slice(rest, 0, colon))}"
        if colon < byteLen(rest) then
            members := "{members},\"message\":{quote(slice(rest, colon + 2, byteLen(rest)))}"
        if i + 1 < len(lines) and startsWith(trim(lines[i + 1]), prefix: "at ") then
            let at := slice(trim(lines[i + 1]), 3, byteLen(trim(lines[i + 1])))
            let parts := split(at, sep: ":")
            let n := len(parts)
            if n >= 3 then
                var file := parts[0]
                for k := 1 to n - 3 do
                    file := "{file}:{parts[k]}"
                members := "{members},\"file\":{quote(file)},\"line\":{parts[n - 2]},\"col\":{parts[n - 1]}"
        return members
    return ""

## Builds `file` and runs it with `args` and `stdin`, ended after `timeoutMs`.
function runProgram(arguments: JValue): Result[String, String]
    let file := asString(field(arguments, key: "file"))
    if file.isNone() then
        return Err("expected 'file'")
    let timeoutMs := asInteger(field(arguments, key: "timeoutMs")).getOr(10000)
    var tmp := ""
    case tempDir() of
        Ok(d):
            tmp := d.value
        Err(e):
            return Err(e.error)
    let exe := "{tmp}/program"
    let log := "{tmp}/build"
    var result: Result[String, String] := Err("")
    case run(
        programPath(),
        ["build", file.get(), "-o", exe, "--json"],
        output: log,
        input: "/dev/null",
    ) of
        Ok(code):
            let built := jsonLines(contents(log))
            let diagnostics := "\"diagnostics\":[{join(built.first, sep: ",")}]"
            if len(built.second) > 0 then
                result := Err(join(built.second, sep: "\n"))
            else if code.value <> 0 then
                result := Ok("\{\"built\":false,{diagnostics}}")
            else
                result := runBuilt(
                    exe,
                    arguments: arguments,
                    tmp: tmp,
                    timeoutMs: timeoutMs,
                    built: diagnostics,
                )
        Err(e):
            result := Err(e.error)
    for name in ["program", "build", "stdin", "stdout", "stderr"] do
        _ := removeFile("{tmp}/{name}")
    _ := removeDir(tmp)
    return result

## Runs the built program `exe`: its exit code or signal, output and panic.
function runBuilt(
    exe: String,
    arguments: JValue,
    tmp: String,
    timeoutMs: Integer,
    built: String,
): Result[String, String]
    var input := "/dev/null"
    case asString(field(arguments, key: "stdin")) of
        Some(text):
            input := "{tmp}/stdin"
            case writeText(input, text: text.value) of
                Ok(_):
                    pass
                Err(e):
                    return Err(e.error)
        None:
            pass
    let out := "{tmp}/stdout"
    let err := "{tmp}/stderr"
    let seconds := (timeoutMs + 999) div 1000
    case runFor(
        exe,
        strings(field(arguments, key: "args")),
        timeout: seconds,
        output: out,
        errors: err,
        input: input,
    ) of
        Ok(code):
            var status := "\"exitCode\":{code.value}"
            if code.value = -14 then
                status := "\"timedOut\":true"
            else if code.value < 0 then
                status := "\"signal\":{-code.value}"
            let stderr := contents(err)
            var members := "\"built\":true,{built},{status},\"stdout\":{quote(contents(out))},\"stderr\":{quote(stderr)}"
            let panic := panicOf(stderr)
            if panic <> "" then
                members := "{members},\"panic\":\{{panic}}"
            return Ok("\{{members}}")
        Err(e):
            return Err(e.error)

## Runs the tests of `paths` whose names contain `filter`.
function runTests(arguments: JValue): Result[String, String]
    var tmp := ""
    case tempDir() of
        Ok(d):
            tmp := d.value
        Err(e):
            return Err(e.error)
    let log := "{tmp}/test"
    var tests: List[String] := []
    var diagnostics: List[String] := []
    var passed := 0
    var failed := 0
    var problem := ""
    case filesOf(pathsOf(arguments)) of
        Ok(files):
            for file in files.value do
                let timeoutMs := asInteger(field(arguments, key: "timeoutMs")).getOr(10000)
                let seconds := if timeoutMs > 0 then (timeoutMs + 999) div 1000 else 1
                var args := ["test", file, "--json", "--timeout", "{seconds}"]
                case asString(field(arguments, key: "filter")) of
                    Some(f):
                        args := concat(args, ["--filter", f.value])
                    None:
                        pass
                case run(programPath(), args, output: log, input: "/dev/null") of
                    Ok(_):
                        let lines := jsonLines(contents(log))
                        for line in lines.first do
                            let j := parse(line).getOr(JNull())
                            if isNull(field(j, key: "test")) then
                                add(var diagnostics, line)
                            else
                                add(var tests, line)
                                if asBoolean(field(j, key: "passed")).getOr(false) then
                                    passed := passed + 1
                                else
                                    failed := failed + 1
                        if len(lines.second) > 0 and problem = "" then
                            problem := join(lines.second, sep: "\n")
                    Err(e):
                        problem := e.error
        Err(e):
            problem := e.error
    _ := removeFile(log)
    _ := removeDir(tmp)
    if problem <> "" then
        return Err(problem)
    let counts := "\"passed\":{passed},\"failed\":{failed}"
    return Ok("\{{counts},\"tests\":[{join(tests, sep: ",")}],\"diagnostics\":[{join(diagnostics, sep: ",")}]}")

## The answer of tool `name`, or an error for the agent.
function call(name: String, arguments: JValue, stdDir: String): Result[String, String]
    if name = "pst_check" or name = "pst_index" then
        case filesOf(pathsOf(arguments)) of
            Ok(files):
                if name = "pst_check" then
                    return Ok(check(files.value, stdDir: stdDir))
                return queryIndex(files.value, stdDir: stdDir)
            Err(e):
                return Err(e.error)
    if name = "pst_symbols" then
        let file := asString(field(arguments, key: "file")).getOr(".")
        case filesOf([file]) of
            Ok(files):
                return querySymbols(
                    files.value,
                    stdDir: stdDir,
                    query: asString(field(arguments, key: "query")).getOr(""),
                )
            Err(e):
                return Err(e.error)
    if name = "pst_fmt" then
        case filesOf(pathsOf(arguments)) of
            Ok(files):
                return fmt(
                    files.value,
                    check: asBoolean(field(arguments, key: "check")).getOr(false),
                )
            Err(e):
                return Err(e.error)
    if name = "pst_explain" then
        return queryExplain(asString(field(arguments, key: "code")).getOr(""))
    if name = "pst_run" then
        return runProgram(arguments)
    if name = "pst_test" then
        return runTests(arguments)
    if name = "pst_apply_fix" then
        return applyFix(arguments, stdDir: stdDir)
    if name = "pst_rename" then
        return renameSymbol(arguments, stdDir: stdDir)
    var request := ""
    var key := "symbol"
    if name in [
        "pst_def",
        "pst_refs",
        "pst_type",
        "pst_hover",
        "pst_callers",
        "pst_callees",
        "pst_instances",
    ] then
        request := slice(name, 4, byteLen(name))
    else if name = "pst_impls" then
        request := "impls"
        key := "trait"
    else if name = "pst_accepts" then
        request := "accepts"
        key := "type"
    else
        return Err("unknown tool '{name}'")
    case positionOf(arguments, key: key) of
        Ok(position):
            return queryAt(request, position: position.value, stdDir: stdDir)
        Err(e):
            return Err(e.error)

## The result of `tools/call`: the tool's JSON answer as text, or its error.
function callResult(params: JValue, stdDir: String): String
    let name := asString(field(params, key: "name")).getOr("")
    let arguments := field(params, key: "arguments")
    var result := call(name, arguments: arguments, stdDir: stdDir)
    if pages(name) then
        case result of
            Ok(text):
                result := paged(
                    text.value,
                    cursor: asString(field(arguments, key: "cursor")).getOr(""),
                )
            Err(_):
                pass
    case result of
        Ok(text):
            return "\{\"content\":[\{\"type\":\"text\",\"text\":{quote(text.value)}}]}"
        Err(e):
            return "\{\"content\":[\{\"type\":\"text\",\"text\":{quote(e.error)}}],\"isError\":true}"

# ------------------------------------------------------------------------- the server

procedure handle(m: JValue, stdDir: String)
    let method := asString(field(m, key: "method")).getOr("")
    let id := field(m, key: "id")
    let params := field(m, key: "params")
    if isNull(id) then
        ## A notification, such as `notifications/initialized`: nothing to answer.
        return
    if method = "initialize" then
        ## The client's protocol version if it is one this server speaks, else the latest.
        var version := asString(field(params, key: "protocolVersion")).getOr("")
        if not (version in ["2024-11-05", "2025-03-26", ProtocolVersion]) then
            version := ProtocolVersion
        let info := "\"serverInfo\":\{\"name\":\"pst\",\"version\":\"0.2\"}"
        let instructions := "Tools for Turbo Pasthon (.pst) code. Positions are 1-based lines and columns in code points; paths are relative to the project root."
        respond(
            id,
            result: "\{\"protocolVersion\":{quote(version)},\"capabilities\":\{\"tools\":\{}},{info},\"instructions\":{quote(instructions)}}",
        )
    else if method = "ping" then
        respond(id, result: "\{}")
    else if method = "tools/list" then
        respond(id, result: tools())
    else if method = "tools/call" then
        respond(id, result: callResult(params, stdDir: stdDir))
    else
        respondError(id, code: -32601, message: "unknown method '{method}'")

## Answers messages until the input ends.
export procedure serveMcp(stdDir: String)
    while true do
        case readln() of
            Some(line):
                if trim(line.value) = "" then
                    continue
                case parse(line.value) of
                    Ok(m):
                        handle(m.value, stdDir: stdDir)
                    Err(e):
                        respondError(JNull(), code: -32700, message: e.error)
            None:
                return
