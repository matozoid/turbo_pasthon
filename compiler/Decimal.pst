unit Decimal

## The bits of the IEEE-754 double nearest a real literal (SPEC §2.4), rounding half to
## even. The conversion is exact, on natural numbers of any size, since the compiler
## itself can't use `Real`.
##
## A natural number is a `List[Integer]` of base 2^32 limbs, least significant first,
## with no zero limb on top; zero is the empty list.

uses Bits, Strings

type
    ## A quotient and its remainder.
    Division = record
        q: Integer
        r: List[Integer]

const
    Limb = 0xFFFFFFFF
    Infinity = 0x7FF0000000000000

procedure trim(var x: List[Integer])
    while len(x) > 0 and x[len(x) - 1] = 0 do
        removeLast(var x)

## `x * m + c`, for `m` and `c` below 2^31.
function mulAdd(x: List[Integer], m, c: Integer): List[Integer]
    var out: List[Integer] := []
    var carry := c
    for limb in x do
        let v := limb * m + carry
        add(var out, band(v, Limb))
        carry := shr(v, 32)
    if carry > 0 then
        add(var out, carry)
    return out

## `x * 2^n`.
function shifted(x: List[Integer], n: Integer): List[Integer]
    if len(x) = 0 then
        return x
    var out: List[Integer] := []
    for k := 1 to n div 32 do
        add(var out, 0)
    var carry := 0
    for limb in x do
        let v := shl(limb, n mod 32) + carry
        add(var out, band(v, Limb))
        carry := shr(v, 32)
    if carry > 0 then
        add(var out, carry)
    return out

## The number of bits of `x`.
function bitLen(x: List[Integer]): Integer
    if len(x) = 0 then
        return 0
    var n := 32 * (len(x) - 1)
    var top := x[len(x) - 1]
    while top > 0 do
        n := n + 1
        top := shr(top, 1)
    return n

## -1, 0 or 1 as `x` is below, equal to or above `y`.
function compare(x, y: List[Integer]): Integer
    if len(x) <> len(y) then
        if len(x) < len(y) then
            return -1
        return 1
    for i := len(x) - 1 downto 0 do
        if x[i] <> y[i] then
            if x[i] < y[i] then
                return -1
            return 1
    return 0

## `x - y`, for `y` at most `x`.
function minus(x, y: List[Integer]): List[Integer]
    var out: List[Integer] := []
    var borrow := 0
    for i := 0 to len(x) - 1 do
        var v := x[i] - borrow
        if i < len(y) then
            v := v - y[i]
        borrow := 0
        if v < 0 then
            v := v + Limb + 1
            borrow := 1
        add(var out, v)
    trim(var out)
    return out

## `n / d` and its remainder, for a quotient below 2^55.
function divide(n, d: List[Integer]): Division
    var q := 0
    var r := n
    for bit := 54 downto 0 do
        let t := shifted(d, bit)
        if compare(t, r) <= 0 then
            r := minus(r, t)
            q := q + shl(1, bit)
    return Division(q: q, r: r)

## `n / d`, scaled by 2^-e.
function scaled(n, d: List[Integer], e: Integer): Division
    if e >= 0 then
        return divide(n, shifted(d, e))
    return divide(shifted(n, -e), d)

## The bits of the double nearest the literal `digits` (`12.5`, `1.0e-9`; no sign).
export function realBits(digits: String): Integer
    let bs := bytes(digits)
    var m: List[Integer] := []
    var exp := 0
    var dot := false
    var i := 0
    while i < len(bs) and bs[i] <> Byte(ord('e')) and bs[i] <> Byte(ord('E')) do
        if bs[i] = Byte(ord('.')) then
            dot := true
        else
            m := mulAdd(m, 10, c: Integer(bs[i]) - ord('0'))
            trim(var m)
            if dot then
                exp := exp - 1
        i := i + 1
    if i < len(bs) then
        i := i + 1
        var sign := 1
        if bs[i] = Byte(ord('-')) then
            sign := -1
            i := i + 1
        else if bs[i] = Byte(ord('+')) then
            i := i + 1
        var e := 0
        while i < len(bs) do
            if e < 100000 then
                e := e * 10 + Integer(bs[i]) - ord('0')
            i := i + 1
        exp := exp + sign * e
    if len(m) = 0 then
        return 0
    let magnitude := bitLen(m) * 301 div 1000 + exp  # about log10 of the value
    if magnitude > 310 then
        return Infinity
    if magnitude < -330 then
        return 0
    var n := m
    var d: List[Integer] := [1]
    for k := 1 to exp do
        n := mulAdd(n, 10, c: 0)
    for k := 1 to -exp do
        d := mulAdd(d, 10, c: 0)
    # n / d is in [2^(k-1), 2^(k+1)) for k = bitLen(n) - bitLen(d), so scaled by 2^-e it
    # has 53 or 54 bits; at the bottom of the subnormals fewer.
    var e := bitLen(n) - bitLen(d) - 53
    if e < -1074 then
        e := -1074
    var quot := scaled(n, d, e: e)
    if quot.q >= shl(1, 53) then
        e := e + 1
        quot := scaled(n, d, e: e)
    var den := d
    if e >= 0 then
        den := shifted(d, e)
    var q := quot.q
    let half := compare(shifted(quot.r, 1), den)
    if half > 0 or (half = 0 and q mod 2 = 1) then
        q := q + 1
    if q = shl(1, 53) then
        q := shl(1, 52)
        e := e + 1
    if q < shl(1, 52) then
        return q  # a subnormal: e is -1074
    if e + 1075 >= 2047 then
        return Infinity
    return shl(e + 1075, 52) + q - shl(1, 52)

test "exact and rounded literals"
    assert realBits("0.0") = 0 and realBits("1.0") = 0x3FF0000000000000
    assert realBits("0.1") = 0x3FB999999999999A and realBits("2.5") = 0x4004000000000000
    assert realBits("1.0e-9") = 0x3E112E0BE826D695 and realBits("0.000001") = 0x3EB0C6F7A0B5ED8D
    assert realBits("123456.789e3") = 0x419D6F3454000000
    assert realBits("0.30000000000000004") = 0x3FD3333333333334
    assert realBits("3.141592653589793238462643383279") = 0x400921FB54442D18
    assert realBits("9007199254740993.0") = 0x4340000000000000  # a tie, to even

test "the edges of the range"
    assert realBits("1.7976931348623157e308") = 0x7FEFFFFFFFFFFFFF
    assert realBits("1.7976931348623159e308") = 0x7FF0000000000000
    assert realBits("1.0e400") = 0x7FF0000000000000 and realBits("1.0e-400") = 0
    assert realBits("2.2250738585072014e-308") = 0x10000000000000
    assert realBits("4.9e-324") = 1 and realBits("2.5e-324") = 1 and realBits("2.4e-324") = 0
