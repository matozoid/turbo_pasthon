unit Ast

{ Abstract syntax tree (SPEC §16).

  Every node has a `span` covering its source text (SPEC §15.6). Declarations carry their
  doc comment in `doc`; nodes that can be closed by an end marker (SPEC §2.4) record
  its span in `endMarker`.

  The parser never stops at an error. Broken statements and expressions become
  `ErrorStmt` / `ErrorExpr` nodes, so the tree is always complete.

  Expressions and arguments carry an `id`, unique within a parse, that later stages use
  to attach facts (types, chosen overloads) to them. }

uses Source

type
    { -------------------------------------------------------------- names, types }

    export Ident = record
        export span: Span
        export name: String

    { `Integer`, `List[T]`, `Geometry.Shape`, `Array[T, N * 2]`.

      `args` holds type expressions, or plain expressions for constant arguments. A bare
      name may also turn out to be a constant (`N` in `Array[T, N]`); the checker decides. }
    export TypeName = record
        export span: Span
        export parts: List[String]
        export args: List[TypeOrExpr]
        { One per part. }
        export partSpans: List[Span]

    export RefType = record
        export span: Span
        export target: TypeExpr

    export FuncType = record
        export span: Span
        export isFunction: Boolean
        export params: List[TypeExpr]
        export result: Option[TypeExpr]

    export TypeExpr = TypeName | RefType | FuncType

    { A type argument or index item: a type, or an expression. }
    export TypeOrExpr = TypeExpr | Expr

    export TypeParam = record
        export span: Span
        export name: Ident
        { Traits, or the type of a constant parameter (`N: Integer`). }
        export bounds: List[TypeExpr]

    { --------------------------------------------------------------- expressions }

    export Name = record
        export span: Span
        export id: Integer
        export name: String

    export IntLit = record
        export span: Span
        export id: Integer
        export value: UInt64

    { The value is kept as its digits, without `_`. }
    export RealLit = record
        export span: Span
        export id: Integer
        export digits: String

    export CharLit = record
        export span: Span
        export id: Integer
        export value: Char

    export BoolLit = record
        export span: Span
        export id: Integer
        export value: Boolean

    export StringLit = record
        export span: Span
        export id: Integer
        export value: String

    { The text between placeholders. }
    export TextPart = record
        export text: String

    { A placeholder with a field width, and for a real the digits after the point:
      `{x:8}`, `{x:0:2}`. }
    export FormatPart = record
        export value: Expr
        export width: Expr
        export decimals: Option[Expr]

    export InterpPart = TextPart | Expr | FormatPart

    { A string with placeholders: text parts and expressions, in order. }
    export InterpString = record
        export span: Span
        export id: Integer
        export parts: List[InterpPart]

    export ListLit = record
        export span: Span
        export id: Integer
        export items: List[Expr]

    export MapEntry = record
        export span: Span
        export key: Expr
        export value: Expr

    export MapLit = record
        export span: Span
        export id: Integer
        export entries: List[MapEntry]

    export Paren = record
        export span: Span
        export id: Integer
        export inner: Expr

    export Unary = record
        export span: Span
        export id: Integer
        { `-`, `not`, `try`. }
        export op: String
        export operand: Expr

    export Binary = record
        export span: Span
        export id: Integer
        { `+`, `div`, `and`, `<=`, `in`, ... }
        export op: String
        export left: Expr
        export right: Expr
        export opSpan: Span

    export Arg = record
        export span: Span
        export id: Integer
        { A named argument. }
        export name: Option[Ident]
        { `var x` at the call site. }
        export isVar: Boolean
        export value: Expr

    export Call = record
        export span: Span
        export id: Integer
        export callee: Expr
        export args: List[Arg]

    { `a[i]` or `f[Integer]`: indexing and explicit instantiation look the same, so the
      checker decides (SPEC §16). Items may be type expressions. }
    export Index = record
        export span: Span
        export id: Integer
        export target: Expr
        export items: List[TypeOrExpr]

    export FieldAccess = record
        export span: Span
        export id: Integer
        export target: Expr
        export name: Ident

    export Deref = record
        export span: Span
        export id: Integer
        export target: Expr

    export CondExpr = record
        export span: Span
        export cond: Expr
        export value: Expr

    export IfExpr = record
        export span: Span
        export id: Integer
        export branches: List[CondExpr]
        export elseValue: Expr

    { `for x in xs do e`: the list of the values of `e` (SPEC §9.4). The parser writes it
      as the loops that build it: `for` statements, one per clause, each the only
      statement of the one before, and in the innermost a `ForValue`, or for `continue`
      and `break` branches an `If` statement of `ForValue`s and `Continue`s. }
    export ForExpr = record
        export span: Span
        export id: Integer
        export loop: Stmt

    { `x => e`, `(a, b) => e`: a function value whose parameter types come from the
      function type expected where it is written (SPEC §4.11). }
    export Lambda = record
        export span: Span
        export id: Integer
        export params: List[Ident]
        export body: Expr

    export ErrorExpr = record
        export span: Span
        export id: Integer

    { --------------------------------------------------------------- case labels }

    { A constant, or a bare name: an enum member or a variant without binding. }
    export ValueLabel = record
        export span: Span
        export value: Expr

    export RangeLabel = record
        export span: Span
        export low: Expr
        export high: Expr

    { `Circle(c)` / `Circle(_)`: a union variant with a binding. }
    export VariantLabel = record
        export span: Span
        export variant: TypeName
        { The name starts with `_` for a discard. }
        export binding: Ident

    export Label = ValueLabel | RangeLabel | VariantLabel

    export CaseExprArm = record
        export span: Span
        { Empty for `else`. }
        export labels: List[Label]
        export value: Expr

    export CaseExpr = record
        export span: Span
        export id: Integer
        export subject: Expr
        export arms: List[CaseExprArm]

    export Expr = Name | IntLit | RealLit | CharLit | BoolLit | StringLit | InterpString | ListLit | MapLit | Paren | Unary | Binary | Call | Index | FieldAccess | Deref | IfExpr | CaseExpr | ForExpr | Lambda | ErrorExpr

    { ---------------------------------------------------------------- statements }

    export Block = record
        export span: Span
        export stmts: List[Stmt]

    export VarDecl = record
        export span: Span
        { `var` or `let`. }
        export mutable: Boolean
        export name: Ident
        export declType: Option[TypeExpr]
        export value: Expr

    export Assign = record
        export span: Span
        export target: Expr
        export value: Expr

    export Discard = record
        export span: Span
        { `_` or `_name`. }
        export name: String
        export value: Expr

    export ExprStmt = record
        export span: Span
        export expr: Expr

    export CondBlock = record
        export span: Span
        export cond: Expr
        export body: Block

    export If = record
        export span: Span
        { `if` and every `else if`. }
        export branches: List[CondBlock]
        export elseBody: Option[Block]
        export endMarker: Option[Span]

    export While = record
        export span: Span
        export cond: Expr
        export body: Block
        export endMarker: Option[Span]

    export Repeat = record
        export span: Span
        export body: Block
        export cond: Expr

    export ForRange = record
        export span: Span
        export variable: Ident
        export start: Expr
        export stop: Expr
        export down: Boolean
        export body: Block
        export endMarker: Option[Span]

    export ForIn = record
        export span: Span
        { One, or key and value for maps; names may be discards. }
        export vars: List[Ident]
        export iterable: Expr
        export body: Block
        export endMarker: Option[Span]

    { An indented block, or one statement on the arm's line. }
    export ArmBody = Block | Stmt

    export CaseArm = record
        export span: Span
        { Empty for `else`. }
        export labels: List[Label]
        export body: ArmBody

    export Case = record
        export span: Span
        export subject: Expr
        export arms: List[CaseArm]
        export endMarker: Option[Span]

    export Defer = record
        export span: Span
        export body: ArmBody
        export endMarker: Option[Span]

    export Break = record
        export span: Span

    export Continue = record
        export span: Span

    { Does nothing: the body of a block or case arm with nothing to do. }
    export Pass = record
        export span: Span

    export Return = record
        export span: Span
        export value: Option[Expr]

    export Assert = record
        export span: Span
        export cond: Expr
        export message: Option[Expr]

    export ErrorStmt = record
        export span: Span

    { In a `for` expression (`ForExpr`): adds `value` to its list, or with none (`break`)
      ends it. }
    export ForValue = record
        export span: Span
        export value: Option[Expr]

    export Stmt = VarDecl | Assign | Discard | ExprStmt | If | While | Repeat | ForRange | ForIn | Case | Defer | Break | Continue | Pass | Return | Assert | ForValue | ErrorStmt

    { -------------------------------------------------------------- declarations }

    export FieldDecl = record
        export span: Span
        export exported: Boolean
        export name: Ident
        export declType: TypeExpr
        export default: Option[Expr]
        export doc: Option[String]

    { One parameter group: `a, b: T`, `var x: T := d`, `this`, `var this`, or `...`. }
    export Param = record
        export span: Span
        export isVar: Boolean
        { Several for a group; `this` for a `this` parameter. }
        export names: List[Ident]
        { None for `this` and `...`. }
        export declType: Option[TypeExpr]
        export default: Option[Expr]
        export isThis: Boolean
        export isVarargs: Boolean

    export Signature = record
        export span: Span
        export isFunction: Boolean
        export name: Ident
        export typeParams: List[TypeParam]
        export params: List[Param]
        export result: Option[TypeExpr]
        export doc: Option[String]

    export EnumType = record
        export span: Span
        export members: List[Ident]

    export SubrangeType = record
        export span: Span
        export low: Expr
        export high: Expr

    export UnionType = record
        export span: Span
        export variants: List[TypeExpr]

    export RecordType = record
        export span: Span
        export fields: List[FieldDecl]
        { Declared in an extern block: a C record (SPEC §10.5). }
        export c: Boolean

    export TraitType = record
        export span: Span
        export fields: List[FieldDecl]
        export routines: List[Signature]

    export TypeBody = TypeExpr | EnumType | SubrangeType | UnionType | RecordType | TraitType

    export TypeDecl = record
        export span: Span
        export exported: Boolean
        export name: Ident
        export params: List[TypeParam]
        export body: TypeBody
        export doc: Option[String]
        export endMarker: Option[Span]

    export TypeSection = record
        export span: Span
        export decls: List[TypeDecl]

    export ConstDecl = record
        export span: Span
        export exported: Boolean
        export name: Ident
        export value: Expr
        export doc: Option[String]

    export ConstSection = record
        export span: Span
        export decls: List[ConstDecl]

    export Routine = record
        export span: Span
        export exported: Boolean
        export isUnsafe: Boolean
        export sig: Signature
        { `requires` clauses. }
        export pre: List[Expr]
        { `ensures` clauses. }
        export post: List[Expr]
        export body: Block
        export doc: Option[String]
        export endMarker: Option[Span]

    export ExternDecl = record
        export span: Span
        export id: Integer
        export exported: Boolean
        export sig: Signature
        { `as "symbol"`. }
        export symbol: Option[String]
        export doc: Option[String]

    { Type sections in an extern block declare C records. }
    export ExternItem = ExternDecl | TypeSection

    export ExternBlock = record
        export span: Span
        export library: String
        export decls: List[ExternItem]
        export endMarker: Option[Span]

    export TestBlock = record
        export span: Span
        export name: String
        export body: Block
        export endMarker: Option[Span]

    export Decl = TypeSection | ConstSection | Routine | ExternBlock | TestBlock

    { Statements appear only in programs. }
    export TopItem = Decl | Stmt

    { Where a used unit comes from, in `uses X from "url"` or `uses X from U.C`. }
    export UnitSource = record
        export span: Span
        { The URL, when it is written as a string; else "". }
        export url: String
        { The unit and the string constant naming the URL, in `U.C`; else empty names. }
        export constUnit: Ident
        export constName: Ident

    export SourceFile = record
        export span: Span
        { `program` or `unit`. }
        export kind: String
        export name: Ident
        export units: List[Ident]
        { One per unit, in the same order: where it comes from, if not found by name. }
        export sources: List[Option[UnitSource]]
        { In source order. }
        export items: List[TopItem]

{ -------------------------------------------------------------------- spans }

export function exprSpan(e: Expr): Span
    case e of
        Name(x): return x.span
        IntLit(x): return x.span
        RealLit(x): return x.span
        CharLit(x): return x.span
        BoolLit(x): return x.span
        StringLit(x): return x.span
        InterpString(x): return x.span
        ListLit(x): return x.span
        MapLit(x): return x.span
        Paren(x): return x.span
        Unary(x): return x.span
        Binary(x): return x.span
        Call(x): return x.span
        Index(x): return x.span
        FieldAccess(x): return x.span
        Deref(x): return x.span
        IfExpr(x): return x.span
        CaseExpr(x): return x.span
        ForExpr(x): return x.span
        Lambda(x): return x.span
        ErrorExpr(x): return x.span

export function stmtSpan(s: Stmt): Span
    case s of
        VarDecl(x): return x.span
        Assign(x): return x.span
        Discard(x): return x.span
        ExprStmt(x): return x.span
        If(x): return x.span
        While(x): return x.span
        Repeat(x): return x.span
        ForRange(x): return x.span
        ForIn(x): return x.span
        Case(x): return x.span
        Defer(x): return x.span
        Break(x): return x.span
        Continue(x): return x.span
        Pass(x): return x.span
        Return(x): return x.span
        Assert(x): return x.span
        ForValue(x): return x.span
        ErrorStmt(x): return x.span

export function typeSpan(t: TypeExpr): Span
    case t of
        TypeName(x): return x.span
        RefType(x): return x.span
        FuncType(x): return x.span

{ The id of an expression, unique within a parse. }
export function exprId(e: Expr): Integer
    case e of
        Name(x): return x.id
        IntLit(x): return x.id
        RealLit(x): return x.id
        CharLit(x): return x.id
        BoolLit(x): return x.id
        StringLit(x): return x.id
        InterpString(x): return x.id
        ListLit(x): return x.id
        MapLit(x): return x.id
        Paren(x): return x.id
        Unary(x): return x.id
        Binary(x): return x.id
        Call(x): return x.id
        Index(x): return x.id
        FieldAccess(x): return x.id
        Deref(x): return x.id
        IfExpr(x): return x.id
        CaseExpr(x): return x.id
        ForExpr(x): return x.id
        Lambda(x): return x.id
        ErrorExpr(x): return x.id

{ ---------------------------------------------------------------------- walkers }

{ The expressions directly inside `e`, in source order. Types and lambda bodies are
  skipped. }
export function exprKids(e: Expr): List[Expr]
    var out: List[Expr] := []
    case e of
        InterpString(x):
            for p in x.parts do
                case p of
                    Expr(pe):
                        add(var out, pe)
                    FormatPart(fp):
                        add(var out, fp.value)
                        add(var out, fp.width)
                        if fp.decimals.isSome() then
                            add(var out, fp.decimals.get())
                    else:
                        pass
        ListLit(x):
            out := x.items
        MapLit(x):
            for en in x.entries do
                add(var out, en.key)
                add(var out, en.value)
        Paren(x):
            add(var out, x.inner)
        Unary(x):
            add(var out, x.operand)
        Binary(x):
            add(var out, x.left)
            add(var out, x.right)
        Call(x):
            add(var out, x.callee)
            for arg in x.args do
                add(var out, arg.value)
        Index(x):
            add(var out, x.target)
            for it in x.items do
                case it of
                    Expr(ie):
                        add(var out, ie)
                    else:
                        pass
        FieldAccess(x):
            add(var out, x.target)
        Deref(x):
            add(var out, x.target)
        IfExpr(x):
            for b in x.branches do
                add(var out, b.cond)
                add(var out, b.value)
            add(var out, x.elseValue)
        CaseExpr(x):
            add(var out, x.subject)
            for arm in x.arms do
                for lb in arm.labels do
                    labelExprs(var out, lb)
                add(var out, arm.value)
        ForExpr(x):
            loopExprs(var out, x.loop)
        else:
            pass
    return out

{ The expressions in the statements a `for` expression is written as (`ForExpr`). }
export procedure loopExprs(var out: List[Expr], s: Stmt)
    case s of
        ForRange(x):
            add(var out, x.start)
            add(var out, x.stop)
            for b in x.body.stmts do
                loopExprs(var out, b)
        ForIn(x):
            add(var out, x.iterable)
            for b in x.body.stmts do
                loopExprs(var out, b)
        If(x):
            for br in x.branches do
                add(var out, br.cond)
                for b in br.body.stmts do
                    loopExprs(var out, b)
            case x.elseBody of
                Some(eb):
                    for b in eb.value.stmts do
                        loopExprs(var out, b)
                None:
                    pass
        ForValue(x):
            case x.value of
                Some(v):
                    add(var out, v.value)
                None:
                    pass
        else:
            pass

export procedure labelExprs(var out: List[Expr], lb: Label)
    case lb of
        ValueLabel(v):
            add(var out, v.value)
        RangeLabel(r):
            add(var out, r.low)
            add(var out, r.high)
        VariantLabel(_):
            pass
