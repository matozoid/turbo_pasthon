program ResolveDump

## Prints the symbol index and the diagnostics of resolving a program or unit in a
## canonical form, which tests/test_port.py compares with golden files.
##
## Usage: `ResolveDump STD_DIR FILE`.

uses IO, OS, Strings, Source, Diagnostics, Symbols, Resolve

## `s` in double quotes, with `\`, `"` and control characters escaped.
function quote(s: String): String
    var parts: List[String] := ["\""]
    for c in s do
        if c = '\\' then
            add(var parts, "\\\\")
        else if c = '"' then
            add(var parts, "\\\"")
        else if c = '\n' then
            add(var parts, "\\n")
        else
            add(var parts, toString(c))
    add(var parts, "\"")
    return join(parts)

function where(s: Span): String
    return "{s.line}:{s.col}-{s.endLine}:{s.endCol}"

let a := args()
if len(a) <> 2 then
    writelnErr("usage: ResolveDump STD_DIR FILE")
    exit(2)
let r := resolve(a[1], stdDir: a[0])
for x in r.checker.index.refs do
    var what := "use"
    if x.isDef then
        what := "def"
    writeln("{what} {x.file} {where(x.span)}")
    for t in x.targets do
        writeln("  {describe(t)} @ {location(t)}")
for d in r.checker.diagnostics do
    writeln("{d.file} {name(d.severity)} {d.code} {where(d.span)} {quote(d.message)}")
    for f in d.fixes do
        writeln("  fix {quote(f.description)}")
        for e in f.edits do
            writeln("    edit {where(e.span)} {quote(e.text)}")
