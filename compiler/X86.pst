unit X86

## A small x86-64 assembler: just the instructions the emit pass uses (SPEC §15.2 step 4).
##
## Code goes into `code` and constant data into `rodata`. Jumps, calls and RIP-relative
## loads refer to labels, resolved by `finish` once the distance from the code to the
## read-only data is known.

uses Strings

const
    export Rax = 0
    export Rcx = 1
    export Rdx = 2
    export Rbx = 3
    export Rsp = 4
    export Rbp = 5
    export Rsi = 6
    export Rdi = 7
    export R8 = 8
    export R9 = 9
    export R10 = 10
    export R11 = 11
    export R12 = 12
    export R13 = 13
    export R14 = 14
    export R15 = 15
    export Xmm0 = 0
    export Xmm1 = 1

type
    ## A rel32 to fill in: at `pos`, to `label` of kind "code", "data", "got" or "global".
    Fixup = record
        pos: Integer
        label: String
        kind: String

    ## The 8 bytes at `offset` in data `data` hold the distance to code label `label`.
    CodeRef = record
        data: String
        offset: Integer
        label: String

    export Assembler = record
        export code: List[Byte]
        export rodata: List[Byte]
        ## Code labels: offset in code.
        export labels: Map[String, Integer]
        ## Data labels: offset in rodata.
        export dataLabels: Map[String, Integer]
        fixups: List[Fixup]
        codeRefs: List[CodeRef]
        ## Data already added, by its bytes (see `bytesKey`).
        strings: Map[String, String]
        ## Imported C functions, in GOT order.
        export imports: List[String]
        ## Writable words, after the GOT.
        export globals: List[String]
        n: Integer
        ## While `tracked`: a word per value pushed and not yet popped, in code order,
        ## true for an owned reference (see the emitter's `save`).
        export tracked: Boolean
        export stack: List[Boolean]

export function newAssembler(): ref Assembler
    return new(Assembler(
        code: [],
        rodata: [],
        labels: {},
        dataLabels: {},
        fixups: [],
        codeRefs: [],
        strings: {},
        imports: [],
        globals: [],
        n: 0,
        tracked: false,
        stack: [],
    ))

# ---------------------------------------------------------------------- bytes

## The low 8 bits of `v`.
export function byte(v: Integer): Byte
    return Byte(v and 255)

procedure put(var bs: List[Byte], v: Integer)
    add(var bs, byte(v))

## Appends `v` as `n` little-endian bytes (its low 8n bits).
export procedure putLE(var bs: List[Byte], v, n: Integer)
    for i := 0 to n - 1 do
        put(var bs, v shr (8 * i))

## Overwrites `n` bytes at `pos` with `v`, little-endian.
export procedure setLE(var bs: List[Byte], pos, v, n: Integer)
    for i := 0 to n - 1 do
        bs[pos + i] := byte(v shr (8 * i))

function rex(w: Boolean, reg: Integer, rm: Integer): Integer
    var r := $40
    if w then
        r := r + 8
    if reg >= 8 then
        r := r + 4
    if rm >= 8 then
        r := r + 1
    return r

function fits32(v: Integer): Boolean
    return v >= -2147483648 and v < 2147483648

## The low 3 bits of a register number.
function low(r: Integer): Integer
    return r and 7

## A ModRM byte with both operands registers.
function modrm(reg: Integer, rm: Integer): Integer
    return $C0 + 8 * low(reg) + low(rm)

## A key for a byte string, to share equal data.
function bytesKey(bs: List[Byte]): String
    var parts: List[String] := []
    for b in bs do
        add(var parts, toString(Integer(b)))
    return join(parts, sep: ",")

function indexOf(xs: List[String], x: String): Integer
    for i := 0 to len(xs) - 1 do
        if xs[i] = x then
            return i
    return -1

# --------------------------------------------------------------------- labels

export function newLabel(a: ref Assembler, hint: String := "L"): String
    a.n := a.n + 1
    return ".{hint}{a.n}"

export procedure label(a: ref Assembler, name: String)
    assert not (name in a.labels), "label defined twice"
    a.labels[name] := len(a.code)

## Adds read-only data; returns its label. Equal byte strings are shared.
export function data(a: ref Assembler, value: List[Byte], align: Integer := 1): String
    let k := bytesKey(value)
    if k in a.strings then
        return a.strings[k]
    while len(a.rodata) mod align <> 0 do
        add(var a.rodata, Byte(0))
    let name := newLabel(a, "D")
    a.dataLabels[name] := len(a.rodata)
    for b in value do
        add(var a.rodata, b)
    a.strings[k] := name
    return name

## Makes the 8 bytes at `offset` in data `data` hold the distance from the start of
## `data` to code label `label`.
export procedure codeRef(a: ref Assembler, data: String, offset: Integer, label: String)
    add(var a.codeRefs, CodeRef(data: data, offset: offset, label: label))

## Makes the 8 bytes at `offset` in data `data` hold the distance from the start of
## `data` to data `target`.
export procedure dataRef(a: ref Assembler, data: String, offset: Integer, target: String)
    let distance := a.dataLabels[target] - a.dataLabels[data]
    setLE(var a.rodata, a.dataLabels[data] + offset, distance, n: 8)

procedure rel32(a: ref Assembler, label: String, kind: String := "code")
    add(var a.fixups, Fixup(pos: len(a.code), label: label, kind: kind))
    putLE(var a.code, 0, n: 4)

## Resolves labels. `rodataOffset` and `gotOffset` are where the data and the GOT start,
## counted from the start of the code.
export procedure finish(a: ref Assembler, rodataOffset: Integer, gotOffset: Integer := 0)
    for f in a.fixups do
        var target := 0
        if f.kind = "data" then
            target := rodataOffset + a.dataLabels[f.label]
        else if f.kind = "got" then
            target := gotOffset + 8 * indexOf(a.imports, f.label)
        else if f.kind = "global" then
            target := gotOffset + 8 * (len(a.imports) + indexOf(a.globals, f.label))
        else
            assert f.label in a.labels, "undefined label"
            target := a.labels[f.label]
        setLE(var a.code, f.pos, target - (f.pos + 4), n: 4)
    for r in a.codeRefs do
        let at := a.dataLabels[r.data]
        let distance := a.labels[r.label] - (rodataOffset + at)
        setLE(var a.rodata, at + r.offset, distance, n: 8)

# --------------------------------------------------------------- instructions

export procedure emit(a: ref Assembler, bs: List[Integer])
    for b in bs do
        put(var a.code, b)

## `op r/m, reg` with both operands registers.
procedure rr(a: ref Assembler, op, dst, src: Integer, w: Boolean := true)
    let x := rex(w, src, rm: dst)
    if x <> $40 then
        emit(a, [x])
    emit(a, [op, modrm(src, rm: dst)])

export procedure mov(a: ref Assembler, dst, src: Integer)
    rr(a, $89, dst, src)

export procedure movImm(a: ref Assembler, dst: Integer, value: Integer)
    if value >= 0 and value < 4294967296 then  # mov r32, imm32 zero-extends
        if dst >= 8 then
            emit(a, [$41])
        emit(a, [$B8 + low(dst)])
        putLE(var a.code, value, n: 4)
    else if fits32(value) then  # mov r/m64, imm32 sign-extends
        emit(a, [rex(true, 0, rm: dst), $C7, $C0 + low(dst)])
        putLE(var a.code, value, n: 4)
    else
        emit(a, [rex(true, 0, rm: dst), $B8 + low(dst)])
        putLE(var a.code, value, n: 8)

## `mov r64, imm64` whatever the value: the form for unsigned constants above 2^63 - 1.
export procedure movImm64(a: ref Assembler, dst: Integer, value: Integer)
    emit(a, [rex(true, 0, rm: dst), $B8 + low(dst)])
    putLE(var a.code, value, n: 8)

## An instruction with a `[base + disp]` operand. `reg` is the register operand or the
## opcode extension. `flags`: 1 for a 64-bit operand (REX.W), 2 for a byte register
## operand, 4 for a $66 prefix.
procedure mem(
    a: ref Assembler,
    op: List[Integer],
    reg,
    base: Integer,
    disp: Integer,
    flags: Integer := 1,
)
    if (flags and 4) <> 0 then
        emit(a, [$66])
    let x := rex((flags and 1) <> 0, reg, rm: base)
    if x <> $40 or ((flags and 2) <> 0 and reg >= 4) then  # spl..dil need a REX prefix
        emit(a, [x])
    emit(a, op)
    var md := 2
    if disp = 0 and low(base) <> Rbp then
        md := 0
    else if disp >= -128 and disp < 128 then
        md := 1
    emit(a, [md * 64 + 8 * low(reg) + low(base)])
    if low(base) = Rsp then
        emit(a, [$24])  # SIB: no index
    if md = 1 then
        emit(a, [disp])
    else if md = 2 then
        putLE(var a.code, disp, n: 4)

## `mov dst, [base + disp]`.
export procedure load(a: ref Assembler, dst, base: Integer, disp: Integer := 0)
    mem(a, [$8B], dst, base, disp: disp)

## `mov [base + disp], src`.
export procedure store(a: ref Assembler, base: Integer, disp: Integer, src: Integer)
    mem(a, [$89], src, base, disp: disp)

## `mov byte [base + disp], src8`.
export procedure store8(a: ref Assembler, base: Integer, disp: Integer, src: Integer)
    mem(a, [$88], src, base, disp: disp, flags: 2)

export procedure store8Imm(a: ref Assembler, base: Integer, disp: Integer, value: Integer)
    mem(a, [$C6], 0, base, disp: disp, flags: 0)
    emit(a, [value])

## `mov qword [base + disp], imm32` (sign-extended).
export procedure storeImm(a: ref Assembler, base: Integer, disp: Integer, value: Integer)
    mem(a, [$C7], 0, base, disp: disp)
    putLE(var a.code, value, n: 4)

## `movzx dst32, byte [base + disp]`.
export procedure load8(a: ref Assembler, dst, base: Integer, disp: Integer := 0)
    mem(a, [$0F, $B6], dst, base, disp: disp, flags: 0)

## Loads a `bits`-wide integer, sign- or zero-extended to 64 bits.
export procedure loadW(
    a: ref Assembler,
    dst,
    base: Integer,
    disp: Integer,
    bits: Integer,
    signed: Boolean,
)
    if bits = 64 then
        load(a, dst, base, disp: disp)
    else if bits = 8 and signed then
        mem(a, [$0F, $BE], dst, base, disp: disp)
    else if bits = 8 then
        mem(a, [$0F, $B6], dst, base, disp: disp, flags: 0)
    else if bits = 16 and signed then
        mem(a, [$0F, $BF], dst, base, disp: disp)
    else if bits = 16 then
        mem(a, [$0F, $B7], dst, base, disp: disp, flags: 0)
    else if signed then
        mem(a, [$63], dst, base, disp: disp)
    else
        mem(a, [$8B], dst, base, disp: disp, flags: 0)

## Stores the low `bits` of `src`.
export procedure storeW(a: ref Assembler, base: Integer, disp: Integer, src: Integer, bits: Integer)
    if bits = 8 then
        store8(a, base, disp: disp, src: src)
    else if bits = 16 then
        mem(a, [$89], src, base, disp: disp, flags: 4)
    else if bits = 32 then
        mem(a, [$89], src, base, disp: disp, flags: 0)
    else
        store(a, base, disp: disp, src: src)

## Sign- or zero-extends the low `bits` of `r` to 64 bits.
export procedure extend(a: ref Assembler, r: Integer, bits: Integer, signed: Boolean)
    if bits = 64 then
        return
    if bits = 32 then
        if signed then  # movsxd r64, r32
            emit(a, [rex(true, r, rm: r), $63, modrm(r, rm: r)])
        else  # mov r32, r32 zero-extends
            rr(a, $89, r, r, w: false)
        return
    var op := $B7
    if bits = 8 and signed then
        op := $BE
    else if bits = 8 then
        op := $B6
    else if signed then
        op := $BF
    emit(a, [rex(true, r, rm: r), $0F, op, modrm(r, rm: r)])

export procedure incMem(a: ref Assembler, base: Integer, disp: Integer := 0)
    mem(a, [$FF], 0, base, disp: disp)

export procedure decMem(a: ref Assembler, base: Integer, disp: Integer := 0)
    mem(a, [$FF], 1, base, disp: disp)

## `cmp qword [base + disp], imm8`.
export procedure cmpMemImm(a: ref Assembler, base: Integer, disp: Integer, value: Integer)
    mem(a, [$83], 7, base, disp: disp)
    emit(a, [value])

export procedure lea(a: ref Assembler, dst, base: Integer, disp: Integer)
    mem(a, [$8D], dst, base, disp: disp)

## `lea dst, [rip + label]` for a rodata label.
export procedure leaData(a: ref Assembler, dst: Integer, label: String)
    emit(a, [rex(true, dst, rm: 0), $8D, $05 + 8 * low(dst)])
    rel32(a, label, kind: "data")

## `mov dst, [rip + global]`.
export procedure loadGlobal(a: ref Assembler, dst: Integer, name: String)
    global(a, $8B, dst, name: name)

## `lea dst, [rip + global]`.
export procedure leaGlobal(a: ref Assembler, dst: Integer, name: String)
    global(a, $8D, dst, name: name)

## `mov [rip + global], src`.
export procedure storeGlobal(a: ref Assembler, name: String, src: Integer)
    global(a, $89, src, name: name)

procedure global(a: ref Assembler, op, r: Integer, name: String)
    if indexOf(a.globals, name) < 0 then
        add(var a.globals, name)
    emit(a, [rex(true, r, rm: 0), op, $05 + 8 * low(r)])
    rel32(a, name, kind: "global")

## `lea dst, [rip + label]` for a code label.
export procedure leaCode(a: ref Assembler, dst: Integer, label: String)
    emit(a, [rex(true, dst, rm: 0), $8D, $05 + 8 * low(dst)])
    rel32(a, label)

export procedure add(a: ref Assembler, dst, src: Integer)
    rr(a, $01, dst, src)

export procedure xorR(a: ref Assembler, dst, src: Integer)
    rr(a, $31, dst, src)

export procedure orR(a: ref Assembler, dst, src: Integer)
    rr(a, $09, dst, src)

export procedure andR(a: ref Assembler, dst, src: Integer)
    rr(a, $21, dst, src)

export procedure sub(a: ref Assembler, dst, src: Integer)
    rr(a, $29, dst, src)

export procedure cmp(a: ref Assembler, x, y: Integer)
    rr(a, $39, x, y)

## `cmp x, [base + disp]`.
export procedure cmpMem(a: ref Assembler, x, base: Integer, disp: Integer)
    mem(a, [$3B], x, base, disp: disp)

export procedure testR(a: ref Assembler, x, y: Integer)
    rr(a, $85, x, y)

## `test` of the low 32 bits (for C `int` results).
export procedure test32(a: ref Assembler, x, y: Integer)
    rr(a, $85, x, y, w: false)

## `imul dst, src` (signed; sets OF on overflow).
export procedure imul(a: ref Assembler, dst, src: Integer)
    emit(a, [rex(true, dst, rm: src), $0F, $AF, modrm(dst, rm: src)])

procedure unary(a: ref Assembler, ext, r: Integer)
    emit(a, [rex(true, 0, rm: r), $F7, modrm(ext, rm: r)])

export procedure neg(a: ref Assembler, r: Integer)
    unary(a, 3, r: r)

export procedure notR(a: ref Assembler, r: Integer)
    unary(a, 2, r: r)

export procedure shlCl(a: ref Assembler, r: Integer)
    emit(a, [rex(true, 0, rm: r), $D3, $E0 + low(r)])

## Logical shift right by cl.
export procedure shrCl(a: ref Assembler, r: Integer)
    emit(a, [rex(true, 0, rm: r), $D3, $E8 + low(r)])

export procedure popcnt(a: ref Assembler, dst, src: Integer)
    emit(a, [$F3, rex(true, dst, rm: src), $0F, $B8, modrm(dst, rm: src)])

## Unsigned rdx:rax := rax * r (sets CF when rdx isn't 0).
export procedure mul(a: ref Assembler, r: Integer)
    unary(a, 4, r: r)

## Unsigned rdx:rax / r: quotient in rax, remainder in rdx.
export procedure divR(a: ref Assembler, r: Integer)
    unary(a, 6, r: r)

## Signed rdx:rax / r: quotient in rax, remainder in rdx.
export procedure idiv(a: ref Assembler, r: Integer)
    unary(a, 7, r: r)

## Sign-extends rax into rdx.
export procedure cqo(a: ref Assembler)
    emit(a, [$48, $99])

export procedure incR(a: ref Assembler, r: Integer)
    emit(a, [rex(true, 0, rm: r), $FF, $C0 + low(r)])

export procedure decR(a: ref Assembler, r: Integer)
    emit(a, [rex(true, 0, rm: r), $FF, $C8 + low(r)])

## An SSE2 instruction `prefix [rex] 0F op modrm`, with registers as both operands.
procedure sse(a: ref Assembler, prefix, op, reg, rm: Integer, w: Boolean := false)
    emit(a, [prefix])
    let x := rex(w, reg, rm: rm)
    if x <> $40 then
        emit(a, [x])
    emit(a, [$0F, op, modrm(reg, rm: rm)])

## `movq xmm, r64`: the bits of a general register into an xmm register.
export procedure movqToXmm(a: ref Assembler, x, r: Integer)
    sse(a, $66, $6E, x, rm: r, w: true)

## `movq r64, xmm`: the bits of an xmm register into a general register.
export procedure movqFromXmm(a: ref Assembler, r, x: Integer)
    sse(a, $66, $7E, x, rm: r, w: true)

## `movd xmm, r32`: the low 32 bits of a general register into an xmm register.
export procedure movdToXmm(a: ref Assembler, x, r: Integer)
    sse(a, $66, $6E, x, rm: r)

## `movd r32, xmm`: the low 32 bits of an xmm register into a general register, zeroing
## the upper ones.
export procedure movdFromXmm(a: ref Assembler, r, x: Integer)
    sse(a, $66, $7E, x, rm: r)

## `cvtss2sd dst, src`: a single to a double, exactly.
export procedure cvtss2sd(a: ref Assembler, dst, src: Integer)
    sse(a, $F3, $5A, dst, rm: src)

## `cvtsd2ss dst, src`: a double to the nearest single.
export procedure cvtsd2ss(a: ref Assembler, dst, src: Integer)
    sse(a, $F2, $5A, dst, rm: src)

## `addsd`, `subsd`, `mulsd` or `divsd dst, src` for the operator `op`.
export procedure realOp(a: ref Assembler, op: String, dst, src: Integer)
    var code := $58
    if op = "-" then
        code := $5C
    else if op = "*" then
        code := $59
    else if op = "/" then
        code := $5E
    sse(a, $F2, code, dst, rm: src)

## `ucomisd x, y`: compares two reals; unordered (a NaN) sets ZF, PF and CF.
export procedure ucomisd(a: ref Assembler, x, y: Integer)
    sse(a, $66, $2E, x, rm: y)

## `cvtsi2sd x, r64`: a signed integer to a real.
export procedure cvtsi2sd(a: ref Assembler, x, r: Integer)
    sse(a, $F2, $2A, x, rm: r, w: true)

## `cvttsd2si r64, x`: a real to a signed integer, truncating; the integer
## $8000000000000000 if it doesn't fit.
export procedure cvttsd2si(a: ref Assembler, r, x: Integer)
    sse(a, $F2, $2C, r, rm: x, w: true)

## The number of a condition code, for jcc: `jcc(a, "e", l)` jumps if equal.
function cc(name: String): Integer
    let names := [
        "o",
        "no",
        "b",
        "ae",
        "e",
        "ne",
        "be",
        "a",
        "s",
        "ns",
        "p",
        "np",
        "l",
        "ge",
        "le",
        "g",
    ]
    let i := indexOf(names, name)
    assert i >= 0, "unknown condition"
    return i

## Sets the low byte of `r` to 1 if the condition holds, else 0.
export procedure setcc(a: ref Assembler, c: String, r: Integer)
    if r >= 4 then
        emit(a, [rex(false, 0, rm: r)])
    emit(a, [$0F, $90 + cc(c), $C0 + low(r)])

## `movzx dst32, src8`.
export procedure movzx8(a: ref Assembler, dst, src: Integer)
    let x := rex(false, dst, rm: src)
    if x <> $40 or src >= 4 then
        emit(a, [x])
    emit(a, [$0F, $B6, modrm(dst, rm: src)])

## `xor r32, imm8` (flips Booleans).
export procedure xorImm32(a: ref Assembler, dst: Integer, value: Integer)
    if dst >= 8 then
        emit(a, [$41])
    emit(a, [$83, $F0 + low(dst), value])

## A 32-bit ALU op with an imm32 (no sign extension into the upper half).
procedure alu32Imm(a: ref Assembler, ext: Integer, dst: Integer, value: Integer)
    if dst >= 8 then
        emit(a, [$41])
    emit(a, [$81, modrm(ext, rm: dst)])
    putLE(var a.code, value, n: 4)

export procedure or32Imm(a: ref Assembler, dst: Integer, value: Integer)
    alu32Imm(a, 1, dst: dst, value: value)

export procedure and32Imm(a: ref Assembler, dst: Integer, value: Integer)
    alu32Imm(a, 4, dst: dst, value: value)

export procedure shrImm(a: ref Assembler, dst: Integer, n: Integer)
    emit(a, [rex(true, 0, rm: dst), $C1, $E8 + low(dst), n])

export procedure shlImm(a: ref Assembler, dst: Integer, n: Integer)
    emit(a, [rex(true, 0, rm: dst), $C1, $E0 + low(dst), n])

## `sub dst, imm32` with the immediate patched later; returns its position.
export function subImm32Fixed(a: ref Assembler, dst: Integer): Integer
    emit(a, [rex(true, 0, rm: dst), $81, $E8 + low(dst)])
    let pos := len(a.code)
    putLE(var a.code, 0, n: 4)
    return pos

export procedure patch32(a: ref Assembler, pos: Integer, value: Integer)
    setLE(var a.code, pos, value, n: 4)

export procedure leave(a: ref Assembler)
    emit(a, [$C9])

## `xor r32, r32`: the short way to zero a register.
export procedure xor32(a: ref Assembler, dst, src: Integer)
    rr(a, $31, dst, src, w: false)

procedure aluImm(a: ref Assembler, ext: Integer, dst: Integer, value: Integer)
    assert fits32(value), "immediate out of range"
    let x := rex(true, 0, rm: dst)
    if value >= -128 and value < 128 then
        emit(a, [x, $83, modrm(ext, rm: dst), value])
    else
        emit(a, [x, $81, modrm(ext, rm: dst)])
        putLE(var a.code, value, n: 4)

export procedure addImm(a: ref Assembler, dst: Integer, value: Integer)
    aluImm(a, 0, dst: dst, value: value)
    if dst = Rsp and a.tracked then  # drops pushed words
        var n := value div 8
        while n > 0 and len(a.stack) > 0 do
            removeLast(var a.stack)
            n := n - 1

export procedure subImm(a: ref Assembler, dst: Integer, value: Integer)
    aluImm(a, 5, dst: dst, value: value)

export procedure cmpImm(a: ref Assembler, dst: Integer, value: Integer)
    aluImm(a, 7, dst: dst, value: value)

export procedure andImm(a: ref Assembler, dst: Integer, value: Integer)
    aluImm(a, 4, dst: dst, value: value)

export procedure push(a: ref Assembler, r: Integer)
    if r >= 8 then
        emit(a, [$41])
    emit(a, [$50 + low(r)])
    if a.tracked then
        add(var a.stack, false)

export procedure pop(a: ref Assembler, r: Integer)
    if r >= 8 then
        emit(a, [$41])
    emit(a, [$58 + low(r)])
    if a.tracked then
        removeLast(var a.stack)

export procedure call(a: ref Assembler, label: String)
    emit(a, [$E8])
    rel32(a, label)

## `call r`.
export procedure callReg(a: ref Assembler, r: Integer)
    if r >= 8 then
        emit(a, [$41])
    emit(a, [$FF, $D0 + low(r)])

## `call [rip + GOT slot]` for an imported C function.
export procedure callImport(a: ref Assembler, name: String)
    if indexOf(a.imports, name) < 0 then
        add(var a.imports, name)
    emit(a, [$FF, $15])
    rel32(a, name, kind: "got")

export procedure jmp(a: ref Assembler, label: String)
    emit(a, [$E9])
    rel32(a, label)

export procedure jcc(a: ref Assembler, c: String, label: String)
    emit(a, [$0F, $80 + cc(c)])
    rel32(a, label)

export procedure ret(a: ref Assembler)
    emit(a, [$C3])
