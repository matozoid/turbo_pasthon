unit Query

## One-shot semantic queries for scripts and agents (SPEC §15.5): `pst query`. Each query
## checks the file it is about and answers from its symbol index, like the language
## server, with positions as SPEC §15.1 gives them and paths relative to the current
## directory.

uses IO, OS, Strings, Source, Symbols, Types, Typecheck, Paths, Json, Lsp, Explain

const
    Schema = "pst-query/1"

## A position on the command line, `File.pst:12:5`: the absolute path, line and column.
export function parsePosition(text: String): Result[Pair[String, List[Integer]], String]
    let parts := split(text, sep: ":")
    let n := len(parts)
    if n < 3 then
        return Err("expected FILE:LINE:COL, got '{text}'")
    var nums: List[Integer] := []
    for part in [parts[n - 2], parts[n - 1]] do
        case parseInt(part) of
            Ok(v):
                if v.value < 1 then
                    return Err("line and column start at 1, got '{text}'")
                add(var nums, v.value)
            Err(_):
                return Err("expected FILE:LINE:COL, got '{text}'")
    var file := parts[0]
    for i := 1 to n - 3 do
        file := "{file}:{parts[i]}"
    return Ok(Pair(first: absolute(file), second: nums))

## `path`, or the `.pst` files in it if it's a directory, sorted.
export function pstFiles(path: String): Result[List[String], String]
    if not isDir(path) then
        return Ok([path])
    case listDir(path) of
        Ok(names):
            var sorted := names.value
            sort(var sorted)
            var files: List[String] := []
            for name in sorted do
                if endsWith(name, suffix: ".pst") then
                    add(var files, Paths.normalize(join(path, b: name)))
            return Ok(files)
        Err(e):
            return Err(e.error)

## A server with the files as its open documents, read from disk.
export function serverFor(stdDir: String, files: List[String]): Result[Server, String]
    var s := Server(stdDir: stdDir, texts: {}, uris: {}, down: false)
    for file in files do
        case readFile(file) of
            Ok(text):
                s.texts[file] := text.value
            Err(e):
                return Err(e.error)
    return Ok(s)

export function readFile(path: String): Result[String, String]
    if not isFile(path) then
        return Err("can't read '{shown(path)}'")
    case open(path) of
        Ok(f):
            let text := readAll(f.value)
            _ := close(f.value)
            return text
        Err(e):
            return Err(e.error)

## `path` relative to the current directory if it is inside it, else as it is.
export function shown(path: String): String
    let dir := "{currentDir()}/"
    if startsWith(path, prefix: dir) then
        return slice(path, byteLen(dir), byteLen(path))
    return path

export function location(file: String, span: Span): String
    let where := "\"file\":{quote(shown(file))},\"line\":{span.line},\"col\":{span.col}"
    return "\{{where},\"endLine\":{span.endLine},\"endCol\":{span.endCol}}"

## A symbol as hover and the symbol list show it: its name, kind, the type or routine it
## belongs to, its type (of a value), its declaration in short, its documentation and
## where it is defined.
function symbolInfo(a: Analysis, sym: ref Symbol): String
    var out := "\{\"name\":{quote(sym.name)},\"kind\":{quote(name(sym.kind))}"
    case a.checked.env of
        Some(env):
            case get(env.value.owner, sym.id) of
                Some(o):
                    out := "{out},\"container\":{quote(o.value.name)}"
                None:
                    pass
            if not isRoutine(sym.kind) then
                case typeOfSym(env.value, sym) of
                    Some(t):
                        out := "{out},\"type\":{quote(show(t.value))}"
                    None:
                        pass
        None:
            pass
    out := "{out},\"declaration\":{quote(headOf(a, sym))}"
    case docOf(sym) of
        Some(d):
            out := "{out},\"doc\":{quote(d.value)}"
        None:
            pass
    if sym.span.isSome() and sym.file <> "" then
        out := "{out},\"location\":{location(sym.file, sym.span.get())}"
    return "{out}}"

function answer(key: String, items: List[String]): String
    return "\{\"schema\":{quote(Schema)},{quote(key)}:[{join(items, sep: ",")}]}"

## A symbol in short, where it is defined: its name, kind and location.
function brief(sym: ref Symbol): String
    var out := "\{\"name\":{quote(sym.name)},\"kind\":{quote(name(sym.kind))}"
    if sym.span.isSome() and sym.file <> "" then
        out := "{out},\"location\":{location(sym.file, sym.span.get())}"
    return "{out}}"

## Calls grouped by routine: `key` names the routine (`caller` or `callee`), or the unit
## level by its file.
function callsOf(key: String, groups: List[Calls]): List[String]
    var items: List[String] := []
    for c in groups do
        var who := "\"file\":{quote(shown(c.file))}"
        if c.sym.isSome() then
            who := "{quote(key)}:{brief(c.sym.get())}"
        var at: List[String] := []
        for sp in c.spans do
            add(var at, location(c.file, sp))
        add(var items, "\{{who},\"calls\":[{join(at, sep: ",")}]}")
    return items

## Whether a symbol of kind `k` can be found by name: what `symbols` lists, and units.
function named(k: Kind): Boolean
    return k in [
        Kind.UnitSym,
        Kind.TypeSym,
        Kind.TraitSym,
        Kind.ConstSym,
        Kind.FieldSym,
        Kind.EnumMember,
    ] or isRoutine(k)

## The position of the definition that `name` means, `name`, `Unit.name` or `Type.name`,
## searched in the `.pst` files of the current directory and the units they use.
export function findName(name: String, stdDir: String): Result[String, String]
    let parts := split(name, sep: ".")
    if len(parts) > 2 then
        return Err("expected NAME, Unit.NAME or Type.NAME, got '{name}'")
    let last := parts[len(parts) - 1]
    var qualifier := ""
    if len(parts) = 2 then
        qualifier := parts[0]
    var paths: List[String] := []
    case pstFiles(".") of
        Ok(f):
            for x in f.value do
                add(var paths, absolute(x))
        Err(e):
            return Err(e.error)
    var s := Server(stdDir: stdDir, texts: {}, uris: {}, down: false)
    case serverFor(stdDir, paths) of
        Ok(made):
            s := made.value
        Err(e):
            return Err(e.error)
    var found: List[String] := []
    var shownAs: List[String] := []
    var seen: Map[String, Boolean] := {}
    var covered: Map[String, Boolean] := {}
    for path in paths do
        if path in covered then
            continue
        let a := analyze(s, path)
        var unitOf: Map[String, String] := {}
        for u in a.checked.resolved.units do
            unitOf[u.path] := u.name
            covered[u.path] := true
        for r in a.checked.resolved.checker.index.refs do
            if not r.isDef or len(r.targets) <> 1 then
                continue
            let sym := r.targets[0]
            if sym.name <> last or sym.file <> r.file or not named(sym.kind) then
                continue
            var outer := get(unitOf, r.file).getOr("")
            if a.checked.env.isSome() then
                case get(a.checked.env.get().owner, sym.id) of
                    Some(o):
                        outer := o.value.name
                    None:
                        pass
            if qualifier <> "" and qualifier <> outer then
                continue
            let at := "{r.file}:{r.span.line}:{r.span.col}"
            if not (at in seen) then
                seen[at] := true
                add(var found, at)
                add(var shownAs, "{outer}.{last} ({shown(r.file)}:{r.span.line}:{r.span.col})")
    if len(found) = 0 then
        return Err("no symbol named '{name}' in the current directory or the units it uses")
    if len(found) > 1 then
        return Err("'{name}' is ambiguous: {join(shownAs, sep: ", ")}")
    return Ok(found[0])

## The file, line and column of `position`: `file:line:col`, or a symbol's name.
export function locate(position: String, stdDir: String): Result[Pair[String, List[Integer]], String]
    if len(split(position, sep: ":")) = 1 then
        case findName(position, stdDir: stdDir) of
            Ok(at):
                return parsePosition(at.value)
            Err(e):
                return Err(e.error)
    return parsePosition(position)

## `file` and the other `.pst` files of its directory, where references are searched.
export function neighbours(file: String): Result[List[String], String]
    case pstFiles(dirname(file)) of
        Ok(f):
            var files: List[String] := []
            for x in f.value do
                add(var files, absolute(x))
            if not (file in files) then
                add(var files, file)
            return Ok(files)
        Err(e):
            return Err(e.error)

## The answer to `def`, `refs`, `type`, `hover`, `complete`, `impls`, `callers` or
## `callees` at a position, or an error.
export function queryAt(request: String, position: String, stdDir: String): Result[String, String]
    var file := ""
    var line := 0
    var col := 0
    var at: Result[Pair[String, List[Integer]], String] := parsePosition(position)
    if request <> "complete" then
        at := locate(position, stdDir: stdDir)
    case at of
        Ok(p):
            file := p.value.first
            line := p.value.second[0]
            col := p.value.second[1]
        Err(e):
            return Err(e.error)
    ## References, implementations and callers are searched in every file of the directory,
    ## and the units they use.
    var files := [file]
    if request in ["refs", "impls", "callers", "instances"] then
        case neighbours(file) of
            Ok(f):
                files := f.value
            Err(e):
                return Err(e.error)
    var s := Server(stdDir: stdDir, texts: {}, uris: {}, down: false)
    case serverFor(stdDir, files) of
        Ok(made):
            s := made.value
        Err(e):
            return Err(e.error)
    if request = "complete" then
        var items: List[String] := []
        for c in completionsAt(s, file, line, col: col) do
            var item := "\{\"label\":{quote(c.label)},\"kind\":{quote(c.kind)}"
            if c.detail <> "" then
                item := "{item},\"detail\":{quote(c.detail)}"
            add(var items, "{item}}")
        return Ok(answer("items", items))
    let a := analyze(s, file)
    let found := refAtLine(a, file, line, col: col)
    var targets: List[ref Symbol] := []
    case found of
        Some(r):
            targets := r.value.targets
        None:
            pass
    var items: List[String] := []
    if request = "def" then
        for sym in targets do
            if sym.span.isSome() and sym.file <> "" then
                add(var items, location(sym.file, sym.span.get()))
        return Ok(answer("locations", items))
    if request = "refs" then
        let o := occurrencesOf(s, a, found: found)
        for r in o.refs do
            let where := location(r.file, r.span)
            add(var items, "{slice(where, 0, byteLen(where) - 1)},\"isDef\":{r.isDef}}")
        return Ok(answer("locations", items))
    if request = "impls" then
        if len(targets) > 0 then
            let places := implementationsOf(s, a, sym: targets[0])
            for sym in places.syms do
                add(var items, brief(sym))
        return Ok(answer("symbols", items))
    if request = "callers" or request = "callees" then
        for sym in targets do
            if isCallable(a, sym) then
                if request = "callers" then
                    return Ok(answer("callers", callsOf(
                        "caller",
                        groups: callersOf(s, target: sym),
                    )))
                return Ok(answer("callees", callsOf("callee", groups: calleesOf(a, caller: sym))))
        return Ok(answer(request, items))
    if request = "instances" then
        if len(targets) > 0 then
            var slot: Map[String, Integer] := {}
            var names: List[String] := []
            var args: List[List[String]] := []
            var places: List[List[String]] := []
            for i in instancesOf(s, target: targets[0]) do
                var shownArgs: List[String] := []
                for t in i.args do
                    add(var shownArgs, show(t))
                let key := join(shownArgs, sep: ", ")
                if not (key in slot) then
                    slot[key] := len(names)
                    add(var names, "{i.sym.name}[{key}]")
                    add(var args, shownArgs)
                    add(var places, [])
                add(var places[slot[key]], location(i.file, i.span))
            for k := 0 to len(names) - 1 do
                var quoted: List[String] := []
                for x in args[k] do
                    add(var quoted, quote(x))
                let head := "\"instance\":{quote(names[k])},\"args\":[{join(quoted, sep: ",")}]"
                add(var items, "\{{head},\"locations\":[{join(places[k], sep: ",")}]}")
        return Ok(answer("instances", items))
    if request = "hover" then
        for sym in targets do
            add(var items, symbolInfo(a, sym))
        return Ok(answer("symbols", items))
    if a.checked.env.isNone() then
        return Ok(answer(if request = "accepts" then "symbols" else "types", items))
    let env := a.checked.env.get()
    if request = "accepts" then
        var seen: Map[Integer, Boolean] := {}
        for sym in targets do
            case valueTypeOf(env, sym) of
                Some(t):
                    for f in acceptorsOf(a, file, ty: t.value) do
                        if not (f.id in seen) then
                            seen[f.id] := true
                            let b := brief(f)
                            let head := quote(headOf(a, f))
                            add(var items, "{slice(b, 0, byteLen(b) - 1)},\"declaration\":{head}}")
                None:
                    pass
        return Ok(answer("symbols", items))
    for sym in targets do
        case typeOfSym(env, sym) of
            Some(t):
                var syms: List[ref Symbol] := []
                typeSyms(t.value, var syms)
                var decls: List[String] := []
                var seen: Map[Integer, Boolean] := {}
                for d in syms do
                    if d.span.isSome() and d.file <> "" and not (d.id in seen) then
                        seen[d.id] := true
                        add(var decls, location(d.file, d.span.get()))
                let declared := "\"declarations\":[{join(decls, sep: ",")}]"
                add(var items, "\{\"type\":{quote(show(t.value))},{declared}}")
            None:
                pass
    return Ok(answer("types", items))

## What an error or panic code means (SPEC §16), and the section that lists it.
export function queryExplain(code: String): Result[String, String]
    case explain(code) of
        Some(e):
            let where := "\"section\":{quote(e.value.section)},\"title\":{quote(e.value.title)}"
            let item := "\{\"code\":{quote(code)},\"meaning\":{quote(e.value.meaning)},{where}}"
            return Ok(answer("explanations", [item]))
        None:
            return Err("unknown code '{code}'")

## The types, constants, routines, fields and enum members declared in `files`, whose
## names match `query` (SPEC §15.4's workspace symbols) if it isn't empty.
export function querySymbols(
    files: List[String],
    stdDir: String,
    query: String := "",
): Result[String, String]
    var paths: List[String] := []
    var wantFile: Map[String, Boolean] := {}
    for f in files do
        add(var paths, absolute(f))
        wantFile[absolute(f)] := true
    var s := Server(stdDir: stdDir, texts: {}, uris: {}, down: false)
    case serverFor(stdDir, paths) of
        Ok(made):
            s := made.value
        Err(e):
            return Err(e.error)
    var items: List[String] := []
    var seen: Map[String, Boolean] := {}
    for path in paths do
        let a := analyze(s, path)
        for r in a.checked.resolved.checker.index.refs do
            if not r.isDef or len(r.targets) <> 1 or not (r.file in wantFile) then
                continue
            let sym := r.targets[0]
            var wanted := sym.kind in [
                Kind.TypeSym,
                Kind.TraitSym,
                Kind.ConstSym,
                Kind.FieldSym,
                Kind.EnumMember,
            ] or isRoutine(sym.kind)
            wanted := wanted and (query = "" or matches(sym.name, query: query))
            let key := "{r.file}:{r.span.start}"
            if wanted and sym.file = r.file and not (key in seen) then
                seen[key] := true
                add(var items, symbolInfo(a, sym))
    return Ok(answer("symbols", items))

## The key that names `sym` across checks: where it is defined, or its name and kind for a
## built-in.
function symbolKey(sym: ref Symbol): String
    if sym.span.isSome() and sym.file <> "" then
        return "{sym.file}:{sym.span.get().start}"
    return ":{sym.name}:{name(sym.kind)}"

## The symbol index of `files` (SPEC §15.5): every symbol defined or used in them, with an
## `"id"`, and every name in them, with the `"symbol"` it means.
export function queryIndex(files: List[String], stdDir: String): Result[String, String]
    var paths: List[String] := []
    var wantFile: Map[String, Boolean] := {}
    for f in files do
        add(var paths, absolute(f))
        wantFile[absolute(f)] := true
    var s := Server(stdDir: stdDir, texts: {}, uris: {}, down: false)
    case serverFor(stdDir, paths) of
        Ok(made):
            s := made.value
        Err(e):
            return Err(e.error)
    var symbols: List[String] := []
    var ids: Map[String, Integer] := {}
    var refs: List[String] := []
    var seen: Map[String, Boolean] := {}
    ## A file's names are taken from the first check that covers it.
    var covered: Map[String, Boolean] := {}
    for path in paths do
        if path in covered then
            continue
        let a := analyze(s, path)
        var here: Map[String, Boolean] := {}
        for r in a.checked.resolved.checker.index.refs do
            if r.file in covered or not (r.file in wantFile) then
                continue
            here[r.file] := true
            for sym in r.targets do
                let key := symbolKey(sym)
                if not (key in ids) then
                    ids[key] := len(symbols)
                    let info := symbolInfo(a, sym)
                    add(var symbols, "\{\"id\":{len(symbols)},{slice(info, 1, byteLen(info))}")
                let at := "{r.file}:{r.span.start}:{ids[key]}"
                if at in seen then
                    continue
                seen[at] := true
                let where := location(r.file, r.span)
                let tail := "\"symbol\":{ids[key]},\"isDef\":{r.isDef}}"
                add(var refs, "{slice(where, 0, byteLen(where) - 1)},{tail}")
        covered[path] := true
        for f, _ in here do
            covered[f] := true
    let listed := "\"symbols\":[{join(symbols, sep: ",")}]"
    return Ok("\{\"schema\":{quote(Schema)},{listed},\"references\":[{join(refs, sep: ",")}]}")
