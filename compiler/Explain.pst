unit Explain

## The error and panic codes of SPEC §2.9, §12 and §16, for `pst explain`: what each
## means, and the section that lists it. Keep in step with the SPEC's tables; the case
## explain.spec checks that with ExplainCheck.

type
    export Explanation = record
        export code: String
        export section: String
        export title: String
        export meaning: String

## Every code, in the order the SPEC lists them.
export function explanations(): List[Explanation]
    return [
        Explanation(
            code: "E0000",
            section: "2.9",
            title: "Lexical errors",
            meaning: "source file is not valid UTF-8",
        ),
        Explanation(
            code: "E0001",
            section: "2.9",
            title: "Lexical errors",
            meaning: "tab character outside a string (fix: replace with 4 spaces)",
        ),
        Explanation(
            code: "E0002",
            section: "2.9",
            title: "Lexical errors",
            meaning: "indentation not a multiple of 4",
        ),
        Explanation(
            code: "E0003",
            section: "2.9",
            title: "Lexical errors",
            meaning: "indentation increases by more than one level",
        ),
        Explanation(
            code: "E0004",
            section: "2.9",
            title: "Lexical errors",
            meaning: "unterminated string literal",
        ),
        Explanation(
            code: "E0005",
            section: "2.9",
            title: "Lexical errors",
            meaning: "invalid escape sequence",
        ),
        Explanation(
            code: "E0006",
            section: "2.9",
            title: "Lexical errors",
            meaning: "unexpected character (including non-ASCII outside strings and comments)",
        ),
        Explanation(
            code: "E0007",
            section: "2.9",
            title: "Lexical errors",
            meaning: "malformed number literal, or integer above 2^64 - 1",
        ),
        Explanation(
            code: "E0008",
            section: "2.9",
            title: "Lexical errors",
            meaning: "invalid char literal",
        ),
        Explanation(
            code: "E0009",
            section: "2.9",
            title: "Lexical errors",
            meaning: "unmatched or unclosed bracket",
        ),
        Explanation(
            code: "E0030",
            section: "2.9",
            title: "Lexical errors",
            meaning: "unclosed or empty string placeholder (fix: `\\\{`)",
        ),
        Explanation(
            code: "P0001",
            section: "12",
            title: "Errors and panics",
            meaning: "index out of bounds",
        ),
        Explanation(
            code: "P0002",
            section: "12",
