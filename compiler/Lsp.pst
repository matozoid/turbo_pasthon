unit Lsp

## The language server (SPEC §15.4): JSON-RPC over standard input and output, LSP 3.17.
## Documents are synchronized whole. After every change, each open document is checked
## with the open documents' texts in place of their files, and its diagnostics pushed.
## Requests about a position check the document again, and answer from its symbol index.

uses IO, OS, Strings, Source, Tokens, Lexer, Diagnostics, Ast, Symbols, Resolve, Types, Typecheck, Fmt, Json

type
    export Server = record
        export stdDir: String
        ## The open documents' texts and URIs, by path.
        export texts: Map[String, String]
        export uris: Map[String, String]
        ## Whether `shutdown` came; `exit` then ends with status 0.
        export down: Boolean

    ## A check of one open document, with the decoded texts of the units it loaded.
    export Analysis = record
        export checked: Checked
        export texts: Map[String, Text]

    ## The definition and uses of a symbol, and the decoded texts of their files.
    export Occurrences = record
        export sym: Option[ref Symbol]
        ## The symbol is in a standard unit.
        export std: Boolean
        export refs: List[Ref]
        export texts: Map[String, Text]
        ## The errors in the open documents.
        export errors: Integer

    ## A completion item: a name, or a keyword (`kind` "keyword", no `detail`).
    export Candidate = record
        export label: String
        ## The symbol kind's name, or "keyword".
        export kind: String
        lspKind: Integer
        ## The hover's first line.
        export detail: String
        sortText: String

    ## The completion items found so far, for names starting with `prefix`.
    Completions = record
        prefix: String
        seen: Map[String, Boolean]
        items: List[Candidate]

    ## Symbols found across checks, with the decoded texts of their files.
    export Places = record
        export syms: List[ref Symbol]
        export texts: Map[String, Text]

    ## Calls between routines: the calls in (or of) `sym`, or in the unit level of `file`
    ## when `sym` is None, at `spans`, found by the check `analysis`.
    export Calls = record
        export sym: Option[ref Symbol]
        export file: String
        export spans: List[Span]
        export analysis: Analysis

    ## A token to color (semantic tokens).
    Semantic = record
        start: Integer
        span: Span
        kind: Integer
        mods: Integer

    ## A call around a position (signature help).
    CallSite = record
        callee: Token
        ## The argument's position, counting the receiver of `a.f(...)`.
        index: Integer
        ## The argument's name, if it is named.
        named: String

# ------------------------------------------------------------------------- messages

## The next message's body, or `None` at the end of the input. Headers other than
## Content-Length are ignored.
function receive(): Option[String]
    var length := -1
    while true do
        case readln() of
            Some(l):
                let line := trim(l.value)
                if line = "" then
                    if length >= 0 then
                        return read(length)
                else if startsWith(line, prefix: "Content-Length:") then
                    let n := slice(line, byteLen("Content-Length:"), byteLen(line))
                    length := parseInt(trim(n)).getOr(-1)
            None:
                return None
    return None

procedure send(body: String)
    write("Content-Length: {byteLen(body)}\r\n\r\n{body}")

procedure respond(id: JValue, result: String)
    send("\{\"jsonrpc\":\"2.0\",\"id\":{toText(id)},\"result\":{result}}")

procedure respondError(id: JValue, code: Integer, message: String)
    send(
        "\{\"jsonrpc\":\"2.0\",\"id\":{toText(id)},\"error\":\{\"code\":{code},\"message\":{quote(message)}}}",
    )

procedure notify(method: String, params: String)
    send("\{\"jsonrpc\":\"2.0\",\"method\":{quote(method)},\"params\":{params}}")

# ------------------------------------------------------------------------- URIs and positions

function hexValue(c: Char): Integer
    if c >= '0' and c <= '9' then
        return ord(c) - ord('0')
    if c >= 'a' and c <= 'f' then
        return ord(c) - ord('a') + 10
    if c >= 'A' and c <= 'F' then
        return ord(c) - ord('A') + 10
    return -1

## The path of a `file:` URI, with `%XX` escapes decoded.
function pathOf(uri: String): String
    var s := uri
    if startsWith(s, prefix: "file://") then
        s := slice(s, byteLen("file://"), byteLen(s))
    let b := bytes(s)
    var out: List[Byte] := []
    var i := 0
    while i < len(b) do
        if b[i] = 37 and i + 2 < len(b) then  # '%'
            let high := hexValue(Char(Integer(b[i + 1])))
            let low := hexValue(Char(Integer(b[i + 2])))
            if high >= 0 and low >= 0 then
                add(var out, Byte(high * 16 + low))
                i := i + 3
                continue
        add(var out, b[i])
        i := i + 1
    return fromBytes(out)

## The 0-based UTF-16 offset of the 1-based column `col` (in code points) on the 1-based
## line `line`.
function utf16(t: Text, line: Integer, col: Integer): Integer
    if line - 1 >= len(t.lineStarts) then
        return 0
    let start := t.lineStarts[line - 1]
    var n := 0
    var i := start
    while i < start + col - 1 and i < len(t.chars) do
        if ord(t.chars[i]) > 0xFFFF then
            n := n + 2
        else
            n := n + 1
        i := i + 1
    return n

## The 1-based column (in code points) of the 0-based UTF-16 offset `character` on the
## 1-based line `line`.
function column(t: Text, line: Integer, character: Integer): Integer
    if line < 1 or line - 1 >= len(t.lineStarts) then
        return 1
    let start := t.lineStarts[line - 1]
    var n := 0
    var i := start
    while n < character and i < len(t.chars) and t.chars[i] <> '\n' do
        if ord(t.chars[i]) > 0xFFFF then
            n := n + 2
        else
            n := n + 1
        i := i + 1
    return i - start + 1

## Whether `c` stands for itself in a URI's path: an ASCII letter or digit, or `/._~-`.
function unescaped(c: Char): Boolean
    return (
        (c >= 'a' and c <= 'z')
        or (c >= 'A' and c <= 'Z')
        or (c >= '0' and c <= '9')
        or c in ['/', '.', '_', '~', '-']
    )

## The `file:` URI of `path`, with the other bytes escaped.
function uriOf(path: String): String
    let hex := "0123456789ABCDEF"
    var out := "file://"
    for b in bytes(path) do
        let c := Char(Integer(b))
        if unescaped(c) then
            out := "{out}{c}"
        else
            let n := Integer(b)
            out := "{out}%{slice(hex, n div 16, n div 16 + 1)}{slice(hex, n mod 16, n mod 16 + 1)}"
    return out

function position(t: Text, line: Integer, col: Integer): String
    return "\{\"line\":{line - 1},\"character\":{utf16(t, line, col: col)}}"

function range(t: Text, s: Span): String
    return "\{\"start\":{position(t, s.line, col: s.col)},\"end\":{position(t, s.endLine, col: s.endCol)}}"

## The range of the whole text.
function wholeRange(t: Text): String
    let last := len(t.lineStarts)
    let col := len(t.chars) - t.lineStarts[last - 1] + 1
    return "\{\"start\":\{\"line\":0,\"character\":0},\"end\":{position(t, last, col: col)}}"

# ------------------------------------------------------------------------- diagnostics

function diagnostic(t: Text, d: Diagnostic): String
    var severity := 1
    if d.severity = Severity.Warning then
        severity := 2
    return "\{\"range\":{range(t, d.span)},\"severity\":{severity},\"code\":{quote(d.code)},\"source\":\"pst\",\"message\":{quote(d.message)}}"

## Checks every open document and pushes its diagnostics.
procedure checkAll(s: Server)
    for path, text in s.texts do
        let checked := typecheck(path, stdDir: s.stdDir, overlay: s.texts)
        let t := textOf(text)
        var parts: List[String] := []
        for d in checked.resolved.checker.diagnostics do
            if d.file = path then
                add(var parts, diagnostic(t, d))
        let uri := quote(s.uris[path])
        notify(
            "textDocument/publishDiagnostics",
            params: "\{\"uri\":{uri},\"diagnostics\":[{join(parts, sep: ",")}]}",
        )

# ------------------------------------------------------------------------- symbols

export function analyze(s: Server, path: String): Analysis
    return analyzeWith(s, path, texts: s.texts)

## A check of `path` with `texts` in place of the files.
function analyzeWith(s: Server, path: String, texts: Map[String, String]): Analysis
    let checked := typecheck(path, stdDir: s.stdDir, overlay: texts)
    var srcs: Map[String, Text] := {}
    for u in checked.resolved.units do
        srcs[u.path] := u.src
    return Analysis(checked: checked, texts: srcs)

## The reference at the request's position: on the name, or just after it.
function refAt(a: Analysis, path: String, params: JValue): Option[Ref]
    case get(a.texts, path) of
        Some(t):
            let pos := field(params, key: "position")
            let line := asInteger(field(pos, key: "line")).getOr(0) + 1
            let col := column(
                t.value,
                line,
                character: asInteger(field(pos, key: "character")).getOr(0),
            )
            return refAtLine(a, path, line, col: col)
        None:
            return None

## The reference at `line` and `col` (in code points): on the name, or just after it.
export function refAtLine(a: Analysis, path: String, line, col: Integer): Option[Ref]
    let ix := a.checked.resolved.checker.index
    let found := at(ix, path, line, col: col)
    if found.isSome() or col = 1 then
        return found
    return at(ix, path, line, col: col - 1)

## The URI of `path`: the client's, if the document is open.
function uriFor(s: Server, path: String): String
    return get(s.uris, path).getOr(uriOf(path))

function location(s: Server, t: Text, file: String, span: Span): String
    return "\{\"uri\":{quote(uriFor(s, file))},\"range\":{range(t, span)}}"

## The first line of a declaration, from `span`, without `export`.
function firstLine(a: Analysis, file: String, span: Span): String
    case get(a.texts, file) of
        Some(t):
            var end := span.start
            while end < len(t.value.chars) and t.value.chars[end] <> '\n' do
                end := end + 1
            let line := trim(sub(t.value, span.start, end: end))
            if startsWith(line, prefix: "export ") then
                return slice(line, byteLen("export "), byteLen(line))
            return line
        None:
            return ""

## A symbol's declaration, in short.
export function headOf(a: Analysis, sym: ref Symbol): String
    var kind := name(sym.kind)
    if sym.kind = Kind.UnitSym then
        for u in a.checked.resolved.units do
            if u.path = sym.file then
                kind := u.parsed.file.kind
    var head := "{kind} {sym.name}"
    case sym.node of
        Routine(r):
            head := sub(a.texts[sym.file], r.sig.span.start, end: r.sig.span.end)
        ExternDecl(e):
            head := sub(a.texts[sym.file], e.sig.span.start, end: e.sig.span.end)
        Signature(g):
            head := sub(a.texts[sym.file], g.span.start, end: g.span.end)
        TypeDecl(d):
            head := "type {firstLine(a, sym.file, d.span)}"
        ConstDecl(d):
            head := "const {firstLine(a, sym.file, d.span)}"
        FieldDecl(d):
            head := "field {firstLine(a, sym.file, d.span)}"
        else:
            case a.checked.env of
                Some(env):
                    case get(env.value.symTypes, sym.id) of
                        Some(t):
                            head := "{kind} {sym.name}: {show(t.value)}"
                        None:
                            pass
                    case get(env.value.owner, sym.id) of
                        Some(o):
                            head := "{kind} {o.value.name}.{sym.name}"
                        None:
                            pass
                None:
                    pass
    return head

## How hover shows a symbol: its declaration, then its documentation.
function hoverText(a: Analysis, sym: ref Symbol): String
    var text := "```pst\n{headOf(a, sym)}\n```"
    case docOf(sym) of
        Some(d):
            text := "{text}\n\n{d.value}"
        None:
            pass
    return text

function hover(s: Server, path: String, params: JValue): String
    let a := analyze(s, path)
    case refAt(a, path, params: params) of
        Some(r):
            if len(r.value.targets) = 0 then
                return "null"
            let t := a.texts[path]
            let contents := "\{\"kind\":\"markdown\",\"value\":{quote(hoverText(a, r.value.targets[0]))}}"
            return "\{\"contents\":{contents},\"range\":{range(t, r.value.span)}}"
        None:
            return "null"

## Where the symbols at the position are defined: several for an overloaded name.
function definition(s: Server, path: String, params: JValue): String
    let a := analyze(s, path)
    var parts: List[String] := []
    case refAt(a, path, params: params) of
        Some(r):
            for sym in r.value.targets do
                if sym.span.isSome() and sym.file in a.texts then
                    add(var parts, location(
                        s,
                        a.texts[sym.file],
                        file: sym.file,
                        span: sym.span.get(),
                    ))
        None:
            pass
    return "[{join(parts, sep: ",")}]"

## The type of a value the symbol names: a local's, a constant's, a field's, an enum
## member's, or what a function returns.
export function typeOfSym(env: ref Env, sym: ref Symbol): Option[Type]
    if isLocal(sym.kind) then
        return get(env.symTypes, sym.id)
    if sym.kind = Kind.ConstSym then
        return Some(constType(env, sym))
    if isRoutine(sym.kind) then
        return Some(sig(env, sym).result)
    case get(env.owner, sym.id) of
        Some(o):
            if sym.kind = Kind.EnumMember then
                return Some(named(o.value, []))
            if sym.kind = Kind.FieldSym then
                for f in decl(env, o.value).fields do
                    if f.name = sym.name then
                        return Some(f.ty)
        None:
            pass
    return None

## The declared types a type is made of: `ref Item` and `List[Item]` lead to `Item`.
export procedure typeSyms(t: Type, var out: List[ref Symbol])
    case t of
        NamedT(n):
            add(var out, n.sym)
            for x in n.args do
                typeSyms(x, var out)
        BuiltinT(b):
            for x in b.args do
                typeSyms(x, var out)
        RefT(r):
            typeSyms(r.target, var out)
        ParamT(p):
            add(var out, p.sym)
        TypeValueT(v):
            typeSyms(v.inner, var out)
        else:
            pass

function typeDefinition(s: Server, path: String, params: JValue): String
    let a := analyze(s, path)
    var parts: List[String] := []
    if a.checked.env.isNone() then
        return "[]"
    let env := a.checked.env.get()
    case refAt(a, path, params: params) of
        Some(r):
            var syms: List[ref Symbol] := []
            for sym in r.value.targets do
                case typeOfSym(env, sym) of
                    Some(t):
                        typeSyms(t.value, var syms)
                    None:
                        pass
            var seen: Map[Integer, Boolean] := {}
            for sym in syms do
                if sym.span.isSome() and sym.file in a.texts and not (sym.id in seen) then
                    seen[sym.id] := true
                    add(var parts, location(
                        s,
                        a.texts[sym.file],
                        file: sym.file,
                        span: sym.span.get(),
                    ))
        None:
            pass
    return "[{join(parts, sep: ",")}]"

function errorCount(a: Analysis): Integer
    var n := 0
    for d in a.checked.resolved.checker.diagnostics do
        if d.severity = Severity.Error then
            n := n + 1
    return n

## Every definition and use of the symbol at the position, in the open documents and the
## units they use, once each.
function occurrences(s: Server, path: String, params: JValue): Occurrences
    let first := analyze(s, path)
    return occurrencesOf(s, first, found: refAt(first, path, params: params))

## Every definition and use of the symbol `found` refers to, `first` being the analysis
## it was found in.
export function occurrencesOf(s: Server, first: Analysis, found: Option[Ref]): Occurrences
    var o := Occurrences(sym: None, std: false, refs: [], texts: {}, errors: 0)
    case found of
        Some(r):
            if len(r.value.targets) > 0 and r.value.targets[0].span.isSome() then
                o.sym := Some(r.value.targets[0])
        None:
            pass
    if o.sym.isNone() then
        return o
    let target := o.sym.get()
    for u in first.checked.resolved.units do
        if u.path = target.file then
            o.std := u.std
    var seen: Map[String, Boolean] := {}
    for open, _ in s.texts do
        let a := analyze(s, open)
        o.errors := o.errors + errorCount(a)
        if a.checked.env.isNone() then
            continue
        case defSym(a.checked.env.get(), target.file, target.span.get()) of
            Some(sym):
                for r in references(a.checked.resolved.checker.index, sym.value) do
                    let key := "{r.file}:{r.span.start}"
                    if not (key in seen) and r.file in a.texts then
                        seen[key] := true
                        add(var o.refs, r)
                        o.texts[r.file] := a.texts[r.file]
            None:
                pass
    return o

function referencesTo(s: Server, path: String, params: JValue): String
    let context := field(params, key: "context")
    let withDecl := asBoolean(field(context, key: "includeDeclaration")).getOr(true)
    let o := occurrences(s, path, params: params)
    var parts: List[String] := []
    for r in o.refs do
        if withDecl or not r.isDef then
            add(var parts, location(s, o.texts[r.file], file: r.file, span: r.span))
    return "[{join(parts, sep: ",")}]"

## Whether `n` is a name for a symbol of kind `k`: ASCII letters and digits, starting
## with a capital letter for UpperCamel kinds and a small one for lowerCamel ones.
function validName(n: String, k: Kind): Boolean
    var first := true
    for c in n do
        let upper := c >= 'A' and c <= 'Z'
        let lower := c >= 'a' and c <= 'z'
        if first and ((isUpperCamel(k) and not upper) or (isLowerCamel(k) and not lower)) then
            return false
        if not (upper or lower or (c >= '0' and c <= '9')) then
            return false
        first := false
    return not first

## The text of `t` with the names at `refs` replaced by `name`.
function renamed(t: Text, refs: List[Ref], name: String): String
    var ends: Map[Integer, Integer] := {}
    var starts: List[Integer] := []
    for r in refs do
        ends[r.span.start] := r.span.end
        add(var starts, r.span.start)
    sort(var starts)
    var out := ""
    var done := 0
    for start in starts do
        out := "{out}{sub(t, done, end: start)}{name}"
        done := ends[start]
    return "{out}{sub(t, done, end: len(t.chars))}"

## The edits that rename the symbol at the position, or why it can't be renamed: it is
## in a standard unit, the name doesn't suit it, or the open documents would get errors.
function rename(s: Server, path: String, params: JValue): Result[String, String]
    let newName := asString(field(params, key: "newName")).getOr("")
    let o := occurrences(s, path, params: params)
    if o.sym.isNone() then
        return Err("there is nothing to rename here")
    let sym := o.sym.get()
    if o.std then
        return Err("{describe(sym)} is in a standard unit")
    if sym.kind = Kind.UnitSym then
        return Err("units are renamed by renaming their files")
    if not validName(newName, k: sym.kind) then
        return Err("'{newName}' is not a valid name for a {name(sym.kind)}")
    var byFile: Map[String, List[Ref]] := {}
    for r in o.refs do
        var rs := get(byFile, r.file).getOr([])
        add(var rs, r)
        byFile[r.file] := rs
    var texts := s.texts
    var changes: List[String] := []
    for file, refs in byFile do
        let t := o.texts[file]
        texts[file] := renamed(t, refs: refs, name: newName)
        var edits: List[String] := []
        for r in refs do
            add(var edits, "\{\"range\":{range(t, r.span)},\"newText\":{quote(newName)}}")
        add(var changes, "{quote(uriFor(s, file))}:[{join(edits, sep: ",")}]")
    var errors := 0
    for open, _ in s.texts do
        for d in typecheck(open, stdDir: s.stdDir, overlay: texts).resolved.checker.diagnostics do
            if d.severity = Severity.Error then
                errors := errors + 1
    if errors > o.errors then
        return Err("renaming {describe(sym)} to '{newName}' would cause errors")
    return Ok("\{\"changes\":\{{join(changes, sep: ",")}}}")

# ------------------------------------------------------------------------- signature help

## The call whose argument list holds the position: the callee's name token, and which
## argument the position is in, by position (counting a receiver) or by name.
function callAt(tokens: List[Token], offset: Integer): Option[CallSite]
    var opens: List[Integer] := []
    var commas: List[Integer] := []
    var starts: List[Integer] := []
    var k := 0
    while k < len(tokens) and tokens[k].span.start < offset do
        let kind := tokens[k].kind
        if kind in [TokenKind.Lparen, TokenKind.Lbracket, TokenKind.Lbrace] then
            add(var opens, k)
            add(var commas, 0)
            add(var starts, k + 1)
        else if kind in [TokenKind.Rparen, TokenKind.Rbracket, TokenKind.Rbrace] then
            if len(opens) > 0 then
                removeLast(var opens)
                removeLast(var commas)
                removeLast(var starts)
        else if kind = TokenKind.Comma and len(opens) > 0 then
            commas[len(commas) - 1] := commas[len(commas) - 1] + 1
            starts[len(starts) - 1] := k + 1
        k := k + 1
    if len(opens) = 0 then
        return None
    let o := opens[len(opens) - 1]
    if tokens[o].kind <> TokenKind.Lparen or o = 0 or tokens[o - 1].kind <> TokenKind.Ident then
        return None
    var index := commas[len(commas) - 1]
    if o >= 2 and tokens[o - 2].kind = TokenKind.Dot then
        index := index + 1
    var named := ""
    let st := starts[len(starts) - 1]
    if st + 1 < k and tokens[st].kind = TokenKind.Ident and tokens[st + 1].kind = TokenKind.Colon then
        named := tokens[st].text
    return Some(CallSite(callee: tokens[o - 1], index: index, named: named))

## The routines (or record) a callee's name may mean: from the symbol index, or, when the
## call didn't parse, the routines of that name declared in the document's units.
function callees(a: Analysis, path: String, callee: Token): List[ref Symbol]
    let ix := a.checked.resolved.checker.index
    case at(ix, path, callee.span.line, col: callee.span.col) of
        Some(r):
            return r.value.targets
        None:
            pass
    var out: List[ref Symbol] := []
    for u in a.checked.resolved.units do
        for sym in get(u.top, callee.text).getOr([]) do
            if (u.path = path or sym.exported) and (
                isRoutine(sym.kind)
                or sym.kind = Kind.TypeSym
            ) then
                add(var out, sym)
    return out

## The documentation of a declaration, if it has any.
export function docOf(sym: ref Symbol): Option[String]
    case sym.node of
        Routine(r):
            return r.doc
        ExternDecl(e):
            return e.doc
        Signature(g):
            return g.doc
        TypeDecl(d):
            return d.doc
        ConstDecl(d):
            return d.doc
        FieldDecl(d):
            return d.doc
        else:
            return None

## The signature of calling a routine or constructing a record.
function callSig(env: ref Env, sym: ref Symbol): Option[Sig]
    if isRoutine(sym.kind) then
        return Some(sig(env, sym))
    if sym.kind = Kind.TypeSym and decl(env, sym).kind = "record" then
        return Some(recordSig(env, sym))
    return None

## One signature: its label, the offsets of each parameter in it, and its documentation.
function signatureInfo(a: Analysis, env: ref Env, sym: ref Symbol): Option[String]
    let found := callSig(env, sym)
    if found.isNone() then
        return None
    let g := found.get()
    var label := sym.name
    if len(g.tparams) > 0 then
        var names: List[String] := []
        for tp in g.tparams do
            add(var names, tp.name)
        label := "{label}[{join(names, sep: ", ")}]"
    label := "{label}("
    var params: List[String] := []
    for p in g.params do
        if len(params) > 0 then
            label := "{label}, "
        var text := "{p.name}: {show(p.ty)}"
        if p.isVar then
            text := "var {text}"
        if p.varargs then
            text := "..."
        case p.default of
            Some(d):
                if sym.file in a.texts then
                    let sp := exprSpan(d.value)
                    text := "{text} := {sub(a.texts[sym.file], sp.start, end: sp.end)}"
            None:
                pass
        let start := byteLen(label)
        label := "{label}{text}"
        add(var params, "\{\"label\":[{start},{byteLen(label)}]}")
    label := "{label})"
    if g.isFunction then
        label := "{label}: {show(g.result)}"
    var info := "\{\"label\":{quote(label)},\"parameters\":[{join(params, sep: ",")}]"
    case docOf(sym) of
        Some(d):
            info := "{info},\"documentation\":\{\"kind\":\"markdown\",\"value\":{quote(d.value)}}"
        None:
            pass
    return Some("{info}}")

## The parameter an argument goes to: by name, or by position.
function activeParameter(env: ref Env, sym: ref Symbol, call: CallSite): Integer
    if call.named <> "" then
        case callSig(env, sym) of
            Some(g):
                for i := 0 to len(g.value.params) - 1 do
                    if g.value.params[i].name = call.named then
                        return i
            None:
                pass
    return call.index

function signatureHelp(s: Server, path: String, params: JValue): String
    let a := analyze(s, path)
    let t := get(a.texts, path)
    if t.isNone() or a.checked.env.isNone() then
        return "null"
    let text := t.get()
    let env := a.checked.env.get()
    let pos := field(params, key: "position")
    let line := asInteger(field(pos, key: "line")).getOr(0) + 1
    let col := column(text, line, character: asInteger(field(pos, key: "character")).getOr(0))
    if line > len(text.lineStarts) then
        return "null"
    let offset := text.lineStarts[line - 1] + col - 1
    case callAt(lex(text.str, file: path).tokens, offset: offset) of
        Some(call):
            var infos: List[String] := []
            var active := 0
            for sym in callees(a, path, callee: call.value.callee) do
                case signatureInfo(a, env, sym: sym) of
                    Some(info):
                        if len(infos) = 0 then
                            active := activeParameter(env, sym, call: call.value)
                        add(var infos, info.value)
                    None:
                        pass
            if len(infos) = 0 then
                return "null"
            return "\{\"signatures\":[{join(infos, sep: ",")}],\"activeSignature\":0,\"activeParameter\":{active}}"
        None:
            return "null"

# ------------------------------------------------------------------------- completion

## The LSP `CompletionItemKind` of a symbol.
function itemKind(sym: ref Symbol): Integer
    case sym.kind of
        Kind.UnitSym:
            return 9
        Kind.FieldSym:
            return 5
        Kind.ConstSym:
            return 21
        Kind.EnumMember:
            return 20
        Kind.TraitSym, Kind.BuiltinTrait:
            return 8
        Kind.TypeSym, Kind.BuiltinType:
            return 7
        Kind.TypeParamSym:
            return 25
        Kind.FunctionSym, Kind.ProcedureSym:
            return 3
        else:
            return 6

procedure offer(var c: Completions, a: Analysis, sym: ref Symbol, rank: String)
    if not startsWith(sym.name, prefix: c.prefix) or sym.name in c.seen or startsWith(sym.name, prefix: "_") then
        return
    c.seen[sym.name] := true
    add(var c.items, Candidate(
        label: sym.name,
        kind: name(sym.kind),
        lspKind: itemKind(sym),
        detail: headOf(a, sym),
        sortText: "{rank}{sym.name}",
    ))

## The units whose exported names the document sees: those it uses, and System.
function usedUnits(a: Analysis, path: String): List[ref Unit]
    var out: List[ref Unit] := []
    for u in a.checked.resolved.units do
        if u.path = path then
            for w in u.used do
                case get(w) of
                    Some(v):
                        add(var out, v.value)
                    None:
                        pass
    return out

## The routines the document sees: its own, and those its units export.
function visibleRoutines(a: Analysis, path: String): List[ref Symbol]
    var out: List[ref Symbol] := []
    for u in a.checked.resolved.units do
        if u.path = path then
            for _, syms in u.top do
                for sym in syms do
                    if isRoutine(sym.kind) then
                        add(var out, sym)
    for u in usedUnits(a, path) do
        for _, syms in u.top do
            for sym in syms do
                if isRoutine(sym.kind) and sym.exported then
                    add(var out, sym)
    return out

## The routine of this file whose declaration holds `offset`, as a span; None outside any.
function enclosingRoutine(a: Analysis, path: String, offset: Integer): Option[Span]
    for r in a.checked.resolved.checker.index.refs do
        if r.isDef and r.file = path and len(r.targets) = 1 and isRoutine(r.targets[0].kind) then
            let sp := declSpan(r.targets[0])
            if sp.start <= offset and offset <= sp.end then
                return Some(sp)
    return None

## Names after `receiver.`: a unit's exports, an enum's members, or the fields of a value's
## record type and the routines that take it first (UFCS), fields first.
procedure members(var c: Completions, a: Analysis, path: String, receiver: ref Symbol)
    if a.checked.env.isNone() then
        return
    let env := a.checked.env.get()
    if receiver.kind = Kind.UnitSym then
        for u in a.checked.resolved.units do
            if u.name = receiver.name then
                for _, syms in u.top do
                    for sym in syms do
                        if sym.exported then
                            offer(var c, a, sym: sym, rank: "0")
        return
    if receiver.kind = Kind.TypeSym then
        for _, m in receiver.members do
            if m.kind = Kind.EnumMember then
                offer(var c, a, sym: m, rank: "0")
        return
    let t := get(env.symTypes, receiver.id)
    if t.isNone() then
        return
    let ty := t.get()
    case namedSym(ty) of
        Some(owner):
            for _, m in owner.value.members do
                if m.kind = Kind.FieldSym and (m.exported or m.file = path) then
                    offer(var c, a, sym: m, rank: "0")
        None:
            pass
    for sym in visibleRoutines(a, path) do
        let g := sig(env, sym)
        if len(g.params) > 0 then
            var vars: Vars := {}
            for tp in g.tparams do
                vars[tp.id] := true
            var sub: Subst := {}
            if unify(g.params[0].ty, ty, var sub, vars) then
                offer(var c, a, sym: sym, rank: "1")

## Names at the position: the locals declared before it in the same routine (or main
## body), the document's own top-level names, the exports of the units it uses, and
## keywords.
procedure names(var c: Completions, a: Analysis, path: String, offset: Integer)
    let inside := enclosingRoutine(a, path, offset: offset)
    var locals: List[ref Symbol] := []
    for r in a.checked.resolved.checker.index.refs do
        if r.isDef and r.file = path and len(r.targets) = 1 and isLocal(r.targets[0].kind) and r.span.end <= offset then
            let here := enclosingRoutine(a, path, offset: r.span.start)
            let same := (here.isNone() and inside.isNone()) or (
                here.isSome()
                and inside.isSome()
                and here.get().start = inside.get().start
            )
            if same then
                add(var locals, r.targets[0])
    var i := len(locals) - 1
    while i >= 0 do
        offer(var c, a, sym: locals[i], rank: "0")
        i := i - 1
    for u in a.checked.resolved.units do
        if u.path = path then
            for _, syms in u.top do
                for sym in syms do
                    offer(var c, a, sym: sym, rank: "1")
    for u in usedUnits(a, path) do
        offer(var c, a, sym: u.symbol, rank: "1")
        for _, syms in u.top do
            for sym in syms do
                if sym.exported then
                    offer(var c, a, sym: sym, rank: "2")
    for word, _ in keywords() do
        if startsWith(word, prefix: c.prefix) and not (word in c.seen) then
            c.seen[word] := true
            add(var c.items, Candidate(
                label: word,
                kind: "keyword",
                lspKind: 14,
                detail: "",
                sortText: "3{word}",
            ))

function completion(s: Server, path: String, params: JValue): String
    let text := get(s.texts, path)
    if text.isNone() then
        return "[]"
    let t := textOf(text.get())
    let pos := field(params, key: "position")
    let line := asInteger(field(pos, key: "line")).getOr(0) + 1
    if line > len(t.lineStarts) then
        return "[]"
    let col := column(t, line, character: asInteger(field(pos, key: "character")).getOr(0))
    var items: List[String] := []
    for c in completionsAt(s, path, line, col: col) do
        var detail := ""
        if c.detail <> "" then
            detail := ",\"detail\":{quote(c.detail)}"
        let rest := "\"kind\":{c.lspKind}{detail},\"sortText\":{quote(c.sortText)}"
        add(var items, "\{\"label\":{quote(c.label)},{rest}}")
    return "\{\"isIncomplete\":false,\"items\":[{join(items, sep: ",")}]}"

## The completion items at `line` and `col` (in code points) of the open document `path`.
export function completionsAt(s: Server, path: String, line, col: Integer): List[Candidate]
    let text := get(s.texts, path)
    if text.isNone() or line > len(textOf(text.get()).lineStarts) then
        return []
    let t := textOf(text.get())
    let offset := t.lineStarts[line - 1] + col - 1
    if offset > len(t.chars) then
        return []
    # The word being typed, and the `.` before it.
    var start := offset
    while start > 0 and isWordChar(t.chars[start - 1]) do
        start := start - 1
    var c := Completions(prefix: sub(t, start, end: offset), seen: {}, items: [])
    var dot := start
    while dot > 0 and t.chars[dot - 1] = ' ' do
        dot := dot - 1
    if dot > 0 and t.chars[dot - 1] = '.' then
        var end := dot - 1
        while end > 0 and t.chars[end - 1] = ' ' do
            end := end - 1
        var begin := end
        while begin > 0 and isWordChar(t.chars[begin - 1]) do
            begin := begin - 1
        if begin = end then
            return []
        # Check the text without the `.` and the word, which the parser may not take.
        var stop := offset
        while stop < len(t.chars) and isWordChar(t.chars[stop]) do
            stop := stop + 1
        var texts := s.texts
        texts[path] := "{sub(t, 0, end: dot - 1)}{sub(t, stop, end: len(t.chars))}"
        let receiverSpan := span(t, begin, end: end)
        var a := analyzeWith(s, path, texts: texts)
        var r := at(
            a.checked.resolved.checker.index,
            path,
            receiverSpan.line,
            col: receiverSpan.col,
        )
        if r.isNone() then
            # Still no parse: keep only the receiver of the line, as a statement of its own.
            let lineStart := t.lineStarts[receiverSpan.line - 1]
            var lineEnd := lineStart
            while lineEnd < len(t.chars) and t.chars[lineEnd] <> '\n' do
                lineEnd := lineEnd + 1
            var indent := lineStart
            while indent < begin and t.chars[indent] = ' ' do
                indent := indent + 1
            let before := sub(t, 0, end: lineStart)
            let pad := sub(t, lineStart, end: indent)
            texts[path] := "{before}{pad}{sub(t, begin, end: end)}{sub(t, lineEnd, end: len(t.chars))}"
            a := analyzeWith(s, path, texts: texts)
            r := at(
                a.checked.resolved.checker.index,
                path,
                receiverSpan.line,
                col: indent - lineStart + 1,
            )
        case r of
            Some(found):
                if len(found.value.targets) > 0 then
                    members(var c, a, path: path, receiver: found.value.targets[0])
            None:
                pass
    else
        names(var c, analyze(s, path), path: path, offset: offset)
    return c.items

## Whether `c` can be part of a name.
function isWordChar(c: Char): Boolean
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c = '_'

## The whole declaration of a symbol declared in source.
export function declSpan(sym: ref Symbol): Span
    case sym.node of
        Routine(r):
            return r.span
        ExternDecl(e):
            return e.span
        Signature(g):
            return g.span
        TypeDecl(d):
            return d.span
        ConstDecl(d):
            return d.span
        FieldDecl(d):
            return d.span
        else:
            return sym.span.get()

## The LSP `SymbolKind` of a symbol.
function symbolKind(sym: ref Symbol): Integer
    case sym.kind of
        Kind.FieldSym:
            return 8
        Kind.ConstSym:
            return 14
        Kind.EnumMember:
            return 22
        Kind.TraitSym:
            return 11
        Kind.TypeSym:
            case sym.node of
                TypeDecl(d):
                    case d.body of
                        RecordType(_):
                            return 23
                        EnumType(_):
                            return 10
                        else:
                            return 5
                else:
                    return 5
        else:
            case sym.node of
                Signature(_):
                    return 6
                else:
                    return 12

function documentSymbol(t: Text, sym: ref Symbol): String
    var children: List[String] := []
    for _, m in sym.members do
        if m.span.isSome() and m.file = sym.file then
            add(var children, documentSymbol(t, m))
    let ranges := "\"range\":{range(t, declSpan(sym))},\"selectionRange\":{range(t, sym.span.get())}"
    return "\{\"name\":{quote(sym.name)},\"kind\":{symbolKind(sym)},{ranges},\"children\":[{join(children, sep: ",")}]}"

## The types, routines and constants declared in the document, with their members.
function documentSymbols(s: Server, path: String): String
    let a := analyze(s, path)
    let t := get(a.texts, path)
    if t.isNone() then
        return "[]"
    var parts: List[String] := []
    for r in a.checked.resolved.checker.index.refs do
        if not r.isDef or r.file <> path or len(r.targets) <> 1 then
            continue
        let sym := r.targets[0]
        var top := sym.kind in [Kind.TypeSym, Kind.TraitSym, Kind.ConstSym] or isRoutine(sym.kind)
        case sym.node of
            Signature(_):
                top := false
            else:
                pass
        if top and sym.span.isSome() then
            add(var parts, documentSymbol(t.get(), sym))
    return "[{join(parts, sep: ",")}]"

# ------------------------------------------------------------------------- inlay hints

## The inferred types of the `let` and `var` variables and loop variables declared in the
## requested lines without a type, shown after their names.
function inlayHints(s: Server, path: String, params: JValue): String
    let a := analyze(s, path)
    let text := get(a.texts, path)
    if text.isNone() or a.checked.env.isNone() then
        return "[]"
    let t := text.get()
    let env := a.checked.env.get()
    let wanted := field(params, key: "range")
    let first := asInteger(field(field(wanted, key: "start"), key: "line")).getOr(0) + 1
    let last := asInteger(field(
        field(wanted, key: "end"),
        key: "line",
    )).getOr(len(t.lineStarts)) + 1
    var parts: List[String] := []
    for r in a.checked.resolved.checker.index.refs do
        if not r.isDef or r.file <> path or len(r.targets) <> 1 or r.span.line < first or r.span.line > last then
            continue
        let sym := r.targets[0]
        if not (sym.kind in [Kind.LetSym, Kind.VarSym, Kind.LoopVar]) then
            continue
        # A declared type follows the name: `let x: T`.
        var i := r.span.end
        while i < len(t.chars) and t.chars[i] = ' ' do
            i := i + 1
        if i + 1 < len(t.chars) and t.chars[i] = ':' and t.chars[i + 1] <> '=' then
            continue
        case get(env.symTypes, sym.id) of
            Some(ty):
                let shown := show(ty.value)
                if shown <> "<error>" then
                    let at := position(t, r.span.endLine, col: r.span.endCol)
                    add(var parts, "\{\"position\":{at},\"label\":{quote(": {shown}")},\"kind\":1}")
            None:
                pass
    return "[{join(parts, sep: ",")}]"

# ------------------------------------------------------------------------- semantic tokens

## The token types and modifiers of `semanticTokens`, by index in these lists.
function legend(): String
    let types := "[\"namespace\",\"type\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"function\",\"keyword\",\"comment\",\"string\",\"number\"]"
    return "\{\"tokenTypes\":{types},\"tokenModifiers\":[\"declaration\",\"readonly\",\"defaultLibrary\"]}"

## The semantic token type of a name that means `sym` (an index into the legend).
function semType(env: ref Env, sym: ref Symbol): Integer
    case sym.kind of
        Kind.UnitSym:
            return 0
        Kind.TypeSym:
            let k := decl(env, sym).kind
            if k = "enum" then
                return 2
            if k = "record" then
                return 4
            return 1
        Kind.BuiltinType:
            return 1
        Kind.TraitSym, Kind.BuiltinTrait:
            return 3
        Kind.TypeParamSym:
            return 5
        Kind.ParamSym:
            return 6
        Kind.FieldSym:
            return 8
        Kind.EnumMember:
            return 9
        Kind.FunctionSym, Kind.ProcedureSym:
            return 10
        else:
            return 7

function semBefore(a, b: Semantic): Boolean
    return a.start < b.start

## The document's names, by what they mean, and its keywords, literals and comments, as
## LSP's relative encoding: five numbers per token.
function semanticTokens(s: Server, path: String): String
    let a := analyze(s, path)
    let text := get(a.texts, path)
    if text.isNone() or a.checked.env.isNone() then
        return "\{\"data\":[]}"
    let t := text.get()
    let env := a.checked.env.get()
    var std: Map[String, Boolean] := {}
    for u in a.checked.resolved.units do
        if u.std then
            std[u.path] := true
    var refs: Map[Integer, Ref] := {}
    for r in a.checked.resolved.checker.index.refs do
        if r.file = path and len(r.targets) > 0 then
            refs[r.span.start] := r
    let lexed := lex(t.str, file: path)
    var found: List[Semantic] := []
    for tok in lexed.tokens do
        var ty := -1
        var mods := 0
        let k := ord(tok.kind)
        if tok.kind = TokenKind.Ident then
            case get(refs, tok.span.start) of
                Some(r):
                    let sym := r.value.targets[0]
                    ty := semType(env, sym)
                    if r.value.isDef then
                        mods := mods + 1
                    if sym.kind in [Kind.ConstSym, Kind.LetSym, Kind.EnumMember] then
                        mods := mods + 2
                    if sym.file in std or sym.kind in [Kind.BuiltinType, Kind.BuiltinTrait] then
                        mods := mods + 4
                None:
                    pass
        else if k >= ord(TokenKind.KwAnd) and k <= ord(TokenKind.KwWhile) then
            ty := 11
        else if tok.kind in [TokenKind.IntLit, TokenKind.RealLit] then
            ty := 14
        else if tok.kind in [
            TokenKind.CharLit,
            TokenKind.StringLit,
            TokenKind.StringBegin,
            TokenKind.StringMid,
            TokenKind.StringEnd,
        ] then
            ty := 13
        if ty >= 0 and tok.span.line = tok.span.endLine and tok.span.end > tok.span.start then
            add(var found, Semantic(start: tok.span.start, span: tok.span, kind: ty, mods: mods))
    for c in lexed.comments do
        if c.span.line = c.span.endLine then
            add(var found, Semantic(start: c.span.start, span: c.span, kind: 12, mods: 0))
    sort(var found, less: semBefore)
    var data: List[String] := []
    var line := 0
    var char := 0
    for f in found do
        let l := f.span.line - 1
        let from := utf16(t, f.span.line, col: f.span.col)
        let length := utf16(t, f.span.line, col: f.span.endCol) - from
        var delta := from
        if l = line then
            delta := from - char
        add(var data, "{l - line},{delta},{length},{f.kind},{f.mods}")
        line := l
        char := from
    return "\{\"data\":[{join(data, sep: ",")}]}"

# ------------------------------------------------------------------------- implementation

## The types that satisfy the trait at the position, or for a trait routine, the routines
## that provide it; in the open documents and the units they use, apart from standard units.
function implementations(s: Server, path: String, params: JValue): String
    let first := analyze(s, path)
    var parts: List[String] := []
    case refAt(first, path, params: params) of
        Some(r):
            if len(r.value.targets) > 0 then
                let found := implementationsOf(s, first, sym: r.value.targets[0])
                for at in found.syms do
                    add(var parts, location(
                        s,
                        found.texts[at.file],
                        file: at.file,
                        span: at.span.get(),
                    ))
        None:
            pass
    return "[{join(parts, sep: ",")}]"

## The types that satisfy the trait `sym`, or the routines that provide the trait routine
## `sym` for them, in the open documents and the units they use, apart from standard
## units. `first` is the check that found `sym`.
export function implementationsOf(s: Server, first: Analysis, sym: ref Symbol): Places
    var out := Places(syms: [], texts: {})
    var target: Option[ref Symbol] := None
    var member: Option[ref Symbol] := None
    if sym.span.isSome() then
        if sym.kind = Kind.TraitSym then
            target := Some(sym)
        else if isRoutine(sym.kind) and first.checked.env.isSome() then
            case get(first.checked.env.get().owner, sym.id) of
                Some(o):
                    if o.value.kind = Kind.TraitSym then
                        target := Some(o.value)
                        member := Some(sym)
                None:
                    pass
    if target.isNone() then
        return out
    let tr := target.get()
    var seen: Map[String, Boolean] := {}
    for open, _ in s.texts do
        let a := analyze(s, open)
        if a.checked.env.isNone() then
            continue
        let env := a.checked.env.get()
        let here := defSym(env, tr.file, tr.span.get())
        if here.isNone() then
            continue
        let traitSym := here.get()
        var std: Map[String, Boolean] := {}
        var home: Option[ref Unit] := None
        for u in a.checked.resolved.units do
            if u.std then
                std[u.path] := true
            if u.path = open then
                home := Some(u)
        if home.isNone() then
            continue
        let tc := checker(env, home.get())
        var index := 0
        for m in decl(env, traitSym).routines do
            if member.isSome() and m.name = member.get().name then
                break
            index := index + 1
        for r in a.checked.resolved.checker.index.refs do
            if not r.isDef or len(r.targets) <> 1 or r.file in std or r.targets[0].kind <> Kind.TypeSym then
                continue
            let ty := r.targets[0]
            if not (decl(env, ty).kind in ["record", "enum", "union", "subrange"]) then
                continue
            case implementation(tc, ty, traitSym) of
                Some(provided):
                    var at := ty
                    if member.isSome() then
                        if index >= len(provided.value) then
                            continue
                        at := provided.value[index]
                    let key := "{at.file}:{at.span.get().start}"
                    if at.span.isSome() and at.file in a.texts and not (key in seen) then
                        seen[key] := true
                        add(var out.syms, at)
                        out.texts[at.file] := a.texts[at.file]
                None:
                    pass
        # The checker refers to the environment, which keeps it: drop it, as the check does.
        env.checkers := {}
    return out

# ------------------------------------------------------------------------- call hierarchy

## A `CallHierarchyItem` for a routine.
function callItem(s: Server, a: Analysis, sym: ref Symbol): String
    let t := a.texts[sym.file]
    let where := "\"uri\":{quote(uriFor(s, sym.file))},\"range\":{range(t, declSpan(sym))},\"selectionRange\":{range(t, sym.span.get())}"
    return "\{\"name\":{quote(sym.name)},\"kind\":{symbolKind(sym)},\"detail\":{quote(headOf(a, sym))},{where}}"

## A `CallHierarchyItem` for the main body or unit level of a file.
function fileItem(s: Server, a: Analysis, file: String): String
    var name := file
    for u in a.checked.resolved.units do
        if u.path = file then
            name := u.name
    let t := a.texts[file]
    let whole := wholeRange(t)
    return "\{\"name\":{quote(name)},\"kind\":2,\"uri\":{quote(uriFor(s, file))},\"range\":{whole},\"selectionRange\":{whole}}"

## Whether the symbol is a routine declared in source.
export function isCallable(a: Analysis, sym: ref Symbol): Boolean
    return isRoutine(sym.kind) and sym.span.isSome() and sym.file in a.texts

function prepareCallHierarchy(s: Server, path: String, params: JValue): String
    let a := analyze(s, path)
    var parts: List[String] := []
    case refAt(a, path, params: params) of
        Some(r):
            for sym in r.value.targets do
                if isCallable(a, sym) then
                    add(var parts, callItem(s, a, sym))
        None:
            pass
    if len(parts) = 0 then
        return "null"
    return "[{join(parts, sep: ",")}]"

## The routine an item of `prepareCallHierarchy` names, and the check that found it.
function itemSym(s: Server, params: JValue): Option[Pair[Analysis, ref Symbol]]
    let item := field(params, key: "item")
    let path := pathOf(asString(field(item, key: "uri")).getOr(""))
    let start := field(field(item, key: "selectionRange"), key: "start")
    case parse("\{\"position\":{toText(start)}}") of
        Ok(position):
            let a := analyze(s, path)
            case refAt(a, path, params: position.value) of
                Some(r):
                    for sym in r.value.targets do
                        if isCallable(a, sym) then
                            return Some(Pair(first: a, second: sym))
                None:
                    pass
        Err(_):
            pass
    return None

## The routine of the check whose declaration holds the place, innermost first; None at
## the unit level.
function callerAt(a: Analysis, file: String, offset: Integer): Option[ref Symbol]
    var best: Option[ref Symbol] := None
    var bestStart := -1
    for r in a.checked.resolved.checker.index.refs do
        if r.isDef and r.file = file and len(r.targets) = 1 and isRoutine(r.targets[0].kind) then
            let sp := declSpan(r.targets[0])
            if sp.start <= offset and offset < sp.end and sp.start > bestStart then
                best := Some(r.targets[0])
                bestStart := sp.start
    return best

## The calls of the item's routine in the open documents and the units they use, grouped by
## the routine (or main body) they are in.
function incomingCalls(s: Server, params: JValue): String
    var parts: List[String] := []
    case itemSym(s, params) of
        Some(found):
            for c in callersOf(s, target: found.value.second) do
                let a := c.analysis
                var item := ""
                case c.sym of
                    Some(caller):
                        item := callItem(s, a, sym: caller.value)
                    None:
                        item := fileItem(s, a, file: c.file)
                var ranges: List[String] := []
                for sp in c.spans do
                    add(var ranges, range(a.texts[c.file], sp))
                add(var parts, "\{\"from\":{item},\"fromRanges\":[{join(ranges, sep: ",")}]}")
        None:
            pass
    return "[{join(parts, sep: ",")}]"

## The uses of the routine `target` in the open documents and the units they use, grouped
## by the routine (or unit level) they are in.
export function callersOf(s: Server, target: ref Symbol): List[Calls]
    var out: List[Calls] := []
    var slot: Map[String, Integer] := {}
    var seen: Map[String, Boolean] := {}
    for open, _ in s.texts do
        let a := analyze(s, open)
        if a.checked.env.isNone() then
            continue
        case defSym(a.checked.env.get(), target.file, target.span.get()) of
            Some(sym):
                for r in references(a.checked.resolved.checker.index, sym.value) do
                    let key := "{r.file}:{r.span.start}"
                    if r.isDef or key in seen or not (r.file in a.texts) then
                        continue
                    seen[key] := true
                    let caller := callerAt(a, r.file, offset: r.span.start)
                    var group := r.file
                    if caller.isSome() then
                        group := "{caller.get().file}:{caller.get().span.get().start}"
                    if not (group in slot) then
                        slot[group] := len(out)
                        add(var out, Calls(sym: caller, file: r.file, spans: [], analysis: a))
                    add(var out[slot[group]].spans, r.span)
            None:
                pass
    return out

## The routines the item's routine calls, each with the places it calls them.
function outgoingCalls(s: Server, params: JValue): String
    var parts: List[String] := []
    case itemSym(s, params) of
        Some(found):
            let a := found.value.first
            for c in calleesOf(a, caller: found.value.second) do
                var ranges: List[String] := []
                for sp in c.spans do
                    add(var ranges, range(a.texts[c.file], sp))
                let item := callItem(s, a, sym: c.sym.get())
                add(var parts, "\{\"to\":{item},\"fromRanges\":[{join(ranges, sep: ",")}]}")
        None:
            pass
    return "[{join(parts, sep: ",")}]"

## The routines declared in source that `caller` names in its declaration, each with the
## places, in the check `a`.
export function calleesOf(a: Analysis, caller: ref Symbol): List[Calls]
    let body := declSpan(caller)
    var out: List[Calls] := []
    var slot: Map[Integer, Integer] := {}
    for r in a.checked.resolved.checker.index.refs do
        if r.isDef or r.file <> caller.file or r.span.start < body.start or r.span.end > body.end then
            continue
        if len(r.targets) = 0 or not isCallable(a, r.targets[0]) then
            continue
        let callee := r.targets[0]
        if not (callee.id in slot) then
            slot[callee.id] := len(out)
            add(var out, Calls(sym: Some(callee), file: r.file, spans: [], analysis: a))
        add(var out[slot[callee.id]].spans, r.span)
    return out

## `c` in lower case, for ASCII letters.
function lowerChar(c: Char): Char
    if c >= 'A' and c <= 'Z' then
        return Char(ord(c) + 32)
    return c

## Whether the letters of `query` appear in `name` in order, ignoring case.
export function matches(name, query: String): Boolean
    var want: List[Char] := []
    for c in query do
        add(var want, lowerChar(c))
    var i := 0
    for c in name do
        if i < len(want) and lowerChar(c) = want[i] then
            i := i + 1
    return i = len(want)

## The types, constants, routines, fields and enum members declared in the open documents
## and the units they use, apart from the standard units, whose names match `query`.
function workspaceSymbols(s: Server, query: String): String
    var parts: List[String] := []
    var seen: Map[String, Boolean] := {}
    for path, _ in s.texts do
        let a := analyze(s, path)
        var std: Map[String, Boolean] := {}
        for u in a.checked.resolved.units do
            if u.std then
                std[u.path] := true
        for r in a.checked.resolved.checker.index.refs do
            if not r.isDef or len(r.targets) <> 1 or r.file in std or not (r.file in a.texts) then
                continue
            let sym := r.targets[0]
            var wanted := sym.kind in [
                Kind.TypeSym,
                Kind.TraitSym,
                Kind.ConstSym,
                Kind.FieldSym,
                Kind.EnumMember,
            ] or isRoutine(sym.kind)
            case sym.node of
                Signature(_):
                    wanted := sym.file = r.file
                else:
                    pass
            let key := "{r.file}:{r.span.start}"
            if wanted and not (key in seen) and matches(sym.name, query: query) then
                seen[key] := true
                var container := ""
                case a.checked.env of
                    Some(env):
                        case get(env.value.owner, sym.id) of
                            Some(o):
                                container := ",\"containerName\":{quote(o.value.name)}"
                            None:
                                pass
                    None:
                        pass
                let where := location(s, a.texts[r.file], file: r.file, span: r.span)
                add(
                    var parts,
                    "\{\"name\":{quote(sym.name)},\"kind\":{symbolKind(sym)},\"location\":{where}{container}}",
                )
    return "[{join(parts, sep: ",")}]"

## A fold for each line followed by more deeply indented lines, up to the last of them.
function foldingRanges(s: Server, path: String): String
    let text := get(s.texts, path)
    if text.isNone() then
        return "[]"
    let lines := split(normalize(text.get()), sep: "\n")
    var indents: List[Integer] := []
    for l in lines do
        if trim(l) = "" then
            add(var indents, -1)
        else
            var n := 0
            for c in l do
                if c <> ' ' then
                    break
                n := n + 1
            add(var indents, n)
    var parts: List[String] := []
    for i := 0 to len(lines) - 1 do
        if indents[i] < 0 then
            continue
        var last := i
        var j := i + 1
        while j < len(lines) and (indents[j] < 0 or indents[j] > indents[i]) do
            if indents[j] >= 0 then
                last := j
            j := j + 1
        if last > i then
            add(var parts, "\{\"startLine\":{i},\"endLine\":{last}}")
    return "[{join(parts, sep: ",")}]"

## Quick fixes from the diagnostics of the document that touch the request's range.
function codeActions(s: Server, path: String, params: JValue): String
    let a := analyze(s, path)
    let t := get(a.texts, path)
    if t.isNone() then
        return "[]"
    let text := t.get()
    let r := field(params, key: "range")
    let first := asInteger(field(field(r, key: "start"), key: "line")).getOr(0) + 1
    let last := asInteger(field(field(r, key: "end"), key: "line")).getOr(0) + 1
    let uri := quote(uriFor(s, path))
    var parts: List[String] := []
    for d in a.checked.resolved.checker.diagnostics do
        if d.file <> path or d.span.endLine < first or d.span.line > last then
            continue
        for f in d.fixes do
            var edits: List[String] := []
            for e in f.edits do
                add(var edits, "\{\"range\":{range(text, e.span)},\"newText\":{quote(e.text)}}")
            let edit := "\{\"changes\":\{{uri}:[{join(edits, sep: ",")}]}}"
            add(
                var parts,
                "\{\"title\":{quote(f.description)},\"kind\":\"quickfix\",\"diagnostics\":[{diagnostic(text, d)}],\"edit\":{edit}}",
            )
    return "[{join(parts, sep: ",")}]"

# ------------------------------------------------------------------------- requests

function capabilities(): String
    return "\{\"capabilities\":\{\"textDocumentSync\":1,\"documentFormattingProvider\":true,\"hoverProvider\":true,\"definitionProvider\":true,\"typeDefinitionProvider\":true,\"implementationProvider\":true,\"referencesProvider\":true,\"codeActionProvider\":true,\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"callHierarchyProvider\":true,\"inlayHintProvider\":true,\"semanticTokensProvider\":\{\"legend\":{legend()},\"full\":true},\"foldingRangeProvider\":true,\"renameProvider\":true,\"completionProvider\":\{\"triggerCharacters\":[\".\"]},\"signatureHelpProvider\":\{\"triggerCharacters\":[\"(\",\",\"]}},\"serverInfo\":\{\"name\":\"pst\"}}"

## The edits that format the document at `uri`: none if it is formatted, or can't be.
function formatting(s: Server, uri: String): String
    let path := pathOf(uri)
    case get(s.texts, path) of
        Some(text):
            case format(text.value, file: path) of
                Ok(f):
                    if f.value = text.value then
                        return "[]"
                    let edit := "\{\"range\":{wholeRange(textOf(text.value))},\"newText\":{quote(f.value)}}"
                    return "[{edit}]"
                Err(_):
                    return "[]"
        None:
            return "[]"

## Handles one message.
procedure handle(var s: Server, m: JValue)
    let method := asString(field(m, key: "method")).getOr("")
    let id := field(m, key: "id")
    let params := field(m, key: "params")
    let doc := field(params, key: "textDocument")
    let uri := asString(field(doc, key: "uri")).getOr("")
    if method = "initialize" then
        respond(id, result: capabilities())
    else if method = "shutdown" then
        s.down := true
        respond(id, result: "null")
    else if method = "exit" then
        if s.down then
            exit(0)
        exit(1)
    else if method = "textDocument/didOpen" then
        let path := pathOf(uri)
        s.texts[path] := asString(field(doc, key: "text")).getOr("")
        s.uris[path] := uri
        checkAll(s)
    else if method = "textDocument/didChange" then
        let path := pathOf(uri)
        for change in items(field(params, key: "contentChanges")) do
            s.texts[path] := asString(field(change, key: "text")).getOr("")
        checkAll(s)
    else if method = "textDocument/didClose" then
        let path := pathOf(uri)
        remove(var s.texts, path)
        remove(var s.uris, path)
        notify(
            "textDocument/publishDiagnostics",
            params: "\{\"uri\":{quote(uri)},\"diagnostics\":[]}",
        )
        checkAll(s)
    else if method = "textDocument/formatting" then
        respond(id, result: formatting(s, uri: uri))
    else if method = "textDocument/hover" then
        respond(id, result: hover(s, pathOf(uri), params: params))
    else if method = "textDocument/implementation" then
        respond(id, result: implementations(s, pathOf(uri), params: params))
    else if method = "textDocument/typeDefinition" then
        respond(id, result: typeDefinition(s, pathOf(uri), params: params))
    else if method = "textDocument/inlayHint" then
        respond(id, result: inlayHints(s, pathOf(uri), params: params))
    else if method = "textDocument/semanticTokens/full" then
        respond(id, result: semanticTokens(s, pathOf(uri)))
    else if method = "textDocument/prepareCallHierarchy" then
        respond(id, result: prepareCallHierarchy(s, pathOf(uri), params: params))
    else if method = "callHierarchy/incomingCalls" then
        respond(id, result: incomingCalls(s, params))
    else if method = "callHierarchy/outgoingCalls" then
        respond(id, result: outgoingCalls(s, params))
    else if method = "workspace/symbol" then
        respond(id, result: workspaceSymbols(
            s,
            query: asString(field(params, key: "query")).getOr(""),
        ))
    else if method = "textDocument/definition" then
        respond(id, result: definition(s, pathOf(uri), params: params))
    else if method = "textDocument/references" then
        respond(id, result: referencesTo(s, pathOf(uri), params: params))
    else if method = "textDocument/codeAction" then
        respond(id, result: codeActions(s, pathOf(uri), params: params))
    else if method = "textDocument/rename" then
        case rename(s, pathOf(uri), params: params) of
            Ok(edit):
                respond(id, result: edit.value)
            Err(e):
                respondError(id, code: -32803, message: e.error)
    else if method = "textDocument/completion" then
        respond(id, result: completion(s, pathOf(uri), params: params))
    else if method = "textDocument/signatureHelp" then
        respond(id, result: signatureHelp(s, pathOf(uri), params: params))
    else if method = "textDocument/documentSymbol" then
        respond(id, result: documentSymbols(s, pathOf(uri)))
    else if method = "textDocument/foldingRange" then
        respond(id, result: foldingRanges(s, pathOf(uri)))
    else if not isNull(id) then
        respondError(id, code: -32601, message: "unsupported method '{method}'")

## Serves one client on standard input and output, until `exit` or the end of the input.
export procedure serve(stdDir: String)
    var s := Server(stdDir: stdDir, texts: {}, uris: {}, down: false)
    while true do
        case receive() of
            Some(body):
                case parse(body.value) of
                    Ok(m):
                        handle(var s, m: m.value)
                    Err(e):
                        respondError(JNull(), code: -32700, message: e.error)
            None:
                break
    if s.down then
        exit(0)
    exit(1)
