program Main

uses IO, Cash

let a := Money(cents: 150)
let b := Money(cents: 25)
writeln(
    "{(a + b).cents} {(a - b).cents} {(a * 3).cents} {(2 * b).cents} {(a / 4).cents} {(-a).cents}",
)
var g := grid(3, 2)
g[1, 1] := 7
g[2, 0] := 4
writeln("{g[1, 1]} {g[2, 0]} {g[0, 0]} {7 in g} {9 in g}")
let v1 := version(1, 2, "x")
let v2 := version(1, 2, "y")
let v3 := version(1, 3, "x")
writeln("{v1 = v2} {v1 <> v3} {v1 < v3} {v3 > v1} {v1 <= v2}")
let s: Set[Version] := [v1, v2, v3]
writeln("{length(s)}")
var m: Map[Version, String] := [:]
m[v1] := "one"
m[v2] := "two"
writeln("{length(m)} {m[v1]}")
var vs := [v3, v1]
sort(var vs)
writeln("{vs[0].minor}")
