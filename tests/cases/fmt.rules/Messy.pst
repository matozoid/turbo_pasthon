

program Messy
uses   IO,Strings

## Doc comment.
type
    Point=record
        x :Integer
        y:Integer

    Color = (Red,Green,
             Blue)
    Shades = (
        Light,
        Dark,
    )

function f( a:Integer,b : Integer ):Integer  # trailing
    if a>b then
        return -a+b*-1
    else
        if a = b then
            # equal
            return 0
        else if a < 0 then
            return a
        else
            return (b)



    # end if
    return a-(-b)
# end function f

function combine(first: Integer, second: Integer, third: Integer, fourth: Integer, fifth: Integer): Integer
    return first + second + third + fourth + fifth

function check(a: Integer, b: Integer): Boolean
    return (a > 0 and b > 0 and a < 1000000 and b < 1000000 and a + b < 1000000 and a * b < 999999999)

procedure show(xs: List[Integer])
    for x in xs do
        writeln( "x = {x  +  1}, {join(["a","b"], sep: ",")}" )
        # a comment in the loop

    # a comment after it
    writeln("done")

let p := Point(x: 1,
               y: 2)  # point
let xs: List[Integer] := [1,2,3,]
let ys := [
    10,  # ten
    # twenty next
    20
]
let m: Map[String, Integer] := {"a":1, "b":2}
show([p.x, p.y, combine(1000000, second: 2000000, third: 3000000, fourth: 4000000, fifth: 500000)])
writeln("{f(1, b: 2)} {check(1, b: 2)} {len(xs)} {len(ys)} {len(m)} {Color.Blue} {Shades.Dark}")
if xs[0]=1 and not(xs[1]=3) then
    writeln("ok")
for i:=0 to len(xs)-1 do
    writeln("{xs[len(xs)-1-i]}")
writeln(join(["a long string to fill the line", "another long string", "and a third one"], sep: ", "))
