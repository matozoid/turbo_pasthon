usage: pst check FILE [--json]
       pst build FILE [-o OUT] [--unchecked] [--json]
       pst run [--unchecked] FILE [-- ARGS]
       pst test PATH [--filter TEXT] [--unchecked] [--json]
       pst fmt PATH [--check]
       pst lsp
       pst query def|refs|type|hover|complete FILE:LINE:COL
       pst query impls|callers|callees FILE:LINE:COL
       pst query symbols [PATH]
       pst tokens FILE
       pst ast FILE
pst: error: missing FILE:LINE:COL
