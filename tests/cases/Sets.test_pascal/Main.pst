program Main

uses IO

type
    Color = (Red, Green, Blue, Cyan)
    Digit = '0'..'9'

let a: BitSet[Color] := [Red, Green]
let b: BitSet[Color] := [Color.Green, Blue]
writeln("{a + b} {a - b} {a * b} {[Red] + b}")
writeln("{[Green] <= a} {a <= b} {a >= [Red]} {a + [Blue] >= b} {a = [Green, Red]}")
var c: BitSet[Color] := []
c := c + [Green..Cyan]
let e: BitSet[Color] := [Cyan..Green]
writeln("{c} {e} {Color.Blue in [Color.Red..Color.Blue]}")
let d: BitSet[Digit] := ['0'..'3', '7']
let k: Digit := '5'
writeln("{d} {k in ['0'..'4']} {k in ['5'..'9']}")
let n: BitSet[Int8] := [-3..2, 100]
var bs: BitSet[Byte] := [0..255]
writeln("{n} {length(bs)}")
