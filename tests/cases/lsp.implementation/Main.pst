program Main

uses IO, Shapes

type
    Room = record
        width: Integer

function area(r: Room): Integer
    return r.width * r.width

function total[T: Shape](shapes: List[T]): Integer
    var sum := 0
    for s in shapes do
        sum := sum + s.area()
    return sum

writeln(total([Square(name: "a", side: 2)]))
