$ $PST tokens tokens-dedent.pst
exit 1
--- stdout
KwIf 1:1-1:3 "if" -
Ident 1:4-1:5 "a" -
KwThen 1:6-1:10 "then" -
Newline 1:10-2:1 "\n" -
Indent 2:5-2:5 "" -
KwIf 2:5-2:7 "if" -
Ident 2:8-2:9 "b" -
KwThen 2:10-2:14 "then" -
Newline 2:14-3:1 "\n" -
Indent 3:9-3:9 "" -
Ident 3:9-3:10 "c" -
Newline 3:10-4:1 "\n" -
Dedent 4:3-4:3 "" -
Dedent 4:3-4:3 "" -
Ident 4:3-4:4 "d" -
Newline 4:4-5:1 "\n" -
Ident 5:1-5:2 "e" -
Newline 5:2-6:1 "\n" -
Eof 6:1-6:1 "" -
error E0002 4:1-4:3 "indentation of 2 spaces is not a multiple of 4"
--- stderr
