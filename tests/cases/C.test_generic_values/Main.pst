program Main

uses IO, C

type
    BinOp = function(Integer, Integer): Integer
    Pick = function(String, String): String
    Cmp = function(Pointer, Pointer): CInt

extern "libc.so.6"
    procedure qsort(base: Pointer, n: CSize, size: CSize, cmp: Cmp)
    function malloc(n: CSize): Pointer
    procedure free(p: Pointer)

function bigger[T: Ordered](a, b: T): T
    if a > b then
        return a
    return b

function apply(f: BinOp, a, b: Integer): Integer
    return f(a, b)

unsafe function byValue[T: Ordered](x, y: Pointer): CInt
    let a := deref(cast[Ptr[T]](x))
    let b := deref(cast[Ptr[T]](y))
    if a < b then
        return -1
    if a > b then
        return 1
    return 0

unsafe procedure sortSome()
    let p := cast[Ptr[CInt]](malloc(20))
    let xs: List[CInt] := [5, 3, 9, 1, 4]
    for i := 0 to 4 do
        deref(p + i) := xs[i]
    let c: Cmp := byValue[CInt]
    qsort(cast[Pointer](p), n: 5, size: 4, cmp: c)
    for i := 0 to 4 do
        write("{deref(p + i)} ")
    deref(p) := 7
    qsort(cast[Pointer](p), n: 5, size: 4, cmp: byValue[CInt])
    for i := 0 to 4 do
        write("{deref(p + i)} ")
    writeln("")
    free(cast[Pointer](p))

writeln(apply(bigger[Integer], a: 3, b: 4))
let f: Pick := bigger[String]
writeln(f("pear", "apple"))
sortSome()
