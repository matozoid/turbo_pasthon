program Main

uses IO

type
    Circle = record
        r: Integer
    Rect = record
        w: Integer
        h: Integer
    Shape = Circle | Rect
    Scene = record
        shapes: List[Shape]

function area(s: Shape): Integer
    return case s of
        Circle(c): 3 * c.r * c.r
        Rect(r): r.w * r.h

function total(shapes: List[Shape]): Integer
    var sum := 0
    for s in shapes do
        sum := sum + area(s)
    return sum

function count[T](xs: List[Option[T]]): Integer
    var n := 0
    for x in xs do
        if x.isSome() then
            n := n + 1
    return n

writeln(total([Circle(r: 1), Rect(w: 2, h: 3)]))
writeln(total([Rect(w: 2, h: 3)]))
let scene := Scene(shapes: [Rect(w: 1, h: 1), Circle(r: 2), Rect(w: 4, h: 1)])
writeln(total(scene.shapes))
writeln(count([Some(1), None(), Some(3)]))
