$ $PST tokens tokens-unterminated.pst
exit 1
--- stdout
KwLet 1:1-1:4 "let" -
Ident 1:5-1:6 "s" -
Assign 1:7-1:9 ":=" -
StringLit 1:10-1:14 "\"abc" text "abc"
Newline 1:14-2:1 "\n" -
KwLet 2:1-2:4 "let" -
Ident 2:5-2:6 "t" -
Assign 2:7-2:9 ":=" -
StringBegin 2:10-2:13 "\"a{" text "a"
Ident 2:13-2:14 "b" -
StringEnd 2:14-2:14 "" text ""
Newline 2:14-3:1 "\n" -
KwLet 3:1-3:4 "let" -
Ident 3:5-3:6 "c" -
Assign 3:7-3:9 ":=" -
CharLit 3:10-3:12 "'x" char 120
Newline 3:12-4:1 "\n" -
Eof 4:1-4:1 "" -
error E0004 1:10-1:14 "unterminated string literal"
error E0030 2:14-2:14 "string placeholder '{' is not closed on this line; write '\\{' for a literal brace"
error E0008 3:10-3:12 "unterminated char literal"
--- stderr
