$ $PST tokens lexer.Brackets.test_unclosed_recovers_at_next_statement.pst
exit 1
--- stdout
Ident 1:1-1:2 "x" -
Assign 1:3-1:5 ":=" -
Ident 1:6-1:7 "f" -
Lparen 1:7-1:8 "(" -
Ident 1:8-1:9 "a" -
Comma 1:9-1:10 "," -
Lbracket 1:11-1:12 "[" -
IntLit 1:12-1:13 "1" int 1
Newline 1:13-2:1 "\n" -
Ident 2:1-2:2 "y" -
Assign 2:3-2:5 ":=" -
IntLit 2:6-2:7 "2" int 2
Newline 2:7-3:1 "\n" -
Eof 3:1-3:1 "" -
error E0009 1:7-1:8 "unclosed '('"
  fix "insert '])'"
    edit 1:13-1:13 "])"
error E0009 1:11-1:12 "unclosed '['"
  fix "insert '])'"
    edit 1:13-1:13 "])"
--- stderr
