$ $PST tokens tokens-comments.pst
exit 0
--- stdout
Ident 3:1-3:2 "x" -
Assign 3:3-3:5 ":=" -
IntLit 3:6-3:7 "1" int 1
Newline 3:19-4:1 "\n" -
Eof 5:1-5:1 "" -
comment 1:1-1:7 "## doc" true
comment 2:1-2:8 "# plain" false
comment 3:9-3:19 "# trailing" false
comment 4:5-4:23 "# indented comment" false
--- stderr
