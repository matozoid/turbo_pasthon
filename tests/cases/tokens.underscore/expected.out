$ $PST tokens tokens-underscore.pst
exit 0
--- stdout
Underscore 1:1-1:2 "_" -
Assign 1:3-1:5 ":=" -
Ident 1:6-1:7 "f" -
Lparen 1:7-1:8 "(" -
Rparen 1:8-1:9 ")" -
Newline 1:9-2:1 "\n" -
Underscore 2:1-2:3 "_x" -
Assign 2:4-2:6 ":=" -
IntLit 2:7-2:8 "2" int 2
Newline 2:8-3:1 "\n" -
KwFor 3:1-3:4 "for" -
Underscore 3:5-3:6 "_" -
KwIn 3:7-3:9 "in" -
Ident 3:10-3:12 "xs" -
KwDo 3:13-3:15 "do" -
Newline 3:15-4:1 "\n" -
Indent 4:5-4:5 "" -
Ident 4:5-4:8 "a_b" -
Assign 4:9-4:11 ":=" -
IntLit 4:12-4:13 "1" int 1
Newline 4:13-5:1 "\n" -
Dedent 5:1-5:1 "" -
Eof 5:1-5:1 "" -
--- stderr
