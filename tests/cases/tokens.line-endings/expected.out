$ $PST tokens tokens-line-endings.pst
exit 0
--- stdout
KwProgram 1:1-1:8 "program" -
Ident 1:9-1:10 "P" -
Newline 1:10-2:1 "\n" -
Ident 2:1-2:2 "x" -
Assign 2:3-2:5 ":=" -
IntLit 2:6-2:7 "1" int 1
Newline 2:7-3:1 "\n" -
KwIf 3:1-3:3 "if" -
Ident 3:4-3:5 "a" -
KwThen 3:6-3:10 "then" -
Newline 3:10-4:1 "\n" -
Indent 4:5-4:5 "" -
Ident 4:5-4:6 "b" -
Newline 4:6-5:1 "\n" -
Dedent 5:1-5:1 "" -
Eof 5:1-5:1 "" -
--- stderr
