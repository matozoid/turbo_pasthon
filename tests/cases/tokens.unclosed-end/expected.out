$ $PST tokens tokens-unclosed-end.pst
exit 1
--- stdout
Ident 1:1-1:2 "f" -
Lparen 1:2-1:3 "(" -
Ident 1:3-1:4 "a" -
Comma 1:4-1:5 "," -
Lbracket 1:6-1:7 "[" -
Ident 1:7-1:8 "b" -
Newline 2:1-2:1 "" -
Eof 2:1-2:1 "" -
error E0009 1:2-1:3 "unclosed '('"
  fix "insert '])'"
    edit 1:8-1:8 "])"
error E0009 1:6-1:7 "unclosed '['"
  fix "insert '])'"
    edit 1:8-1:8 "])"
--- stderr
