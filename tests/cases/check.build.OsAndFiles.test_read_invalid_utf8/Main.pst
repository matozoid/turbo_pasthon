program Main

uses IO, Strings

case open("/tmp/tmpktdi783b/tmpnxpfw3ao/bad") of
    Ok(f):
        case readAll(f.value) of
            Ok(t):
                write(t.value)
                writeln(charCount(t.value))
            Err(e):
                writeln(e.error)
    Err(e):
        writeln(e.error)
