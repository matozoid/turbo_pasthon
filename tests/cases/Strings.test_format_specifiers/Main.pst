program Main

uses IO

type
    Color = (Red, Green)

let n := 42
let w := 6
let x := 3.14159
let y: Real32 := 2.5
writeln("[{n:5}] [{n:-5}] [{"héllo":7}] [{n:1}] [{n:w}] [{-n:w + 1}]")
writeln("[{x:0:2}] [{x:8:3}] [{x:-8:1}] [{y:0:3}] [{-0.5:0:0}] [{1.0e20:0:1}]")
writeln("[{2.5:0:-1}] [{x:0:200 - 197}] [{1.0e300 * 10.0:6:2}]")
writeln("[{true:6}] [{'c':3}] [{Color.Green:-7}] [{[1, 2]:8}]")
writeln("[{justify("ab", 4)}] [{justify("ab", -4)}] [{justify("abc", 2)}]")
