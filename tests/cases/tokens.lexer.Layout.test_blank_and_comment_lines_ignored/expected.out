$ $PST tokens lexer.Layout.test_blank_and_comment_lines_ignored.pst
exit 0
--- stdout
KwIf 1:1-1:3 "if" -
Ident 1:4-1:5 "a" -
KwThen 1:6-1:10 "then" -
Newline 1:10-2:1 "\n" -
Indent 4:5-4:5 "" -
Ident 4:5-4:6 "b" -
Newline 4:6-5:1 "\n" -
Ident 6:5-6:6 "c" -
Newline 6:6-7:1 "\n" -
Dedent 7:1-7:1 "" -
Eof 7:1-7:1 "" -
comment 3:1-3:16 "{ top comment }"
comment 5:9-5:25 "{ deep comment }"
--- stderr
