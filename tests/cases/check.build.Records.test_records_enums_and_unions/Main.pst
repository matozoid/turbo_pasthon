program Main

uses IO

type
    Color = (Red, Green, Blue)
    Point = record
        x: Integer
        y: Integer
        label: String := "p"
    Circle = record
        r: Integer
    Rect = record
        w: Integer
        h: Integer
    Shape = Circle | Rect

function area(s: Shape): Integer
    return case s of
        Circle(c): 3 * c.r * c.r
        Rect(r): r.w * r.h

procedure move(var p: Point, dx: Integer)
    p.x := p.x + dx

procedure bump(var n: Integer)
    n := n + 1

function find(n: Integer): Option[Integer]
    if n > 0 then
        return Some(n * 2)
    return None

var p := Point(x: 1, y: 2)
let q := p
move(var p, dx: 10)
p.label := "moved"
writeln("{p.x} {p.y} {p.label} / {q.x} {q.label}")
bump(var p.y)
writeln(p.y)
writeln(p = q)
writeln(Point(x: 1, y: 2) = q)
let c := Color.Green
writeln("{c} {ord(c)} {Color.Blue}")
for k := Color.Red to Color.Blue do
    write("{k} ")
writeln("")
case c of
    Red: writeln("red")
    Green, Blue: writeln("not red")
var shapes: Shape := Circle(r: 2)
writeln(area(shapes))
shapes := Rect(w: 3, h: 4)
writeln(area(shapes))
writeln(area(Circle(r: 1)))
case find(4) of
    Some(v): writeln("some {v.value}")
    None: writeln("none")
case find(0) of
    Some(v): writeln("some {v.value}")
    None: writeln("none")
let o: Option[Integer] := Some(3)
writeln(o = Some(3))
writeln(o = None)
let label := case 7 of
    1..5: "low"
    else: "high"
writeln(label)
