program Main

uses IO, C

extern "libc.so.6"
    function printf(format: CString, ...): CInt
    function fflush(stream: Pointer): CInt

extern "./libbig.so"
    type
        export Big = record
            a: CLong
            b: CLong
            c: CLong
        export Pt = record
            x: CDouble
            y: CDouble
        export Mix = record
            n: CInt
            f: CFloat
    function sumBig(b: Big): CLong
    function makeBig(a: CLong, b: CLong, c: CLong): Big
    function late(
        a: CLong,
        b: CLong,
        c: CLong,
        d: CLong,
        e: CLong,
        p: Pt,
        f: CLong,
        q: Pt,
        m: Mix,
        r1: CDouble,
        r2: CDouble,
        r3: CDouble,
        r4: CDouble,
        r5: CDouble,
        r6: CDouble,
        r7: CDouble,
    ): CDouble

unsafe procedure counts()
    _ := printf(
        toCString("%d %d %d %d %d %d %d %d\n"),
        CInt(1),
        CInt(2),
        CInt(3),
        CInt(4),
        CInt(5),
        CInt(6),
        CInt(7),
        CInt(8),
    )
    _ := printf(
        toCString("%g %g %g %g %g %g %g %g %g %g\n"),
        CDouble(1.5),
        CDouble(2.5),
        CDouble(3.5),
        CDouble(4.5),
        CDouble(5.5),
        CDouble(6.5),
        CDouble(7.5),
        CDouble(8.5),
        CDouble(9.5),
        CDouble(10.5),
    )
    _ := fflush(cast[Pointer](0))

counts()
let b := makeBig(1, b: 2, c: 3)
writeln("{b.a} {b.b} {b.c} {sumBig(b)} {sumBig(Big(a: 4, b: 5, c: 6))}")
writeln(late(
    1,
    b: 2,
    c: 3,
    d: 4,
    e: 5,
    p: Pt(x: 0.5, y: 1.5),
    f: 6,
    q: Pt(x: 2.5, y: 3.5),
    m: Mix(n: 7, f: 0.25),
    r1: 1.0,
    r2: 2.0,
    r3: 3.0,
    r4: 4.0,
    r5: 5.0,
    r6: 6.0,
    r7: 7.0,
))
