program Main

uses IO, C

external "libc.so.6"
    function printf(format: CString, ...): CInt
    function fflush(stream: Pointer): CInt

external "./libbig.so"
    type
        export Big = record
            a: CLong
            b: CLong
            c: CLong
        export Pt = record
            x: CDouble
            y: CDouble
        export Mix = record
            n: CInt
            f: CFloat
        export Duo = record
            n: CLong
            x: CDouble
    function sumBig(b: Big): CLong
    function makeBig(a: CLong, b: CLong, c: CLong): Big
    function late(
        a: CLong,
        b: CLong,
        c: CLong,
        d: CLong,
        e: CLong,
        p: Pt,
        f: CLong,
        q: Pt,
        m: Mix,
        r1: CDouble,
        r2: CDouble,
        r3: CDouble,
        r4: CDouble,
        r5: CDouble,
        r6: CDouble,
        r7: CDouble,
    ): CDouble
    function callBack(
        f: function(
            Pt,
            Big,
            Mix,
            CLong,
            CLong,
            CLong,
            CLong,
            CLong,
            CLong,
            CLong,
            CDouble,
        ): CDouble,
    ): CDouble
    function callLate(
        f: function(CLong, CLong, CLong, CLong, CLong, CLong, Mix, CFloat): CLong,
    ): CLong
    procedure callMade(
        fp: function(CDouble): Pt,
        fm: function(CInt): Mix,
        fb: function(CLong): Big,
        fd: function(CLong, CDouble): Duo,
    )

function makePt(x: CDouble): Pt
    return Pt(x: x, y: x * 2.0)

function makeMix(n: CInt): Mix
    return Mix(n: n, f: 0.75)

function makeBigOne(a: CLong): Big
    return Big(a: a, b: a * 10, c: a * 100)

function makeDuo(n: CLong, x: CDouble): Duo
    return Duo(n: n * 2, x: x)

function onBack(
    p: Pt,
    b: Big,
    m: Mix,
    c1: CLong,
    c2: CLong,
    c3: CLong,
    c4: CLong,
    c5: CLong,
    c6: CLong,
    c7: CLong,
    r: CDouble,
): CDouble
    writeln(
        "back: {p.x} {p.y} {b.a} {b.b} {b.c} {m.n} {m.f} {c1} {c2} {c3} {c4} {c5} {c6} {c7} {r}",
    )
    return p.y + r

function onLate(
    c1: CLong,
    c2: CLong,
    c3: CLong,
    c4: CLong,
    c5: CLong,
    c6: CLong,
    m: Mix,
    f: CFloat,
): CLong
    writeln("late: {c1} {c2} {c3} {c4} {c5} {c6} {m.n} {m.f} {f}")
    return c1 + c6 + CLong(m.n)

unsafe procedure counts()
    _ := printf(
        toCString("%d %d %d %d %d %d %d %d\n"),
        CInt(1),
        CInt(2),
        CInt(3),
        CInt(4),
        CInt(5),
        CInt(6),
        CInt(7),
        CInt(8),
    )
    _ := printf(
        toCString("%g %g %g %g %g %g %g %g %g %g\n"),
        CDouble(1.5),
        CDouble(2.5),
        CDouble(3.5),
        CDouble(4.5),
        CDouble(5.5),
        CDouble(6.5),
        CDouble(7.5),
        CDouble(8.5),
        CDouble(9.5),
        CDouble(10.5),
    )
    _ := fflush(cast[Pointer](0))

counts()
let b := makeBig(1, b: 2, c: 3)
writeln("{b.a} {b.b} {b.c} {sumBig(b)} {sumBig(Big(a: 4, b: 5, c: 6))}")
writeln(late(
    1,
    b: 2,
    c: 3,
    d: 4,
    e: 5,
    p: Pt(x: 0.5, y: 1.5),
    f: 6,
    q: Pt(x: 2.5, y: 3.5),
    m: Mix(n: 7, f: 0.25),
    r1: 1.0,
    r2: 2.0,
    r3: 3.0,
    r4: 4.0,
    r5: 5.0,
    r6: 6.0,
    r7: 7.0,
))
writeln(callBack(onBack))
writeln(callLate(onLate))
callMade(makePt, fm: makeMix, fb: makeBigOne, fd: makeDuo)
