program Main

uses IO

type
    Grid = Array[Integer, 3]
    Board = record
        cells: Array[String, 2]

function total(g: Grid): Integer
    var t := 0
    for x in g do
        t := t + x
    return t

procedure bump(var g: Grid)
    g[0] := g[0] + 100

var g: Grid := [1, 2, 3]
writeln(g[1])
let h := g
g[1] := 20
writeln("{g[1]} {h[1]} {len(g)}")
writeln(total(g))
bump(var g)
writeln(g[0])
writeln(g = h)
var b := Board(cells: ["a", "b"])
b.cells[1] := "c"
writeln("{b.cells[0]}{b.cells[1]}")
for i := 0 to len(h) - 1 do
    writeln(h[i])
writeln(g[3])
