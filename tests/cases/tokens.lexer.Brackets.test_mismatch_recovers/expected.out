$ $PST tokens lexer.Brackets.test_mismatch_recovers.pst
exit 1
--- stdout
Ident 1:1-1:2 "f" -
Lparen 1:2-1:3 "(" -
Lbracket 1:3-1:4 "[" -
Ident 1:4-1:5 "a" -
Rparen 1:5-1:6 ")" -
Newline 1:6-2:1 "\n" -
Ident 2:1-2:2 "x" -
Newline 2:2-3:1 "\n" -
Eof 3:1-3:1 "" -
error E0009 1:5-1:6 "unmatched ')'; expected ']'"
--- stderr
