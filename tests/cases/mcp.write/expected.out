--- stdout
program Fix

uses Shapes

function twice(n: Integer): Integer
    return n + n

_ := twice(2)
work/Main.pst:8:let sq := Square(edge: 3)
work/Shapes.pst:8:        export edge: Integer
work/Shapes.pst:11:    return sq.edge * sq.edge
