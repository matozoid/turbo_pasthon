unit Shop

uses IO

function double(x: Integer): Integer
    return 2 * x

export function half(x: Integer): Integer
    return x div 2

test "double doubles"
    assert double(2) = 4

test "half is wrong"
    writeln("about to fail")
    assert half(5) = 3

test "panics on bounds"
    let xs: List[Integer] := []
    writeln(xs[1])

test "halts"
    halt(4)
