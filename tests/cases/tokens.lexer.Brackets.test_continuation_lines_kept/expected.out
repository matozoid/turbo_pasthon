$ $PST tokens lexer.Brackets.test_continuation_lines_kept.pst
exit 0
--- stdout
Ident 1:1-1:2 "f" -
Lparen 1:2-1:3 "(" -
Ident 1:3-1:4 "a" -
Comma 1:4-1:5 "," -
Ident 2:5-2:6 "x" -
Assign 2:7-2:9 ":=" -
IntLit 2:10-2:11 "1" int 1
Rparen 2:11-2:12 ")" -
Newline 2:12-3:1 "\n" -
Eof 3:1-3:1 "" -
--- stderr
