$ $PST tokens lexer.Layout.test_end_marker.pst
exit 0
--- stdout
KwFunction 1:1-1:9 "function" -
Ident 1:10-1:11 "f" -
Lparen 1:11-1:12 "(" -
Rparen 1:12-1:13 ")" -
Colon 1:13-1:14 ":" -
Ident 1:15-1:18 "Int" -
Newline 1:18-2:1 "\n" -
Indent 2:5-2:5 "" -
KwReturn 2:5-2:11 "return" -
IntLit 2:12-2:13 "1" int 1
Newline 2:13-3:1 "\n" -
Dedent 3:1-3:1 "" -
EndMarker 3:1-3:19 "{ end function f }" marker function f
Newline 3:19-3:19 "" -
Eof 3:19-3:19 "" -
--- stderr
