unit Rings

{ A queue in a circular buffer: equal when the same elements are in it, in order. }
type
    export Ring[T] = record
        items: List[T]
        start: Integer

export function ring[T](items: List[T], start: Integer): Ring[T]
    return Ring(items: items, start: start)

function inOrder[T](r: Ring[T]): List[T]
    var out: List[T] := []
    for i := 0 to length(r.items) - 1 do
        add(var out, r.items[(r.start + i) mod length(r.items)])
    return out

export operator function equals[T: Equatable](a, b: Ring[T]): Boolean
    return inOrder(a) = inOrder(b)

operator procedure hash[T: Hashable](var h: Hasher, r: Ring[T])
    for x in inOrder(r) do
        combine(var h, x)

type
    export Version = record
        export major: Integer
        export minor: Integer
        export note: String

{ Equal when `compare` says so: the note doesn't count. }
operator function compare(a, b: Version): Order
    if a.major < b.major or (a.major = b.major and a.minor < b.minor) then
        return Order.Less
    if a.major = b.major and a.minor = b.minor then
        return Order.Equal
    return Order.Greater

operator procedure hash(var h: Hasher, v: Version)
    combine(var h, v.major)
    combine(var h, v.minor)
