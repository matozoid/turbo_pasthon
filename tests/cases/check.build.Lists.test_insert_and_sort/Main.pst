program Main

uses IO

type
    P = record
        k: Integer
        name: String

function byK(a, b: P): Boolean
    return a.k < b.k

var xs := [5, 3, 9, 1, 3, 7, 2, 8, 0]
let before := xs
sort(var xs)
for x in xs do
    write("{x} ")
writeln(len(before))
var ss := ["pear", "apple", "fig", "b"]
sort(var ss)
for s in ss do
    write("{s} ")
writeln()
var ps := [P(k: 2, name: "a"), P(k: 1, name: "b"), P(k: 2, name: "c"), P(k: 1, name: "d")]
sort(var ps, less: byK)
for q in ps do
    write(q.name)
writeln()
var e: List[String] := []
sort(var e)
insert(var e, 0, x: "c")
insert(var e, 0, x: "a")
insert(var e, 2, x: "d")
insert(var e, 1, x: "b")
for s in e do
    write(s)
writeln()
