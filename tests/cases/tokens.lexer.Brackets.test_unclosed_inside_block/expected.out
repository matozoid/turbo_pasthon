$ $PST tokens lexer.Brackets.test_unclosed_inside_block.pst
exit 1
--- stdout
KwIf 1:1-1:3 "if" -
Ident 1:4-1:5 "a" -
KwThen 1:6-1:10 "then" -
Newline 1:10-2:1 "\n" -
Indent 2:5-2:5 "" -
Ident 2:5-2:6 "f" -
Lparen 2:6-2:7 "(" -
Ident 2:7-2:8 "x" -
Newline 2:8-3:1 "\n" -
KwReturn 3:5-3:11 "return" -
IntLit 3:12-3:13 "1" int 1
Newline 3:13-4:1 "\n" -
Dedent 4:1-4:1 "" -
Eof 4:1-4:1 "" -
error E0009 2:6-2:7 "unclosed '('"
  fix "insert ')'"
    edit 2:8-2:8 ")"
--- stderr
