$ $PST tokens lexer.Layout.test_double_indent.pst
exit 1
--- stdout
KwIf 1:1-1:3 "if" -
Ident 1:4-1:5 "a" -
KwThen 1:6-1:10 "then" -
Newline 1:10-2:1 "\n" -
Indent 2:9-2:9 "" -
Ident 2:9-2:10 "b" -
Newline 2:10-3:1 "\n" -
Dedent 3:1-3:1 "" -
Eof 3:1-3:1 "" -
error E0003 2:1-2:9 "indentation increases by 8 spaces; one level is 4"
--- stderr
