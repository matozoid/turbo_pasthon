program Main

uses IO, C

extern "libm.so.6"
    function pow(x: CDouble, y: CDouble): CDouble
    function ldexp(x: CDouble, e: CInt): CDouble

extern "libc.so.6"
    function printf(fmt: CString, ...): CInt

let nan := 0.0 / 0.0
writeln("{0.1} {2.0} {-0.0} {1.0e20} {1.5e-7} {123.456} {1.0 / 3.0} {1.0 / 0.0} {-1.0 / 0.0} {nan}")
writeln("{0.1 + 0.2} {1.7976931348623157e308} {4.9e-324} {100.0} {1.0e16} {1.0e15}")
writeln([1.5, 2.0])
writeln(pow(2.0, y: 10.0))
writeln(ldexp(3.0, e: 4))
unsafe procedure show()
    _ := printf(toCString("%d %.3f %s %.1f\n"), CInt(7), 3.14159, toCString("x"), 2.25)
show()
writeln("{1500.0} {1.0e15} {9.999999999999998e15} {1.0e16} {0.0001} {0.00001} {123456789.125} {-2.5e-5}")
