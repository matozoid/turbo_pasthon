program Main

uses IO

type
    Digit = '0'..'9'
    Small = -5..5
    Big = 0..300

let a: BitSet[Digit] := []
let b: BitSet[Small] := []
let c: BitSet[Real] := []
let d: BitSet[Char] := []
let e: BitSet[Big] := []
let g: BitSet[Boolean] := BitSet(words: [])
writeln("{length(a)} {length(b)} {length(c)} {length(d)} {length(e)} {length(g)}")
