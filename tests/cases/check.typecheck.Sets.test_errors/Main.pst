program Main

uses IO

type
    Color = (Red, Green)

let a: BitSet[Color] := [Red, Purple]
let c: BitSet[Byte] := [1]
let xs := [1..3]
let ch := 'x'
writeln(a < a)
writeln(a + c)
writeln(a / a)
writeln(Red in a)
writeln(ch in ['a'..'z'])
writeln(xs)
writeln(a or a)
writeln(a and a)
writeln(a xor a)
let h: Set[Byte] := [1..3]
let r: Set[Real] := []
writeln(h + c)
