program Main

uses IO, C

extern "libc.so.6"
    type
        export Pair = record
            a: CInt
            b: CInt
    procedure take(f: function(CDouble): CInt)
    procedure give(f: function(Pair): CInt)

function half(x: CDouble): CInt
    return 0

function first(p: Pair): CInt
    return p.a

unsafe procedure demo()
    let h := half
    take(h)
    give(first)
demo()
