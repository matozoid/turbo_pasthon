$ $PST tokens lexer.Strings.test_unclosed_placeholder.pst
exit 1
--- stdout
Ident 1:1-1:2 "s" -
Assign 1:3-1:5 ":=" -
StringBegin 1:6-1:9 "\"a{" text "a"
Ident 1:9-1:10 "x" -
StringEnd 1:10-1:10 "" text ""
Newline 1:10-2:1 "\n" -
Ident 2:1-2:2 "y" -
Newline 2:2-3:1 "\n" -
Eof 3:1-3:1 "" -
error E0030 1:10-1:10 "string placeholder '{' is not closed on this line; write '\\{' for a literal brace"
--- stderr
