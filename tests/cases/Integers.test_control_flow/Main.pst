program Main

uses IO

var total := 0
for i := 1 to 10 do
    if i mod 2 = 0 then
        continue
    total := total + i
for i := 3 downto 1 do
    write(i)
for i := 5 to 4 do
    write("never")
for i := 9223372036854775806 to 9223372036854775807 do
    write(".")
writeln(" {total}")
var n := 0
while true do
    inc(var n)
    if n = 4 then
        break
repeat
    dec(var n, 2)
until n < 0
if n = 0 then
    writeln("zero")
else if n = -2 then
    writeln("minus two")
else
    writeln("other")
case n of
    0: writeln("zero")
    else: pass
if n > 0 then
    pass
