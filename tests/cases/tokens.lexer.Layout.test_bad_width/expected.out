$ $PST tokens lexer.Layout.test_bad_width.pst
exit 1
--- stdout
KwIf 1:1-1:3 "if" -
Ident 1:4-1:5 "a" -
KwThen 1:6-1:10 "then" -
Newline 1:10-2:1 "\n" -
Indent 2:4-2:4 "" -
Ident 2:4-2:5 "b" -
Newline 2:5-3:1 "\n" -
Dedent 3:1-3:1 "" -
Eof 3:1-3:1 "" -
error E0002 2:1-2:4 "indentation of 3 spaces is not a multiple of 4"
--- stderr
