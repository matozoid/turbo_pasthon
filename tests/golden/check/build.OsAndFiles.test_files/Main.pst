program Main

uses IO

let dir := "/tmp/tmpktdi783b/tmp83bj17sx"
case create("{dir}/text") of
    Ok(f):
        _ := writeAll(f.value, "héllo\nworld\n")
        case close(f.value) of
            Ok(_):
                writeln(close(f.value).isErr())
            Err(e):
                writeln(e.error)
    Err(e):
        writeln(e.error)
case open("{dir}/text") of
    Ok(f):
        case readAll(f.value) of
            Ok(t):
                write(t.value)
            Err(e):
                writeln(e.error)
    Err(e):
        writeln(e.error)
case create("{dir}/bin", 0o755) of
    Ok(f):
        _ := writeBytes(f.value, [Byte(0), Byte(1), Byte(255)])
    Err(e):
        writeln(e.error)
case open("{dir}/bin") of
    Ok(f):
        case readBytes(f.value) of
            Ok(b):
                for x in b.value do
                    write("{x} ")
                writeln()
            Err(e):
                writeln(e.error)
    Err(e):
        writeln(e.error)
case open("{dir}/missing") of
    Ok(_):
        writeln("found")
    Err(e):
        writeln(e.error)
