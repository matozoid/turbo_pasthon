KwProgram 1:1-1:8 "program" -
Ident 1:9-1:10 "P" -
Newline 1:10-2:1 "\n" -
Indent 2:2-2:2 "" -
Ident 2:2-2:3 "x" -
Assign 2:4-2:6 ":=" -
IntLit 2:7-2:8 "1" int 1
Newline 2:8-3:1 "\n" -
Dedent 3:1-3:1 "" -
KwIf 3:1-3:3 "if" -
Ident 3:4-3:5 "a" -
KwThen 3:6-3:10 "then" -
Newline 3:10-4:1 "\n" -
Indent 4:4-4:4 "" -
Ident 4:4-4:5 "b" -
Newline 4:5-5:1 "\n" -
Dedent 5:1-5:1 "" -
Eof 5:1-5:1 "" -
error E0001 2:1-2:2 "tab character; indent with 4 spaces"
  fix "replace tab with 4 spaces"
    edit 2:1-2:2 "    "
error E0001 4:3-4:4 "tab character; indent with 4 spaces"
  fix "replace tab with 4 spaces"
    edit 4:3-4:4 "    "
error E0002 4:1-4:4 "indentation of 6 spaces is not a multiple of 4"
error E0003 4:1-4:4 "indentation increases by 6 spaces; one level is 4"
