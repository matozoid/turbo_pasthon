unit System

{ The core unit. Every file uses it implicitly (SPEC §3.5).

  Provided by the compiler, not declared here: the primitive types Int8, Int16, Int32,
  Int64, UInt8, UInt16, UInt32, UInt64, Real32, Real64, Boolean, Char, String; the
  generic types List[T], Array[T, N], Weak[T]; and the traits
  Equatable, Ordered, Hashable, Ordinal, Sendable. Routines in `extern "pst"` blocks are
  implemented by the compiler. }

type
    { Signed 64-bit integer. }
    export Integer = Int64
    { IEEE-754 64-bit floating point. }
    export Real = Real64
    export Byte = UInt8

    { A present value. }
    export Some[T] = record
        export value: T
    { No value. }
    export None = record
    export Option[T] = Some[T] | None

    { A successful result. }
    export Ok[T] = record
        export value: T
    { A failed result. }
    export Err[E] = record
        export error: E
    export Result[T, E] = Ok[T] | Err[E]

    { A type with a text form. }
    export Printable = trait
        function toString(this): String

    { A source of values, read with `next` (SPEC §4.14). }
    export Iterator[T] = trait
        function next(var this): Option[T]

    { Two values side by side, yielded by `zip`. }
    export Pair[A, B] = record
        export first: A
        export second: B

    { A value and its position, yielded by `enumerate`. }
    export Indexed[T] = record
        export index: Integer
        export value: T

    { One map entry, yielded by `entries`. }
    export Entry[K, V] = record
        export key: K
        export value: V

    { A hash map (SPEC §4.5), written `[k: v]`. Entry `i` is `keys[i]`, `values[i]` and
      `hashes[i]`, in insertion order. A removed entry stays, with hash -1 and its key
      and value emptied, until `rehash` drops it. `slots` is the hash table: open
      addressing with linear probing over a power-of-2 length; 0 is a free slot, any
      other `s` refers to entry `s - 1`. }
    export Map[K: Hashable, V] = record
        keys: List[K]
        values: List[V]
        hashes: List[Integer]
        slots: List[Integer]
        count: Integer  { entries not removed }

    { A set (SPEC §4.5), written `[a, b]`: the keys of a map whose values are all `true`.
      Its order is unspecified; for now it is insertion order. }
    export Set[T: Hashable] = record
        items: Map[T, Boolean]

    { A set of ordinal values (SPEC §4.5), written `[a, b]`: 256 bits in 4 words, one
      per possible element. Element `x` is bit `bitOf(x)`. }
    export BitSet[T] = record
        words: List[Integer]

    export SetIter[T: Hashable] = record
        keys: KeyIter[T, Boolean]

    export BitSetIter[T] = record
        source: BitSet[T]
        pos: Integer

    export KeyIter[K: Hashable, V] = record
        source: Map[K, V]
        pos: Integer

    export EntryIter[K: Hashable, V] = record
        source: Map[K, V]
        pos: Integer

    export ListIter[T] = record
        items: List[T]
        pos: Integer

    export ArrayIter[T, N: Integer] = record
        items: Array[T, N]
        pos: Integer

    export CharIter = record
        text: String
        pos: Integer

    export TakeIter[I] = record
        source: I
        left: Integer

    export SkipIter[I] = record
        source: I
        left: Integer

    export ZipIter[I, J] = record
        a: I
        b: J

    export EnumerateIter[I] = record
        source: I
        index: Integer

external "pst"
    { Number of elements. }
    export function length[T](xs: List[T]): Integer
    export function length[T, N: Integer](a: Array[T, N]): Integer

    { Adds 1 (or `n`) to an integer or enum variable. }
    export procedure inc[T](var x: T)
    export procedure inc[T](var x: T, n: Integer)
    { Subtracts 1 (or `n`) from an integer or enum variable. }
    export procedure dec[T](var x: T)
    export procedure dec[T](var x: T, n: Integer)
    { The position of an enum member, or the code point of a Char. }
    export function ord[T](x: T): Integer

    { Allocates `value` on the heap. }
    export function new[T](value: T): ref T
    { A non-owning reference to `r`. }
    export function weak[T](r: ref T): Weak[T]

    export function toString(x: Integer): String
    export function toString(x: Real): String
    export function toString(x: Real32): String
    export function toString(x: Boolean): String
    export function toString(x: Char): String
    export function toString(x: String): String

    { Converts an integer to a real. }
    export function toReal(x: Integer): Real
    { Converts a real to an integer, truncating toward zero. }
    export function toInt(x: Real): Integer
    { Rounds a real to the nearest integer. }
    export function round(x: Real): Integer

    { Exits immediately with status `code`. Deferred statements do not run. }
    export procedure halt(code: Integer)

    { Panics with `message`, which starts with the panic code. }
    function fail[T](message: String): T
    function byteLen(s: String): Integer
    function charCount(s: String): Integer
    function decodeUtf8At(s: String, pos: Integer): Char
    function utf8Width(c: Char): Integer
    { Makes `xs` unshared and `n` long (`n >= 0`). New elements are empty, not values
      of `T`: the caller must fill them in before anything reads them. }
    procedure resize[T](var xs: List[T], n: Integer)
    { Makes `xs` unshared and element `i` empty, releasing its value. }
    procedure vacate[T](var xs: List[T], i: Integer)
    { A hash of `x`, not negative. Equal values have equal hashes. }
    export function hash[T: Hashable](x: T): Integer
    { The bit of a BitSet element: `ord(x)` minus the `ord` of the first value of `T`. }
    function bitOf[T](x: T): Integer
    { The BitSet element whose bit is `i`. }
    function ofBit[T](i: Integer): T
    { As in Bits. }
    function popCount[T](a: T): Integer
    { Whether the box that `w` refers to still has strong references. }
    function alive[T](w: Weak[T]): Boolean
    { The box that `w` refers to; it must be `alive`. }
    function target[T](w: Weak[T]): ref T

{ ---------------------------------------------------------------------- lists }

{ Appends `x` to the end of `xs`. }
export procedure add[T](var xs: List[T], x: T)
    let n := length(xs)
    resize(var xs, n + 1)
    xs[n] := x

{ Removes the element at `index`, moving the ones after it down. }
export procedure remove[T](var xs: List[T], index: Integer)
    _ := xs[index]  { P0001 if there is no such element }
    let n := length(xs)
    for i := index to n - 2 do
        xs[i] := xs[i + 1]
    resize(var xs, n - 1)

{ Removes the last element (`P0001` if there is none). }
export procedure removeLast[T](var xs: List[T])
    let n := length(xs)
    _ := xs[n - 1]  { P0001 if there is no such element }
    resize(var xs, n - 1)

{ Inserts `x` at `index`, moving the elements from there up. `index` may be `length(xs)`,
  which appends. }
export procedure insert[T](var xs: List[T], index: Integer, x: T)
    let n := length(xs)
    if index <> n then
        _ := xs[index]  { P0001 if there is no such position }
    resize(var xs, n + 1)
    for i := n downto index + 1 do
        xs[i] := xs[i - 1]
    xs[index] := x

{ Sorts `xs` into ascending order. Equal elements keep their order. A merge sort:
  O(n log n) comparisons. }
export procedure sort[T: Ordered](var xs: List[T])
    let n := length(xs)
    var src := xs
    var dst := xs
    var width := 1
    while width < n do
        var lo := 0
        while lo < n do
            let mid := min(lo + width, n)
            let hi := min(lo + 2 * width, n)
            var i := lo
            var j := mid
            for k := lo to hi - 1 do
                if j < hi and (i >= mid or src[j] < src[i]) then
                    dst[k] := src[j]
                    j := j + 1
                else
                    dst[k] := src[i]
                    i := i + 1
            lo := hi
        let t := src
        src := dst
        dst := t
        width := 2 * width
    xs := src

{ Sorts `xs` so that no element is `less` than one before it, as the other `sort` does. }
export procedure sort[T](var xs: List[T], less: function(T, T): Boolean)
    let n := length(xs)
    var src := xs
    var dst := xs
    var width := 1
    while width < n do
        var lo := 0
        while lo < n do
            let mid := min(lo + width, n)
            let hi := min(lo + 2 * width, n)
            var i := lo
            var j := mid
            for k := lo to hi - 1 do
                if j < hi and (i >= mid or less(src[j], src[i])) then
                    dst[k] := src[j]
                    j := j + 1
                else
                    dst[k] := src[i]
                    i := i + 1
            lo := hi
        let t := src
        src := dst
        dst := t
        width := 2 * width
    xs := src

{ Sorts `xs` by the `key` of each element, ascending, as the other `sort` does. Each
  key is computed once. }
export procedure sort[T, K: Ordered](var xs: List[T], key: function(T): K)
    let n := length(xs)
    var src := xs
    var dst := xs
    var srcKeys := for x in xs do key(x)
    var dstKeys := srcKeys
    var width := 1
    while width < n do
        var lo := 0
        while lo < n do
            let mid := min(lo + width, n)
            let hi := min(lo + 2 * width, n)
            var i := lo
            var j := mid
            for k := lo to hi - 1 do
                if j < hi and (i >= mid or srcKeys[j] < srcKeys[i]) then
                    dst[k] := src[j]
                    dstKeys[k] := srcKeys[j]
                    j := j + 1
                else
                    dst[k] := src[i]
                    dstKeys[k] := srcKeys[i]
                    i := i + 1
            lo := hi
        let t := src
        src := dst
        dst := t
        let tk := srcKeys
        srcKeys := dstKeys
        dstKeys := tk
        width := 2 * width
    xs := src

function min(a, b: Integer): Integer
    if a < b then
        return a
    return b

{ A new list: `a` followed by `b`. }
export function concat[T](a, b: List[T]): List[T]
    var out := a
    let n := length(a)
    resize(var out, n + length(b))
    for i := 0 to length(b) - 1 do
        out[n + i] := b[i]
    return out

{ `x in xs`. }
function contains[T: Equatable](x: T, xs: List[T]): Boolean
    for y in xs do
        if y = x then
            return true
    return false

{ The items as `[a, b]`, each by its `toString`. }
export function toString[T: Printable](xs: List[T]): String
    var s := "["
    for i := 0 to length(xs) - 1 do
        if i > 0 then
            s := "{s}, "
        s := "{s}{xs[i]}"
    return "{s}]"

{ `s` padded with spaces to `width` characters: in front when `width` is positive, after
  it when negative, as `{x:8}` and `{x:-8}` do. A longer `s` stays as it is. }
export function justify(s: String, width: Integer): String
    var n := width
    if n < 0 then
        n := -n
    var pad := ""
    for i := charCount(s) + 1 to n do
        pad := "{pad} "
    if width < 0 then
        return "{s}{pad}"
    return "{pad}{s}"

{ ----------------------------------------------------------------------- maps }

{ Number of entries. }
export function length[K: Hashable, V](m: Map[K, V]): Integer
    return m.count

{ The value of `key`, if present. }
export function get[K: Hashable, V](m: Map[K, V], key: K): Option[V]
    let e := find(m, key)
    if e < 0 then
        return None
    return Some(m.values[e])

{ The value of `key`, or `default` if it is missing. }
export function getOr[K: Hashable, V](m: Map[K, V], key: K, default: V): V
    let e := find(m, key)
    if e < 0 then
        return default
    return m.values[e]

{ The entries as `[k: v]`, in insertion order, each by its `toString`; `[:]` when empty. }
export function toString[K: Hashable + Printable, V: Printable](m: Map[K, V]): String
    if m.count = 0 then
        return "[:]"
    var out := "["
    var first := true
    for k, v in m do
        if not first then
            out := "{out}, "
        out := "{out}{k}: {v}"
        first := false
    return "{out}]"

{ Removes `key` from the map, if present. }
export procedure remove[K: Hashable, V](var m: Map[K, V], key: K)
    let e := find(m, key)
    if e < 0 then
        return
    m.hashes[e] := -1
    vacate(var m.keys, e)
    vacate(var m.values, e)
    dec(var m.count)

{ `[:]`. }
function emptyMap[K: Hashable, V](): Map[K, V]
    return Map(keys: [], values: [], hashes: [], slots: [], count: 0)

{ `m[key] := value`. }
procedure put[K: Hashable, V](var m: Map[K, V], key: K, value: V)
    m.values[entryOf(var m, key, true)] := value

{ `key in m`. }
function containsKey[K: Hashable, V](key: K, m: Map[K, V]): Boolean
    return find(m, key) >= 0

{ The entry of `key`, or -1. }
function find[K: Hashable, V](m: Map[K, V], key: K): Integer
    if m.count = 0 then
        return -1
    return m.slots[slotOf(m, key, hash(key))] - 1  { a free slot (0) gives -1 }

{ The entry of `key`. If there is none: -1, or with `insert` a new entry whose value is
  empty, for the caller to fill in. }
function entryOf[K: Hashable, V](var m: Map[K, V], key: K, insert: Boolean): Integer
    let h := hash(key)
    if m.count > 0 then
        let s := m.slots[slotOf(m, key, h)]
        if s > 0 or not insert then
            return s - 1
    else if not insert then
        return -1
    if (length(m.keys) + 1) * 4 > length(m.slots) * 3 then
        rehash(var m)
    let e := length(m.keys)
    add(var m.keys, key)
    add(var m.hashes, h)
    resize(var m.values, e + 1)
    m.slots[slotOf(m, key, h)] := e + 1
    inc(var m.count)
    return e

{ The slot of `key`, whose hash is `h`: the one referring to its entry, or else the free
  one where probing for it stops. A removed entry's slot stays taken, so probing goes
  on past it; its hash (-1) matches no key's. }
function slotOf[K: Hashable, V](m: Map[K, V], key: K, h: Integer): Integer
    let n := length(m.slots)
    var i := h mod n
    while m.slots[i] <> 0 do
        let e := m.slots[i] - 1
        if m.hashes[e] = h and m.keys[e] = key then
            return i
        i := (i + 1) mod n
    return i

{ Drops the removed entries, and rebuilds the table at most 3/8 full, so that it can
  grow by as many entries again before the next rehash (at 3/4 full). }
procedure rehash[K: Hashable, V](var m: Map[K, V])
    var keys: List[K] := []
    var values: List[V] := []
    var hashes: List[Integer] := []
    for e := 0 to length(m.keys) - 1 do
        if m.hashes[e] >= 0 then
            add(var keys, m.keys[e])
            add(var values, m.values[e])
            add(var hashes, m.hashes[e])
    var n := 8
    while n * 3 < (length(keys) + 1) * 8 do
        n := n * 2
    var slots: List[Integer] := []
    resize(var slots, n)  { all 0: free }
    for e := 0 to length(keys) - 1 do
        var i := hashes[e] mod n
        while slots[i] <> 0 do
            i := (i + 1) mod n
        slots[i] := e + 1
    m := Map(keys: keys, values: values, hashes: hashes, slots: slots, count: length(keys))

{ `a = b`: the same keys, with equal values, in any order. Called by the runtime's `=`. }
function mapEquals[K: Hashable, V: Equatable](a, b: Map[K, V]): Boolean
    if a.count <> b.count then
        return false
    for e := 0 to length(a.keys) - 1 do
        if a.hashes[e] >= 0 then
            let f := find(b, a.keys[e])
            if f < 0 or b.values[f] <> a.values[e] then
                return false
    return true

{ ----------------------------------------------------------------------- sets }

{ Number of elements. }
export function length[T: Hashable](s: Set[T]): Integer
    return length(s.items)

{ Adds `x` to the set, if it isn't in it yet. }
export procedure add[T: Hashable](var s: Set[T], x: T)
    s.items[x] := true

{ Removes `x` from the set, if present. }
export procedure remove[T: Hashable](var s: Set[T], x: T)
    remove(var s.items, x)

{ `a + b`: the elements in `a`, in `b`, or in both. }
function union[T: Hashable](a, b: Set[T]): Set[T]
    var s := a
    for x in b do
        add(var s, x)
    return s

{ `a * b`: the elements in both `a` and `b`. }
function intersection[T: Hashable](a, b: Set[T]): Set[T]
    var s := emptySet[T]()
    for x in a do
        if x in b.items then
            add(var s, x)
    return s

{ `a - b`: the elements in `a` but not in `b`. }
function difference[T: Hashable](a, b: Set[T]): Set[T]
    var s := emptySet[T]()
    for x in a do
        if not (x in b.items) then
            add(var s, x)
    return s

{ `a <= b`: whether every element of `a` is in `b`. }
function subset[T: Hashable](a, b: Set[T]): Boolean
    for x in a do
        if not (x in b.items) then
            return false
    return true

{ `a >= b`: whether every element of `b` is in `a`. }
function superset[T: Hashable](a, b: Set[T]): Boolean
    return subset(b, a)

{ The elements as `[a, b]`, in iteration order, each by its `toString`. }
export function toString[T: Hashable + Printable](s: Set[T]): String
    var out := "["
    for x in s do
        if out <> "[" then
            out := "{out}, "
        out := "{out}{x}"
    return "{out}]"

{ `[]` as a set. }
function emptySet[T: Hashable](): Set[T]
    return Set(items: [:])

{ `[a, b]` as a set adds its elements with this; `add` is overloaded. }
procedure include[T: Hashable](var s: Set[T], x: T)
    add(var s, x)

{ `x in s`. }
function includes[T: Hashable](x: T, s: Set[T]): Boolean
    return x in s.items

{ ------------------------------------------------------------------- bit sets }

{ Number of elements. }
export function length[T](s: BitSet[T]): Integer
    var n := 0
    for w in s.words do
        n := n + popCount(w)
    return n

{ Adds `x` to the set. }
export procedure add[T](var s: BitSet[T], x: T)
    includeBit(var s, x)

{ Removes `x` from the set, if present. }
export procedure remove[T](var s: BitSet[T], x: T)
    let b := bitOf(x)
    s.words[b div 64] := s.words[b div 64] and not (1 shl (b mod 64))

{ `a + b`: the elements in `a`, in `b`, or in both. }
function bitUnion[T](a, b: BitSet[T]): BitSet[T]
    var s := a
    for i := 0 to 3 do
        s.words[i] := a.words[i] or b.words[i]
    return s

{ `a * b`: the elements in both `a` and `b`. }
function bitIntersection[T](a, b: BitSet[T]): BitSet[T]
    var s := a
    for i := 0 to 3 do
        s.words[i] := a.words[i] and b.words[i]
    return s

{ `a - b`: the elements in `a` but not in `b`. }
function bitDifference[T](a, b: BitSet[T]): BitSet[T]
    var s := a
    for i := 0 to 3 do
        s.words[i] := a.words[i] and not b.words[i]
    return s

{ `a <= b`: whether every element of `a` is in `b`. }
function bitSubset[T](a, b: BitSet[T]): Boolean
    for i := 0 to 3 do
        if (a.words[i] and not b.words[i]) <> 0 then
            return false
    return true

{ `a >= b`: whether every element of `b` is in `a`. }
function bitSuperset[T](a, b: BitSet[T]): Boolean
    return bitSubset(b, a)

{ The elements as `[a, b]`, in `ord` order, each by its `toString`. }
export function toString[T: Printable](s: BitSet[T]): String
    var out := "["
    for x in s do
        if out <> "[" then
            out := "{out}, "
        out := "{out}{x}"
    return "{out}]"

{ `[]` as a BitSet. }
function emptyBitSet[T](): BitSet[T]
    return BitSet(words: [0, 0, 0, 0])

{ `[a, b]` as a BitSet adds its elements with this; `add` is overloaded. }
procedure includeBit[T](var s: BitSet[T], x: T)
    let b := bitOf(x)
    s.words[b div 64] := s.words[b div 64] or (1 shl (b mod 64))

{ `[low..high]` as a BitSet adds the elements from `low` to `high` with this. }
procedure includeBitRange[T](var s: BitSet[T], low, high: T)
    for b := bitOf(low) to bitOf(high) do
        s.words[b div 64] := s.words[b div 64] or (1 shl (b mod 64))

{ `x in s`. }
function includesBit[T](x: T, s: BitSet[T]): Boolean
    let b := bitOf(x)
    return (s.words[b div 64] and (1 shl (b mod 64))) <> 0

{ ----------------------------------------------------------------------- refs }

{ The referenced value, unless the last strong reference to it went away. }
export function get[T](w: Weak[T]): Option[ref T]
    if alive(w) then
        return Some(target(w))
    return None

{ ---------------------------------------------------------- Option and Result }

export function isSome[T](o: Option[T]): Boolean
    return case o of
        Some(_): true
        None: false

export function isNone[T](o: Option[T]): Boolean
    return not isSome(o)

export function isOk[T, E](r: Result[T, E]): Boolean
    return case r of
        Ok(_): true
        Err(_): false

export function isErr[T, E](r: Result[T, E]): Boolean
    return not isOk(r)

{ The value; panics with `P0005` on `None`. }
export function get[T](o: Option[T]): T
    return case o of
        Some(s): s.value
        None: fail[T]("P0005: get on None")

{ The value; panics with `P0005` on `Err`. }
export function get[T, E](r: Result[T, E]): T
    return case r of
        Ok(v): v.value
        Err(_): fail[T]("P0005: get on Err")

{ The value, or `default` on `None`. }
export function getOr[T](o: Option[T], default: T): T
    return case o of
        Some(s): s.value
        None: default

{ The value, or `default` on `Err`. }
export function getOr[T, E](r: Result[T, E], default: T): T
    return case r of
        Ok(v): v.value
        Err(_): default

{ `Some(x)` or `None`, the value by its `toString`. }
export function toString[T: Printable](o: Option[T]): String
    return case o of
        Some(s): "Some({s.value})"
        None: "None"

{ `Ok(x)` or `Err(e)`, the value or error by its `toString`. }
export function toString[T: Printable, E: Printable](r: Result[T, E]): String
    return case r of
        Ok(v): "Ok({v.value})"
        Err(e): "Err({e.error})"

{ ------------------------------------------------------------------ iterators }

export function iter[T](xs: List[T]): ListIter[T]
    return ListIter(items: xs, pos: 0)

export function next[T](var it: ListIter[T]): Option[T]
    if it.pos >= length(it.items) then
        return None
    let x := it.items[it.pos]
    inc(var it.pos)
    return Some(x)

export function iter[T, N: Integer](xs: Array[T, N]): ArrayIter[T, N]
    return ArrayIter(items: xs, pos: 0)

export function next[T, N: Integer](var it: ArrayIter[T, N]): Option[T]
    if it.pos >= length(it.items) then
        return None
    let x := it.items[it.pos]
    inc(var it.pos)
    return Some(x)

{ The elements of a set, in an unspecified order. }
export function iter[T: Hashable](s: Set[T]): SetIter[T]
    return SetIter(keys: iter(s.items))

export function next[T: Hashable](var it: SetIter[T]): Option[T]
    return next(var it.keys)

{ The elements of a BitSet, in `ord` order. }
export function iter[T](s: BitSet[T]): BitSetIter[T]
    return BitSetIter(source: s, pos: 0)

export function next[T](var it: BitSetIter[T]): Option[T]
    while it.pos < 256 do
        inc(var it.pos)
        let b := it.pos - 1
        if (it.source.words[b div 64] and (1 shl (b mod 64))) <> 0 then
            return Some(ofBit[T](b))
    return None

{ The keys of a map, in insertion order. }
export function iter[K: Hashable, V](m: Map[K, V]): KeyIter[K, V]
    return KeyIter(source: m, pos: 0)

export function next[K: Hashable, V](var it: KeyIter[K, V]): Option[K]
    while it.pos < length(it.source.keys) do
        inc(var it.pos)
        if it.source.hashes[it.pos - 1] >= 0 then
            return Some(it.source.keys[it.pos - 1])
    return None

{ The entries of a map, in insertion order. }
export function entries[K: Hashable, V](m: Map[K, V]): EntryIter[K, V]
    return EntryIter(source: m, pos: 0)

export function next[K: Hashable, V](var it: EntryIter[K, V]): Option[Entry[K, V]]
    while it.pos < length(it.source.keys) do
        inc(var it.pos)
        let e := it.pos - 1
        if it.source.hashes[e] >= 0 then
            return Some(Entry(key: it.source.keys[e], value: it.source.values[e]))
    return None

{ The characters of a string. }
export function chars(s: String): CharIter
    return CharIter(text: s, pos: 0)

export function iter(s: String): CharIter
    return chars(s)

export function next(var it: CharIter): Option[Char]
    if it.pos >= byteLen(it.text) then
        return None
    let c := decodeUtf8At(it.text, it.pos)
    it.pos := it.pos + utf8Width(c)
    return Some(c)

{ Yields the first `n` values. }
export function take[T, I: Iterator[T]](it: I, n: Integer): TakeIter[I]
    return TakeIter(source: it, left: n)

export function next[T, I: Iterator[T]](var it: TakeIter[I]): Option[T]
    if it.left <= 0 then
        return None
    dec(var it.left)
    return next(var it.source)

{ Yields all but the first `n` values. }
export function skip[T, I: Iterator[T]](it: I, n: Integer): SkipIter[I]
    return SkipIter(source: it, left: n)

export function next[T, I: Iterator[T]](var it: SkipIter[I]): Option[T]
    while it.left > 0 do
        dec(var it.left)
        if isNone(next(var it.source)) then
            return None
    return next(var it.source)

{ Yields pairs until either side ends. }
export function zip[A, B, I: Iterator[A], J: Iterator[B]](a: I, b: J): ZipIter[I, J]
    return ZipIter(a: a, b: b)

export function next[A, B, I: Iterator[A], J: Iterator[B]](
    var it: ZipIter[I, J],
): Option[Pair[A, B]]
    let x := next(var it.a)
    let y := next(var it.b)
    if isNone(x) or isNone(y) then
        return None
    return Some(Pair(first: get(x), second: get(y)))

{ Yields each value with its position, starting at 0. }
export function enumerate[T, I: Iterator[T]](it: I): EnumerateIter[I]
    return EnumerateIter(source: it, index: 0)

export function next[T, I: Iterator[T]](var it: EnumerateIter[I]): Option[Indexed[T]]
    case next(var it.source) of
        Some(s):
            inc(var it.index)
            return Some(Indexed(index: it.index - 1, value: s.value))
        None: return None

{ ------------------------------------------------------------------ consumers }

{ All values, in order. }
export function collect[T, I: Iterator[T]](it: I): List[T]
    var out: List[T] := []
    for x in it do
        add(var out, x)
    return out

{ Number of values. }
export function count[T, I: Iterator[T]](it: I): Integer
    var n := 0
    for _ in it do
        inc(var n)
    return n

{ Sum of the values. }
export function sum[I: Iterator[Integer]](it: I): Integer
    var total := 0
    for x in it do
        total := total + x
    return total

export function sum[I: Iterator[Real]](it: I): Real
    var total := 0.0
    for x in it do
        total := total + x
    return total

{ Whether `pred` holds for some value. }
export function any[T, I: Iterator[T]](it: I, pred: function(T): Boolean): Boolean
    for x in it do
        if pred(x) then
            return true
    return false

{ Whether `pred` holds for every value. }
export function all[T, I: Iterator[T]](it: I, pred: function(T): Boolean): Boolean
    for x in it do
        if not pred(x) then
            return false
    return true

{ The first value where `pred` holds. }
export function find[T, I: Iterator[T]](it: I, pred: function(T): Boolean): Option[T]
    for x in it do
        if pred(x) then
            return Some(x)
    return None

function lessByTens(a, b: Integer): Boolean
    return a div 10 < b div 10

function negated(x: Integer): Integer
    return -x

function tens(x: Integer): Integer
    return x div 10

function isEven(x: Integer): Boolean
    return x mod 2 = 0

test "list editing"
    var xs := [1, 2, 3]
    add(var xs, 4)
    remove(var xs, 0)
    assert xs = [2, 3, 4]
    insert(var xs, 1, x: 9)
    insert(var xs, 4, x: 5)
    assert xs = [2, 9, 3, 4, 5]
    removeLast(var xs)
    assert xs = [2, 9, 3, 4]
    assert concat(xs, b: [1]) = [2, 9, 3, 4, 1]
    assert 9 in xs and not (7 in xs)

test "sort is stable"
    var xs := [5, 3, 9, 1, 3, 0]
    sort(var xs)
    assert xs = [0, 1, 3, 3, 5, 9]
    var ys := [31, 12, 35, 10, 22]
    sort(var ys, less: lessByTens)
    assert ys = [12, 10, 22, 31, 35]
    var zs := [31, 12, 35, 10, 22]
    sort(var zs, key: tens)
    assert zs = [12, 10, 22, 31, 35]
    sort(var zs, key: negated)
    assert zs = [35, 31, 22, 12, 10]
    var empty: List[Integer] := []
    sort(var empty)
    sort(var empty, key: tens)
    assert length(empty) = 0

test "maps"
    var m: Map[String, Integer] := ["a": 1]
    m["b"] := 2
    m["a"] := 3
    assert length(m) = 2
    assert get(m, "a") = Some(3)
    assert get(m, "z").isNone()
    assert getOr(m, "z", default: 7) = 7
    remove(var m, "a")
    remove(var m, "a")
    assert length(m) = 1 and not ("a" in m)

test "sets"
    var s: Set[String] := ["b", "a"]
    add(var s, "c")
    add(var s, "c")
    remove(var s, "x")
    assert length(s) = 3 and "c" in s and not ("x" in s)
    remove(var s, "b")
    let t: Set[String] := ["c", "d"]
    assert s + t = ["d", "c", "a"]
    assert s * t = ["c"]
    assert s - t = ["a"]
    assert ["c"] <= s and s >= ["c"] and not (s <= t)
    let empty: Set[Integer] := []
    assert length(empty) = 0 and toString(empty) = "[]"

test "bit sets"
    var s: BitSet[Byte] := [1, 2]
    add(var s, 3)
    add(var s, 3)
    remove(var s, 1)
    assert length(s) = 2 and 3 in s and not (1 in s)
    let t: BitSet[Byte] := [3, 4]
    assert s + t = [2, 3, 4]
    assert s * t = [3]
    assert s - t = [2]
    assert [3] <= s and s >= [3] and not (s <= t)
    let u: BitSet[Byte] := [4, 0]
    assert toString(u) = "[0, 4]"

test "options and results"
    let some: Option[Integer] := Some(1)
    let none: Option[Integer] := None
    assert some.isSome() and none.isNone()
    assert some.get() = 1 and none.getOr(5) = 5
    let ok: Result[Integer, String] := Ok(2)
    let err: Result[Integer, String] := Err("no")
    assert ok.isOk() and err.isErr()
    assert ok.get() = 2 and err.getOr(6) = 6
    assert "{some} {none} {ok} {err}" = "Some(1) None Ok(2) Err(no)"
    let nested: Option[List[Integer]] := Some([1, 2])
    assert toString(nested) = "Some([1, 2])"

test "iterators"
    let xs := [1, 2, 3, 4]
    assert (for x in xs do x * 2) = [2, 4, 6, 8]
    assert (for x in xs do if isEven(x) then x else continue) = [2, 4]
    assert collect(take(iter(xs), n: 2)) = [1, 2]
    assert collect(skip(iter(xs), n: 3)) = [4]
    assert count(iter(xs)) = 4 and sum(iter(xs)) = 10
    assert any(iter(xs), pred: isEven) and not all(iter(xs), pred: isEven)
    assert find(iter(xs), pred: isEven) = Some(2)
    var n := 0
    for p in enumerate(iter(xs)) do
        n := n + p.index * p.value
    assert n = 20
