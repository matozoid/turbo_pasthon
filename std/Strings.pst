unit Strings

## Text operations. Offsets are byte offsets into the UTF-8 encoding (SPEC §4.5.1).

uses C

extern "pst"
    ## Number of characters (code points). O(1).
    export function charCount(s: String): Integer
    ## Number of bytes. O(1).
    export function byteLen(s: String): Integer
    ## The bytes from `start` up to (not including) `stop`. Panics with `P0006` if an
    ## offset is not on a character boundary.
    export function slice(s: String, start, stop: Integer): String
    export function startsWith(s: String, prefix: String): Boolean

extern "libc.so.6"
    function memmem(hay: Pointer, hayLen: CSize, needle: Pointer, needleLen: CSize): Pointer
    function memcpy(dst: Pointer, src: Pointer, n: CSize): Pointer
    function malloc(size: CSize): Pointer
    procedure free(p: Pointer)
    function strtod(s: CString, end: Pointer): Real
    function snprintf(buf: Pointer, size: CSize, fmt: CString, ...): CInt

## The UTF-8 bytes of a string.
export unsafe function bytes(s: String): List[Byte]
    let p := cast[Ptr[Byte]](toCString(s))
    var r: List[Byte] := []
    var i := 0
    while i < byteLen(s) do
        add(var r, deref(p + i))
        i := i + 1
    return r

## The string with UTF-8 encoding `b`. Invalid UTF-8 is replaced with U+FFFD.
export unsafe function fromBytes(b: List[Byte]): String
    let buf := cast[Ptr[Byte]](malloc(CSize(len(b) + 1)))
    var i := 0
    while i < len(b) do
        deref(buf + i) := b[i]
        i := i + 1
    let r := fromCBytes(cast[Pointer](buf), len(b))
    free(cast[Pointer](buf))
    return r

## Byte offset of the first occurrence of `sub` at or after byte offset `start`.
export unsafe function pos(s: String, sub: String, start: Integer := 0): Option[Integer]
    requires start >= 0 and start <= byteLen(s)
    let p := cast[Ptr[Byte]](toCString(s))
    let q := memmem(
        cast[Pointer](p + start),
        CSize(byteLen(s) - start),
        needle: cast[Pointer](toCString(sub)),
        needleLen: CSize(byteLen(sub)),
    )
    if isNull(q) then
        return None
    return Some(cast[Integer](q) - cast[Integer](p))

## Whether `s` ends with `suffix`.
export function endsWith(s: String, suffix: String): Boolean
    let n := byteLen(s) - byteLen(suffix)
    return n >= 0 and pos(s, sub: suffix, start: n).isSome()

## The parts between occurrences of `sep`.
export function split(s: String, sep: String): List[String]
    requires byteLen(sep) > 0
    var parts: List[String] := []
    var start := 0
    while true do
        case pos(s, sub: sep, start: start) of
            Some(at):
                add(var parts, slice(s, start, at.value))
                start := at.value + byteLen(sep)
            None:
                add(var parts, slice(s, start, byteLen(s)))
                return parts
    return parts

## The parts joined with `sep` between them.
export unsafe function join(parts: List[String], sep: String := ""): String
    var total := 0
    for part in parts do
        total := total + byteLen(part)
    if len(parts) > 0 then
        total := total + byteLen(sep) * (len(parts) - 1)
    let buf := cast[Ptr[Byte]](malloc(CSize(total + 1)))
    var at := 0
    for i := 0 to len(parts) - 1 do
        if i > 0 then
            _ := memcpy(
                cast[Pointer](buf + at),
                src: cast[Pointer](toCString(sep)),
                n: CSize(byteLen(sep)),
            )
            at := at + byteLen(sep)
        let part := parts[i]
        _ := memcpy(
            cast[Pointer](buf + at),
            src: cast[Pointer](toCString(part)),
            n: CSize(byteLen(part)),
        )
        at := at + byteLen(part)
    let r := fromCBytes(cast[Pointer](buf), total)
    free(cast[Pointer](buf))
    return r

const
    MinInt = -9223372036854775807 - 1

function isSpace(b: Byte): Boolean
    return b = 32 or b = 9 or b = 10 or b = 13

## Without leading and trailing whitespace (spaces, tabs, line breaks).
export unsafe function trim(s: String): String
    let p := cast[Ptr[Byte]](toCString(s))
    var start := 0
    var stop := byteLen(s)
    while start < stop and isSpace(deref(p + start)) do
        start := start + 1
    while stop > start and isSpace(deref(p + (stop - 1))) do
        stop := stop - 1
    return slice(s, start, stop)

## Every occurrence of `target` replaced by `replacement`.
export function replace(s: String, target: String, replacement: String): String
    requires byteLen(target) > 0
    return join(split(s, sep: target), sep: replacement)

## The decimal integer `s`: digits with an optional leading `-` or `+`.
export unsafe function parseInt(s: String): Result[Integer, String]
    let p := cast[Ptr[Byte]](toCString(s))
    let n := byteLen(s)
    var i := 0
    var negative := false
    if n > 0 and (deref(p) = 45 or deref(p) = 43) then
        negative := deref(p) = 45
        i := 1
    if i = n then
        return Err("'{s}' is not an integer")
    var value := 0  # accumulated negated, so MinInt fits
    while i < n do
        let d := Integer(deref(p + i)) - 48
        if d < 0 or d > 9 then
            return Err("'{s}' is not an integer")
        if value < (MinInt + d) div 10 then
            return Err("'{s}' doesn't fit in an Integer")
        value := value * 10 - d
        i := i + 1
    if negative then
        return Ok(value)
    if value = MinInt then
        return Err("'{s}' doesn't fit in an Integer")
    return Ok(-value)

## The real written in `s`: an optional sign, digits, optionally a `.` and more digits,
## optionally an exponent (`e` or `E`, an optional sign, digits). Rounds to the nearest
## real; a value too large for `Real` is an error.
export unsafe function parseReal(s: String): Result[Real, String]
    let p := cast[Ptr[Byte]](toCString(s))
    let n := byteLen(s)
    var i := 0
    if n > 0 and (deref(p) = 45 or deref(p) = 43) then
        i := 1
    var digits := 0
    var part := 0  # 0 the integer part, 1 the fraction, 2 the exponent
    while i < n do
        let b := deref(p + i)
        if b >= 48 and b <= 57 then
            digits := digits + 1
        else if b = 46 and part = 0 and digits > 0 then
            part := 1
            digits := 0
        else if (b = 101 or b = 69) and part < 2 and digits > 0 then
            part := 2
            digits := 0
            if i + 1 < n and (deref(p + i + 1) = 45 or deref(p + i + 1) = 43) then
                i := i + 1
        else
            return Err("'{s}' is not a real")
        i := i + 1
    if digits = 0 then
        return Err("'{s}' is not a real")
    let x := strtod(toCString(s), end: cast[Pointer](0))
    if x - x <> 0.0 then  # an infinity
        return Err("'{s}' doesn't fit in a Real")
    return Ok(x)

## `s` written `count` times.
export function repeated(s: String, count: Integer): String
    requires count >= 0
    var parts: List[String] := []
    for i := 1 to count do
        add(var parts, s)
    return join(parts)

## `s` with the bytes in `lo` to `lo` + 25 moved by `shift`.
unsafe function shiftLetters(s: String, lo: Byte, shift: Integer): String
    let p := cast[Ptr[Byte]](toCString(s))
    var out: List[Byte] := []
    for i := 0 to byteLen(s) - 1 do
        let b := deref(p + i)
        if b >= lo and b <= lo + 25 then
            add(var out, Byte(Integer(b) + shift))
        else
            add(var out, b)
    return fromBytes(out)

## `s` with the ASCII letters `a` to `z` made upper case; other characters stay.
export function upperCase(s: String): String
    return shiftLetters(s, lo: 97, shift: -32)

## `s` with the ASCII letters `A` to `Z` made lower case; other characters stay.
export function lowerCase(s: String): String
    return shiftLetters(s, lo: 65, shift: 32)

## The lines of `s`: the parts between line breaks (`\n` or `\r\n`). A break at the very end
## doesn't start another line, so `"a\nb\n"` has two lines and `""` none.
export function lines(s: String): List[String]
    var out: List[String] := []
    if s = "" then
        return out
    var stop := byteLen(s)
    if endsWith(s, suffix: "\n") then
        stop := stop - 1
    for line in split(slice(s, 0, stop), sep: "\n") do
        if endsWith(line, suffix: "\r") then
            add(var out, slice(line, 0, byteLen(line) - 1))
        else
            add(var out, line)
    return out

## `n` in base `radix`, with upper-case digits, at least `digits` of them (padded with
## zeros), and a `-` in front if it's negative.
function radixStr(n, radix, digits: Integer): String
    let allDigits := "0123456789ABCDEF"
    var rest := n
    var out: List[String] := []
    while rest <> 0 or len(out) < digits do
        var d := rest mod radix
        if d < 0 then
            d := -d
        add(var out, slice(allDigits, d, d + 1))
        rest := rest div radix
    var r: List[String] := []
    if n < 0 then
        add(var r, "-")
    var i := len(out) - 1
    while i >= 0 do
        add(var r, out[i])
        i := i - 1
    return join(r)

## `n` in hexadecimal with upper-case digits, at least `digits` of them (padded with
## zeros), and a `-` in front if it's negative: `hexStr(255, 4)` is `00FF`.
export function hexStr(n: Integer, digits: Integer := 1): String
    return radixStr(n, 16, digits)

## `n` in binary, at least `digits` digits (padded with zeros), and a `-` in front if it's
## negative: `binStr(5, 4)` is `0101`.
export function binStr(n: Integer, digits: Integer := 1): String
    return radixStr(n, 2, digits)

## Whether `text` matches the shell-style `pattern` as a whole: `*` matches any characters
## (also none), `?` one character, `[abc]` one of the listed characters, with ranges like
## `[a-z]` and `[!...]` for any other character. A `[` without its `]` is an ordinary
## character.
export function globMatch(text, pattern: String): Boolean
    var t: List[Char] := []
    for c in text do
        add(var t, c)
    var p: List[Char] := []
    for c in pattern do
        add(var p, c)
    var ti := 0
    var pi := 0
    var starP := -1  # the pattern position after the last `*`
    var starT := 0  # the text position that `*` matched up to
    while ti < len(t) do
        if pi < len(p) and p[pi] = '*' then
            pi := pi + 1
            starP := pi
            starT := ti
        else if pi < len(p) and oneMatches(p, pi, t[ti]) then
            pi := pi + patternLength(p, pi)
            ti := ti + 1
        else if starP >= 0 then
            starT := starT + 1
            ti := starT
            pi := starP
        else
            return false
    while pi < len(p) and p[pi] = '*' do
        pi := pi + 1
    return pi = len(p)

## Position of the `]` that closes the class starting at `p[at]`, or -1.
function classEnd(p: List[Char], at: Integer): Integer
    var i := at + 1
    if i < len(p) and p[i] = '!' then
        i := i + 1
    if i < len(p) and p[i] = ']' then
        i := i + 1
    while i < len(p) do
        if p[i] = ']' then
            return i
        i := i + 1
    return -1

## Number of pattern characters in the item at `p[at]`.
function patternLength(p: List[Char], at: Integer): Integer
    if p[at] = '[' then
        let e := classEnd(p, at)
        if e >= 0 then
            return e - at + 1
    return 1

## Whether the pattern item at `p[at]` (not `*`) matches `c`.
function oneMatches(p: List[Char], at: Integer, c: Char): Boolean
    if p[at] = '?' then
        return true
    if p[at] <> '[' then
        return p[at] = c
    let e := classEnd(p, at)
    if e < 0 then
        return c = '['
    var i := at + 1
    let negated := p[i] = '!'
    if negated then
        i := i + 1
    var found := false
    while i < e do
        if i + 2 < e and p[i + 1] = '-' then
            if c >= p[i] and c <= p[i + 2] then
                found := true
            i := i + 3
        else
            if c = p[i] then
                found := true
            i := i + 1
    return found <> negated

test "pos gives byte offsets"
    assert pos("héllo", sub: "l") = Some(3)
    assert pos("hello", sub: "l", start: 3) = Some(3)
    assert pos("hello", sub: "x").isNone()
    assert pos("", sub: "") = Some(0)

test "startsWith and endsWith"
    assert startsWith("hello", prefix: "he")
    assert not startsWith("he", prefix: "hello")
    assert endsWith("hello", suffix: "llo")
    assert endsWith("hello", suffix: "")
    assert not endsWith("lo", suffix: "hello")

test "split and join are inverses"
    assert split("a,b,,c", sep: ",") = ["a", "b", "", "c"]
    assert split("", sep: ",") = [""]
    assert split("a::b", sep: "::") = ["a", "b"]
    assert join(["a", "b", "", "c"], sep: ",") = "a,b,,c"
    assert join([]) = ""
    assert join(["x", "y"]) = "xy"

test "trim and replace"
    assert trim("  a b\t\n") = "a b"
    assert trim(" \n ") = ""
    assert replace("a.b.c", target: ".", replacement: "::") = "a::b::c"
    assert replace("abc", target: "x", replacement: "y") = "abc"

test "parseInt"
    assert parseInt("42") = Ok(42)
    assert parseInt("-7") = Ok(-7)
    assert parseInt("+0") = Ok(0)
    assert parseInt("-9223372036854775808") = Ok(MinInt)
    assert parseInt("9223372036854775808").isErr()
    assert parseInt("").isErr()
    assert parseInt("-").isErr()
    assert parseInt("1x").isErr()

test "parseReal"
    assert parseReal("2.5") = Ok(2.5) and parseReal("-0.1") = Ok(-0.1)
    assert parseReal("+3") = Ok(3.0) and parseReal("1e3") = Ok(1000.0)
    assert parseReal("1.5E-2") = Ok(0.015)
    assert parseReal("").isErr() and parseReal(".5").isErr() and parseReal("1.").isErr()
    assert parseReal("1e").isErr() and parseReal("inf").isErr() and parseReal(" 1").isErr()
    assert parseReal("1.0e400").isErr()

test "bytes and fromBytes"
    assert bytes("é") = [195, 169]
    let hi: List[Byte] := [104, 105]
    assert fromBytes(hi) = "hi"
    let bad: List[Byte] := [255]
    assert fromBytes(bad) = "\u{FFFD}"
    assert charCount("héllo") = 5
    assert byteLen("héllo") = 6
    assert slice("héllo", 1, 3) = "é"

test "repeating"
    assert repeated("ab", count: 3) = "ababab" and repeated("x", count: 0) = ""

test "case and lines"
    assert upperCase("Héllo, w0rld") = "HéLLO, W0RLD" and lowerCase("ÀBC-d") = "Àbc-d"
    assert lines("a\nb\r\nc") = ["a", "b", "c"] and lines("a\n\n") = ["a", ""]
    assert lines("") = [] and lines("\n") = [""]

test "number formatting"
    assert hexStr(255) = "FF" and hexStr(0) = "0" and hexStr(10, digits: 4) = "000A"
    assert hexStr(-255) = "-FF" and hexStr(MinInt) = "-8000000000000000"
    assert binStr(5, digits: 4) = "0101" and binStr(0) = "0" and binStr(-6) = "-110"
    assert binStr(MinInt) = "-1{repeated("0", count: 63)}"

test "glob patterns"
    assert globMatch("main.pst", pattern: "*.pst") and not globMatch("main.c", pattern: "*.pst")
    assert globMatch("a", pattern: "?") and not globMatch("", pattern: "?")
    assert globMatch("", pattern: "*") and globMatch("abcabc", pattern: "*b*c")
    assert globMatch("x7", pattern: "x[0-9]") and not globMatch("xa", pattern: "x[0-9]")
    assert globMatch("xa", pattern: "x[!0-9]") and globMatch("]", pattern: "[]]")
    assert globMatch("a[b", pattern: "a[b") and globMatch("é", pattern: "?")
    assert not globMatch("abc", pattern: "ab")
