unit Collections

{ Collections beyond `List`, `Map` and `Set`: a double-ended queue, a priority queue, and a
  map kept in key order. }

type
    { A ring buffer: element `i` is at `items[(head + i) mod length(items)]`, for `i` below
      `count`. The slots after the last element hold old values until they're reused. }
    export Deque[T] = record
        items: List[T]
        head: Integer
        count: Integer

    export DequeIter[T] = record
        source: Deque[T]
        pos: Integer

    { A binary heap: `items[0]` is the first out, and no element is `less` than its parent,
      at `(i - 1) div 2`. The order of the others depends on the order they came in, so
      queues can't be compared with `=`. }
    export PriorityQueue[T] = record
        items: List[T]
        less: function(T, T): Boolean

    { A map whose keys stay in ascending order: `keys[i]` maps to `values[i]`. Finding a key
      takes O(log n) steps; `put` and `remove` move the entries after it, O(n). }
    export SortedMap[K: Ordered, V] = record
        keys: List[K]
        values: List[V]

    export SortedMapIter[K: Ordered, V] = record
        source: SortedMap[K, V]
        pos: Integer

{ ---------------------------------------------------------------------- deques }

{ An empty deque. }
export function deque[T](): Deque[T]
    return Deque(items: [], head: 0, count: 0)

{ Number of elements. }
export function length[T](d: Deque[T]): Integer
    return d.count

{ Where element `i` is in `d.items`; -1, which panics `P0001` as an index, if there's no
  such element. }
function slot[T](d: Deque[T], i: Integer): Integer
    if i < 0 or i >= d.count then
        return -1
    return (d.head + i) mod length(d.items)

{ The elements in order, from `items[0]`, when the buffer is full. }
procedure unwrap[T](var d: Deque[T])
    var items: List[T] := []
    for i := 0 to d.count - 1 do
        add(var items, d.items[slot(d, i)])
    d.items := items
    d.head := 0

{ Adds `x` after the last element. O(1), amortized. }
export procedure pushBack[T](var d: Deque[T], x: T)
    if d.count = length(d.items) then
        unwrap(var d)
        add(var d.items, x)
    else
        d.items[(d.head + d.count) mod length(d.items)] := x
    inc(var d.count)

{ Adds `x` before the first element. O(1), amortized. }
export procedure pushFront[T](var d: Deque[T], x: T)
    if d.count = length(d.items) then
        unwrap(var d)
        add(var d.items, x)
        d.head := d.count
    else
        d.head := (d.head + length(d.items) - 1) mod length(d.items)
        d.items[d.head] := x
    inc(var d.count)

{ Takes out the first element, if any. O(1). }
export function popFront[T](var d: Deque[T]): Option[T]
    if d.count = 0 then
        return None
    let x := d.items[d.head]
    d.head := (d.head + 1) mod length(d.items)
    dec(var d.count)
    return Some(x)

{ Takes out the last element, if any. O(1). }
export function popBack[T](var d: Deque[T]): Option[T]
    if d.count = 0 then
        return None
    let x := d.items[slot(d, d.count - 1)]
    dec(var d.count)
    return Some(x)

{ The first element, if any. }
export function first[T](d: Deque[T]): Option[T]
    if d.count = 0 then
        return None
    return Some(d.items[d.head])

{ The last element, if any. }
export function last[T](d: Deque[T]): Option[T]
    if d.count = 0 then
        return None
    return Some(d.items[slot(d, d.count - 1)])

{ `d[i]`: element `i`, counting from the front (`P0001` if there's no such element). }
operator function get[T](d: Deque[T], i: Integer): T
    return d.items[slot(d, i)]

{ `d[i] := x` (`P0001` if there's no element `i`). }
operator procedure set[T](var d: Deque[T], i: Integer, x: T)
    d.items[slot(d, i)] := x

{ `x in d`: whether an element of `d` is `x`. O(n). }
operator function contains[T: Equatable](d: Deque[T], x: T): Boolean
    for i := 0 to d.count - 1 do
        if d.items[slot(d, i)] = x then
            return true
    return false

{ `a = b`: the same elements in the same order. }
operator function equals[T: Equatable](a, b: Deque[T]): Boolean
    if a.count <> b.count then
        return false
    for i := 0 to a.count - 1 do
        if a.items[slot(a, i)] <> b.items[slot(b, i)] then
            return false
    return true

operator procedure hash[T: Hashable](var h: Hasher, d: Deque[T])
    combine(var h, d.count)
    for i := 0 to d.count - 1 do
        combine(var h, d.items[slot(d, i)])

{ The elements, front to back: `for x in d`. }
export function iter[T](d: Deque[T]): DequeIter[T]
    return DequeIter(source: d, pos: 0)

export function next[T](var it: DequeIter[T]): Option[T]
    if it.pos >= it.source.count then
        return None
    inc(var it.pos)
    return Some(it.source[it.pos - 1])

{ The elements as `[a, b]`, front to back. }
export function toString[T: Printable](d: Deque[T]): String
    var out := "["
    for i := 0 to d.count - 1 do
        if i > 0 then
            out := "{out}, "
        out := "{out}{d.items[slot(d, i)]}"
    return "{out}]"

{ ------------------------------------------------------------ priority queues }

function ascending[T: Ordered](a, b: T): Boolean
    return a < b

{ An empty queue that gives its smallest element first. }
export function priorityQueue[T: Ordered](): PriorityQueue[T]
    return PriorityQueue(items: [], less: ascending[T])

{ An empty queue that gives first an element no other is `less` than. }
export function priorityQueue[T](less: function(T, T): Boolean): PriorityQueue[T]
    return PriorityQueue(items: [], less: less)

{ Number of elements. }
export function length[T](q: PriorityQueue[T]): Integer
    return length(q.items)

{ Adds `x`. O(log n). }
export procedure push[T](var q: PriorityQueue[T], x: T)
    add(var q.items, x)
    var i := length(q.items) - 1
    while i > 0 and q.less(q.items[i], q.items[(i - 1) div 2]) do
        swap(var q.items, i, (i - 1) div 2)
        i := (i - 1) div 2

{ The element `pop` would take, if any. }
export function peek[T](q: PriorityQueue[T]): Option[T]
    if length(q.items) = 0 then
        return None
    return Some(q.items[0])

{ Takes out the first element, if any. O(log n). }
export function pop[T](var q: PriorityQueue[T]): Option[T]
    let n := length(q.items)
    if n = 0 then
        return None
    let first := q.items[0]
    q.items[0] := q.items[n - 1]
    removeLast(var q.items)
    var i := 0
    while true do
        var m := i
        for c := 2 * i + 1 to 2 * i + 2 do
            if c < n - 1 and q.less(q.items[c], q.items[m]) then
                m := c
        if m = i then
            return Some(first)
        swap(var q.items, i, m)
        i := m
    return Some(first)

procedure swap[T](var xs: List[T], i, j: Integer)
    let x := xs[i]
    xs[i] := xs[j]
    xs[j] := x

{ ---------------------------------------------------------------- sorted maps }

{ An empty map. }
export function sortedMap[K: Ordered, V](): SortedMap[K, V]
    return SortedMap(keys: [], values: [])

{ The position of the first key that isn't below `key`. }
function search[K: Ordered, V](m: SortedMap[K, V], key: K): Integer
    var lo := 0
    var hi := length(m.keys)
    while lo < hi do
        let mid := (lo + hi) div 2
        if m.keys[mid] < key then
            lo := mid + 1
        else
            hi := mid
    return lo

{ Whether `key` is at position `i`. }
function at[K: Ordered, V](m: SortedMap[K, V], i: Integer, key: K): Boolean
    return i < length(m.keys) and m.keys[i] = key

{ Number of entries. }
export function length[K: Ordered, V](m: SortedMap[K, V]): Integer
    return length(m.keys)

{ Sets the value of `key`, adding it if it is missing. }
export procedure put[K: Ordered, V](var m: SortedMap[K, V], key: K, value: V)
    let i := search(m, key)
    if at(m, i, key) then
        m.values[i] := value
    else
        insert(var m.keys, i, x: key)
        insert(var m.values, i, x: value)

{ The value of `key`, if present. }
export function get[K: Ordered, V](m: SortedMap[K, V], key: K): Option[V]
    let i := search(m, key)
    if at(m, i, key) then
        return Some(m.values[i])
    return None

{ The value of `key`, or `default` if it is missing. }
export function getOr[K: Ordered, V](m: SortedMap[K, V], key: K, default: V): V
    let i := search(m, key)
    if at(m, i, key) then
        return m.values[i]
    return default

{ Whether `key` is present. }
export function hasKey[K: Ordered, V](m: SortedMap[K, V], key: K): Boolean
    return at(m, search(m, key), key)

{ Removes `key`, if present. }
export procedure remove[K: Ordered, V](var m: SortedMap[K, V], key: K)
    let i := search(m, key)
    if at(m, i, key) then
        remove(var m.keys, i)
        remove(var m.values, i)

{ The keys, in ascending order. }
export function keys[K: Ordered, V](m: SortedMap[K, V]): List[K]
    return m.keys

{ The values, in the order of their keys. }
export function values[K: Ordered, V](m: SortedMap[K, V]): List[V]
    return m.values

{ The smallest key, if any. }
export function firstKey[K: Ordered, V](m: SortedMap[K, V]): Option[K]
    if length(m.keys) = 0 then
        return None
    return Some(m.keys[0])

{ The largest key, if any. }
export function lastKey[K: Ordered, V](m: SortedMap[K, V]): Option[K]
    if length(m.keys) = 0 then
        return None
    return Some(m.keys[length(m.keys) - 1])

{ The entries, in ascending key order. }
export function entries[K: Ordered, V](m: SortedMap[K, V]): SortedMapIter[K, V]
    return SortedMapIter(source: m, pos: 0)

export function next[K: Ordered, V](var it: SortedMapIter[K, V]): Option[Entry[K, V]]
    if it.pos >= length(it.source.keys) then
        return None
    inc(var it.pos)
    return Some(Entry(key: it.source.keys[it.pos - 1], value: it.source.values[it.pos - 1]))

{ The entries as `[k: v]`, in ascending key order; `[:]` when empty. }
export function toString[K: Ordered + Printable, V: Printable](m: SortedMap[K, V]): String
    if length(m.keys) = 0 then
        return "[:]"
    var out := "["
    for i := 0 to length(m.keys) - 1 do
        if i > 0 then
            out := "{out}, "
        out := "{out}{m.keys[i]}: {m.values[i]}"
    return "{out}]"

test "a priority queue gives its smallest element first"
    var q := priorityQueue[Integer]()
    for x in [5, 3, 8, 1, 9, 2, 7, 3] do
        push(var q, x)
    assert length(q) = 8
    assert peek(q) = Some(1)
    var out: List[Integer] := []
    while length(q) > 0 do
        add(var out, pop(var q).get())
    assert out = [1, 2, 3, 3, 5, 7, 8, 9]
    assert pop(var q) = None
    assert peek(q) = None

test "a priority queue can use its own order"
    var q := priorityQueue[Integer]((a, b) => a > b)
    for x in [2, 9, 4, 9, 1] do
        push(var q, x)
    assert pop(var q) = Some(9)
    assert pop(var q) = Some(9)
    assert pop(var q) = Some(4)
    assert length(q) = 2

test "a sorted map keeps its keys in order"
    var m := sortedMap[String, Integer]()
    put(var m, "pear", 3)
    put(var m, "apple", 1)
    put(var m, "fig", 2)
    put(var m, "apple", 4)
    assert length(m) = 3
    assert keys(m) = ["apple", "fig", "pear"]
    assert values(m) = [4, 2, 3]
    assert get(m, "fig") = Some(2)
    assert get(m, "kiwi") = None
    assert getOr(m, "kiwi", 0) = 0
    assert hasKey(m, "pear")
    assert firstKey(m) = Some("apple")
    assert lastKey(m) = Some("pear")
    assert toString(m) = "[apple: 4, fig: 2, pear: 3]"
    remove(var m, "fig")
    remove(var m, "kiwi")
    assert keys(m) = ["apple", "pear"]
    var n := sortedMap[String, Integer]()
    put(var n, "pear", 3)
    put(var n, "apple", 4)
    assert m = n

test "a sorted map's entries come in key order"
    var m := sortedMap[Integer, Char]()
    for i := 10 downto 1 do
        put(var m, i * 7 mod 11, 'x')
    var last := -1
    for e in entries(m) do
        assert e.key > last
        last := e.key
    assert toString(sortedMap[Integer, Integer]()) = "[:]"

test "a deque takes elements at both ends"
    var d := deque[Integer]()
    for i := 1 to 5 do
        pushBack(var d, i)
    pushFront(var d, 0)
    pushFront(var d, -1)
    assert length(d) = 7
    assert toString(d) = "[-1, 0, 1, 2, 3, 4, 5]"
    assert popFront(var d) = Some(-1)
    assert popBack(var d) = Some(5)
    assert first(d) = Some(0)
    assert last(d) = Some(4)
    assert d[1] = 1
    d[1] := 10
    assert 10 in d and not (1 in d)
    var out: List[Integer] := []
    for x in d do
        add(var out, x)
    assert out = [0, 10, 2, 3, 4]

test "a deque wraps around its buffer"
    var d := deque[String]()
    for i := 1 to 4 do
        pushBack(var d, "{i}")
    for i := 1 to 3 do
        assert popFront(var d) = Some("{i}")
    for i := 5 to 9 do
        pushBack(var d, "{i}")
    pushFront(var d, "3")
    assert toString(d) = "[3, 4, 5, 6, 7, 8, 9]"
    while length(d) > 0 do
        _ := popBack(var d)
    assert popBack(var d) = None
    assert popFront(var d) = None
    assert first(d) = None

test "deques with the same elements are equal"
    var a := deque[Integer]()
    var b := deque[Integer]()
    for i := 1 to 3 do
        pushBack(var a, i)
    pushBack(var b, 0)
    for i := 1 to 3 do
        pushBack(var b, i)
    _ := popFront(var b)
    assert a = b
    let s: Set[Deque[Integer]] := [a, b]
    assert length(s) = 1
    pushBack(var b, 4)
    assert a <> b
