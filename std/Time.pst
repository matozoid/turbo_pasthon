unit Time

{ Dates, times and durations, modeled on Joda-Time: immutable values with nanosecond
  precision, read from and written as ISO-8601 text. Dates use the proleptic Gregorian
  calendar, with years from -999_999 to 999_999. The clock comes from libc. }

uses C, Strings, IO, OS

external "libc.so.6"
    function clockGettime(clock: CInt, ts: Ptr[Timespec]): CInt name "clock_gettime"
    type
        { glibc's `struct timespec` on x86-64. }
        Timespec = record
            sec: Int64
            nsec: Int64

const
    NanosPerSecond = 1_000_000_000
    SecondsPerDay = 86_400
    { Days from 0000-03-01 to 1970-01-01. }
    DaysTo1970 = 719_468
    MaxYear = 999_999

type
    { A point on the time line: seconds since 1970-01-01T00:00:00Z, plus nanoseconds. }
    export Instant = record
        secs: Integer
        ns: Integer

    { An amount of time in seconds and nanoseconds. The nanoseconds are always 0 to
      999_999_999, so -0.5 seconds is -1 second plus 500_000_000 nanoseconds. }
    export Duration = record
        secs: Integer
        ns: Integer

    { A date without a time or a time zone, such as 2026-11-10. }
    export LocalDate = record
        yr: Integer
        mon: Integer
        dom: Integer

    { A time of day without a date or a time zone, such as 09:30:00. }
    export LocalTime = record
        hr: Integer
        mins: Integer
        sec: Integer
        ns: Integer

    { A date and a time of day without a time zone, such as 2026-11-10T09:30:00. }
    export LocalDateTime = record
        ld: LocalDate
        lt: LocalTime

    export Weekday = (Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday)

    { A time zone: the UTC offsets and abbreviations a region used over time, from an IANA
      tzdata (TZif) file, or a fixed offset. }
    export Zone = record
        zid: String
        { The instants (seconds since 1970) where the offset changes, ascending. }
        times: List[Integer]
        { The index into `offsets`, `dsts` and `abbrevs` from each of `times` on. }
        kinds: List[Integer]
        offsets: List[Integer]
        dsts: List[Boolean]
        abbrevs: List[String]
        { The POSIX TZ rule for instants after the last of `times`. }
        rule: Option[Rule]

    { A POSIX TZ rule: standard time, and daylight saving time between two days of each
      year when `dstAbbr` isn't empty. Offsets are in seconds east of UTC. }
    Rule = record
        stdAbbr: String
        stdOffset: Integer
        dstAbbr: String
        dstOffset: Integer
        begins: DayRule
        ends: DayRule

    { A day of the year in a POSIX TZ rule and the local time on it, in seconds. }
    DayRule = record
        { 'J' (day `n`, 1 to 365, never counting February 29), 'n' (day `n`, 0 to 365) or
          'M' (weekday `wd`, 0 being Sunday, of week `week`, 5 being the last, of month
          `n`). }
        kind: Char
        n: Integer
        week: Integer
        wd: Integer
        at: Integer

    { An amount of calendar time in years, months and days, such as P1Y2M3D. Each part
      may be negative. }
    export Period = record
        ys: Integer
        ms: Integer
        ds: Integer

    { The instants from `lo` up to, not including, `hi`. }
    export Interval = record
        lo: Instant
        hi: Instant

    { An instant in a time zone, such as 2026-11-10T09:30:00+01:00[Europe/Amsterdam]. }
    export DateTime = record
        inst: Instant
        tz: Zone

    { The parser's state: the text's characters and the position in them. }
    Reader = record
        cs: List[Char]
        pos: Integer

{ --------------------------------------------------------------------- arithmetic }

{ `a div b` rounded down rather than toward zero. `b` must be positive. }
function floorDiv(a, b: Integer): Integer
    let q := a div b
    return if a mod b < 0 then q - 1 else q

{ `a mod b` in `0 ..< b`. `b` must be positive. }
function floorMod(a, b: Integer): Integer
    let r := a mod b
    return if r < 0 then r + b else r

{ -1, 0 or 1 as `a` is below, equal to or above `b`. }
function sign(a, b: Integer): Integer
    return if a < b then -1 else if a > b then 1 else 0

{ ----------------------------------------------------------------------- durations }

{ A duration of `seconds` plus `nanos` (which may be any value; it is carried into the
  seconds). }
export function ofSeconds(seconds: Integer, nanos: Integer := 0): Duration
    return Duration(
        secs: seconds + floorDiv(nanos, NanosPerSecond),
        ns: floorMod(nanos, NanosPerSecond),
    )

export function ofDays(days: Integer): Duration
    return ofSeconds(days * SecondsPerDay)

export function ofHours(hours: Integer): Duration
    return ofSeconds(hours * 3600)

export function ofMinutes(minutes: Integer): Duration
    return ofSeconds(minutes * 60)

export function ofMillis(millis: Integer): Duration
    return ofSeconds(0, nanos: millis * 1_000_000)

export function ofNanos(nanos: Integer): Duration
    return ofSeconds(0, nanos: nanos)

{ The whole seconds of `d`, rounded down: -0.5 seconds gives -1. }
export function seconds(d: Duration): Integer
    return d.secs

{ The nanoseconds of `d` within its second, 0 to 999_999_999. }
export function nanos(d: Duration): Integer
    return d.ns

{ `d` in whole milliseconds, rounded down. }
export function toMillis(d: Duration): Integer
    return d.secs * 1000 + d.ns div 1_000_000

{ `d` in nanoseconds. Overflows beyond about 292 years. }
export function toNanos(d: Duration): Integer
    return d.secs * NanosPerSecond + d.ns

export function isZero(d: Duration): Boolean
    return d.secs = 0 and d.ns = 0

export function isNegative(d: Duration): Boolean
    return d.secs < 0

export function plus(a, b: Duration): Duration
    return ofSeconds(a.secs + b.secs, nanos: a.ns + b.ns)

export function minus(a, b: Duration): Duration
    return ofSeconds(a.secs - b.secs, nanos: a.ns - b.ns)

export function negated(d: Duration): Duration
    return ofSeconds(-d.secs, nanos: -d.ns)

export function abs(d: Duration): Duration
    return if isNegative(d) then negated(d) else d

{ `d` multiplied by `n`. }
export function times(d: Duration, n: Integer): Duration
    return ofSeconds(d.secs * n, nanos: d.ns * n)

export function compare(a, b: Duration): Integer
    let s := sign(a.secs, b.secs)
    return if s <> 0 then s else sign(a.ns, b.ns)

export function isLonger(a, b: Duration): Boolean
    return compare(a, b) > 0

export function isShorter(a, b: Duration): Boolean
    return compare(a, b) < 0

{ ISO-8601 text in hours, minutes and seconds, such as `PT8H6M12.345S`, `PT0S`, or
  `-PT1.5S` for a negative duration. }
export function toString(d: Duration): String
    if isZero(d) then
        return "PT0S"
    let a := abs(d)
    let h := a.secs div 3600
    let m := a.secs mod 3600 div 60
    let s := a.secs mod 60
    var parts := [if isNegative(d) then "-PT" else "PT"]
    if h > 0 then
        add(var parts, "{h}H")
    if m > 0 then
        add(var parts, "{m}M")
    if s > 0 or a.ns > 0 then
        add(var parts, "{s}{fraction(a.ns)}S")
    return join(parts)

{ ------------------------------------------------------------------------ instants }

{ The current time from the system's real-time clock. }
export unsafe function now(): Instant
    var ts := Timespec(sec: 0, nsec: 0)
    _ := clockGettime(0, ts: addr(var ts))
    return Instant(secs: Integer(ts.sec), ns: Integer(ts.nsec))

{ The instant `seconds` after 1970-01-01T00:00:00Z, plus `nanos` (which may be any
  value; it is carried into the seconds). }
export function ofEpochSecond(seconds: Integer, nanos: Integer := 0): Instant
    let d := ofSeconds(seconds, nanos: nanos)
    return Instant(secs: d.secs, ns: d.ns)

export function ofEpochMilli(millis: Integer): Instant
    return ofEpochSecond(0, nanos: millis * 1_000_000)

{ Whole seconds since 1970-01-01T00:00:00Z, rounded down. }
export function epochSecond(i: Instant): Integer
    return i.secs

{ The nanoseconds of `i` within its second, 0 to 999_999_999. }
export function nano(i: Instant): Integer
    return i.ns

{ Milliseconds since 1970-01-01T00:00:00Z, rounded down. }
export function toEpochMilli(i: Instant): Integer
    return i.secs * 1000 + i.ns div 1_000_000

export function plus(i: Instant, d: Duration): Instant
    return ofEpochSecond(i.secs + d.secs, nanos: i.ns + d.ns)

export function minus(i: Instant, d: Duration): Instant
    return ofEpochSecond(i.secs - d.secs, nanos: i.ns - d.ns)

{ The duration from `a` to `b`, negative if `b` is before `a`. }
export function between(a, b: Instant): Duration
    return ofSeconds(b.secs - a.secs, nanos: b.ns - a.ns)

export function compare(a, b: Instant): Integer
    let s := sign(a.secs, b.secs)
    return if s <> 0 then s else sign(a.ns, b.ns)

export function isBefore(a, b: Instant): Boolean
    return compare(a, b) < 0

export function isAfter(a, b: Instant): Boolean
    return compare(a, b) > 0

{ The date and time at `i` in the time zone `offsetSeconds` east of UTC. }
export function toLocalDateTime(i: Instant, offsetSeconds: Integer := 0): LocalDateTime
    let s := i.secs + offsetSeconds
    let date := ofEpochDay(floorDiv(s, SecondsPerDay))
    let time := ofNanoOfDay(floorMod(s, SecondsPerDay) * NanosPerSecond + i.ns)
    return LocalDateTime(ld: date, lt: time)

{ ISO-8601 text in UTC, such as `2026-11-10T09:30:00Z` or `2026-11-10T09:30:00.250Z`. }
export function toString(i: Instant): String
    return "{toLocalDateTime(i)}Z"

{ --------------------------------------------------------------------------- dates }

{ Whether `year` has a February 29. }
export function isLeapYear(year: Integer): Boolean
    return year mod 4 = 0 and (year mod 100 <> 0 or year mod 400 = 0)

{ The number of days in `month` (1 to 12) of `year`. }
export function monthLength(year, month: Integer): Integer
    if month = 2 then
        return if isLeapYear(year) then 29 else 28
    if month = 4 or month = 6 or month = 9 or month = 11 then
        return 30
    return 31

{ Whether `year`, `month` and `day` name a date. }
export function isValidDate(year, month, day: Integer): Boolean
    if year < -MaxYear or year > MaxYear or month < 1 or month > 12 then
        return false
    return day >= 1 and day <= monthLength(year, month: month)

{ The date `day` of `month` (1 to 12) of `year`. }
export function date(year, month, day: Integer): LocalDate
    requires isValidDate(year, month, day)
    return LocalDate(yr: year, mon: month, dom: day)

export function year(d: LocalDate): Integer
    return d.yr

{ The month, 1 to 12. }
export function month(d: LocalDate): Integer
    return d.mon

{ The day of the month, from 1. }
export function day(d: LocalDate): Integer
    return d.dom

{ The day of the year, 1 to 366. }
export function dayOfYear(d: LocalDate): Integer
    return toEpochDay(d) - toEpochDay(date(d.yr, 1, 1)) + 1

export function weekday(d: LocalDate): Weekday
    let days := [
        Weekday.Monday,
        Weekday.Tuesday,
        Weekday.Wednesday,
        Weekday.Thursday,
        Weekday.Friday,
        Weekday.Saturday,
        Weekday.Sunday,
    ]
    { 1970-01-01 was a Thursday. }
    return days[floorMod(toEpochDay(d) + 3, 7)]

{ Days since 1970-01-01, negative before it. After Howard Hinnant's `days_from_civil`. }
export function toEpochDay(d: LocalDate): Integer
    let y := if d.mon <= 2 then d.yr - 1 else d.yr
    let era := floorDiv(y, 400)
    let yoe := y - era * 400
    let mp := if d.mon > 2 then d.mon - 3 else d.mon + 9
    let doy := (153 * mp + 2) div 5 + d.dom - 1
    let doe := yoe * 365 + yoe div 4 - yoe div 100 + doy
    return era * 146_097 + doe - DaysTo1970

{ The date `days` after 1970-01-01. After Howard Hinnant's `civil_from_days`. }
export function ofEpochDay(days: Integer): LocalDate
    let z := days + DaysTo1970
    let era := floorDiv(z, 146_097)
    let doe := z - era * 146_097
    let yoe := (doe - doe div 1460 + doe div 36_524 - doe div 146_096) div 365
    let doy := doe - (365 * yoe + yoe div 4 - yoe div 100)
    let mp := (5 * doy + 2) div 153
    let day := doy - (153 * mp + 2) div 5 + 1
    let month := if mp < 10 then mp + 3 else mp - 9
    let year := yoe + era * 400 + (if month <= 2 then 1 else 0)
    return date(year, month, day)

export function plusDays(d: LocalDate, days: Integer): LocalDate
    return ofEpochDay(toEpochDay(d) + days)

{ `d` moved by `months`. A day past the end of the new month becomes its last day, so
  2024-01-31 plus one month is 2024-02-29. }
export function plusMonths(d: LocalDate, months: Integer): LocalDate
    let m := d.yr * 12 + d.mon - 1 + months
    let year := floorDiv(m, 12)
    let month := floorMod(m, 12) + 1
    let last := monthLength(year, month: month)
    return date(year, month, if d.dom > last then last else d.dom)

export function plusYears(d: LocalDate, years: Integer): LocalDate
    return plusMonths(d, months: years * 12)

{ The days from `a` to `b`, negative if `b` is before `a`. }
export function daysBetween(a, b: LocalDate): Integer
    return toEpochDay(b) - toEpochDay(a)

export function compare(a, b: LocalDate): Integer
    return sign(toEpochDay(a), toEpochDay(b))

export function isBefore(a, b: LocalDate): Boolean
    return compare(a, b) < 0

export function isAfter(a, b: LocalDate): Boolean
    return compare(a, b) > 0

{ The date at midnight. }
export function atStartOfDay(d: LocalDate): LocalDateTime
    return LocalDateTime(ld: d, lt: midnight())

{ ISO-8601 text such as `2026-11-10`. Years beyond 9999 get a `+`, years before 0 a `-`. }
export function toString(d: LocalDate): String
    var y := pad(d.yr, 4)
    if d.yr < 0 then
        y := "-{pad(-d.yr, 4)}"
    else if d.yr > 9999 then
        y := "+{d.yr}"
    return "{y}-{pad(d.mon, 2)}-{pad(d.dom, 2)}"

{ --------------------------------------------------------------------------- times }

{ Whether the parts name a time of day. }
export function isValidTime(hour, minute, second, nano: Integer): Boolean
    let hm := hour >= 0 and hour < 24 and minute >= 0 and minute < 60
    return hm and second >= 0 and second < 60 and nano >= 0 and nano < NanosPerSecond

{ The time of day `hour:minute:second` plus `nano` nanoseconds. }
export function time(hour, minute: Integer, second: Integer := 0, nano: Integer := 0): LocalTime
    requires isValidTime(hour, minute, second, nano)
    return LocalTime(hr: hour, mins: minute, sec: second, ns: nano)

export function midnight(): LocalTime
    return time(0, 0)

export function noon(): LocalTime
    return time(12, 0)

export function hour(t: LocalTime): Integer
    return t.hr

export function minute(t: LocalTime): Integer
    return t.mins

export function second(t: LocalTime): Integer
    return t.sec

{ The nanoseconds within the second, 0 to 999_999_999. }
export function nano(t: LocalTime): Integer
    return t.ns

{ Nanoseconds since midnight. }
export function toNanoOfDay(t: LocalTime): Integer
    return ((t.hr * 60 + t.mins) * 60 + t.sec) * NanosPerSecond + t.ns

{ The time `nanos` after midnight, wrapping around at 24 hours. }
export function ofNanoOfDay(nanos: Integer): LocalTime
    let n := floorMod(nanos, SecondsPerDay * NanosPerSecond)
    let s := n div NanosPerSecond
    return time(s div 3600, s mod 3600 div 60, second: s mod 60, nano: n mod NanosPerSecond)

{ `t` moved by `d`, wrapping around midnight. }
export function plus(t: LocalTime, d: Duration): LocalTime
    return ofNanoOfDay(
        toNanoOfDay(t) + floorMod(d.secs, SecondsPerDay) * NanosPerSecond + d.ns,
    )

export function minus(t: LocalTime, d: Duration): LocalTime
    return plus(t, negated(d))

export function compare(a, b: LocalTime): Integer
    return sign(toNanoOfDay(a), toNanoOfDay(b))

export function isBefore(a, b: LocalTime): Boolean
    return compare(a, b) < 0

export function isAfter(a, b: LocalTime): Boolean
    return compare(a, b) > 0

{ ISO-8601 text such as `09:30:00`, with a fraction of 3, 6 or 9 digits when there are
  nanoseconds: `09:30:00.250`. }
export function toString(t: LocalTime): String
    return "{pad(t.hr, 2)}:{pad(t.mins, 2)}:{pad(t.sec, 2)}{fraction(t.ns)}"

{ ---------------------------------------------------------------------- date-times }

export function dateTime(date: LocalDate, time: LocalTime): LocalDateTime
    return LocalDateTime(ld: date, lt: time)

export function date(dt: LocalDateTime): LocalDate
    return dt.ld

export function time(dt: LocalDateTime): LocalTime
    return dt.lt

export function year(dt: LocalDateTime): Integer
    return year(date(dt))

{ The month, 1 to 12. }
export function month(dt: LocalDateTime): Integer
    return month(date(dt))

{ The day of the month, from 1. }
export function day(dt: LocalDateTime): Integer
    return day(date(dt))

{ The day of the year, 1 to 366. }
export function dayOfYear(dt: LocalDateTime): Integer
    return dayOfYear(date(dt))

export function weekday(dt: LocalDateTime): Weekday
    return weekday(date(dt))

export function hour(dt: LocalDateTime): Integer
    return hour(time(dt))

export function minute(dt: LocalDateTime): Integer
    return minute(time(dt))

export function second(dt: LocalDateTime): Integer
    return second(time(dt))

{ The nanoseconds within the second, 0 to 999_999_999. }
export function nano(dt: LocalDateTime): Integer
    return nano(time(dt))

{ The instant at `dt` in the time zone `offsetSeconds` east of UTC. }
export function toInstant(dt: LocalDateTime, offsetSeconds: Integer := 0): Instant
    let s := toEpochDay(dt.ld) * SecondsPerDay + toNanoOfDay(dt.lt) div NanosPerSecond
    return Instant(secs: s - offsetSeconds, ns: dt.lt.ns)

export function plus(dt: LocalDateTime, d: Duration): LocalDateTime
    return toLocalDateTime(plus(toInstant(dt), d: d))

export function minus(dt: LocalDateTime, d: Duration): LocalDateTime
    return toLocalDateTime(minus(toInstant(dt), d: d))

export function plusDays(dt: LocalDateTime, days: Integer): LocalDateTime
    return LocalDateTime(ld: plusDays(dt.ld, days: days), lt: dt.lt)

export function plusMonths(dt: LocalDateTime, months: Integer): LocalDateTime
    return LocalDateTime(ld: plusMonths(dt.ld, months: months), lt: dt.lt)

export function plusYears(dt: LocalDateTime, years: Integer): LocalDateTime
    return LocalDateTime(ld: plusYears(dt.ld, years: years), lt: dt.lt)

export function compare(a, b: LocalDateTime): Integer
    let c := compare(a.ld, b: b.ld)
    return if c <> 0 then c else compare(a.lt, b: b.lt)

export function isBefore(a, b: LocalDateTime): Boolean
    return compare(a, b) < 0

export function isAfter(a, b: LocalDateTime): Boolean
    return compare(a, b) > 0

{ ISO-8601 text such as `2026-11-10T09:30:00`. }
export function toString(dt: LocalDateTime): String
    return "{dt.ld}T{dt.lt}"

{ ------------------------------------------------------------------------- writing }

{ `n` (not negative) in decimal, with zeros in front up to `width` digits. }
function pad(n, width: Integer): String
    var s := toString(n)
    while byteLen(s) < width do
        s := "0{s}"
    return s

{ `.` and the nanoseconds in 3, 6 or 9 digits, or nothing for 0. }
function fraction(nanos: Integer): String
    if nanos = 0 then
        return ""
    if nanos mod 1_000_000 = 0 then
        return ".{pad(nanos div 1_000_000, 3)}"
    if nanos mod 1000 = 0 then
        return ".{pad(nanos div 1000, 6)}"
    return ".{pad(nanos, 9)}"

{ ------------------------------------------------------------------------- reading }

function reader(s: String): Reader
    var cs: List[Char] := []
    for c in s do
        add(var cs, c)
    return Reader(cs: cs, pos: 0)

function peek(r: Reader): Char
    if r.pos < length(r.cs) then
        return r.cs[r.pos]
    return Char(0)

function atEnd(r: Reader): Boolean
    return r.pos >= length(r.cs)

function failure(r: Reader, what: String): String
    if atEnd(r) then
        return "{what} at the end of the text"
    return "{what} at offset {r.pos}"

function isDigit(c: Char): Boolean
    return c >= '0' and c <= '9'

{ Reads `c`. }
function expect(var r: Reader, c: Char): Result[Integer, String]
    if peek(r) <> c then
        return Err(failure(r, "expected '{c}'"))
    r.pos := r.pos + 1
    return Ok(0)

{ Reads exactly `count` digits. }
function digits(var r: Reader, count: Integer): Result[Integer, String]
    var n := 0
    for k := 1 to count do
        if not isDigit(peek(r)) then
            return Err(failure(r, "expected a digit"))
        n := n * 10 + ord(peek(r)) - ord('0')
        r.pos := r.pos + 1
    return Ok(n)

{ Reads one or more digits, at most 18. }
function number(var r: Reader): Result[Integer, String]
    let start := r.pos
    var n := 0
    while isDigit(peek(r)) do
        if r.pos - start = 18 then
            return Err(failure(r, "number too large"))
        n := n * 10 + ord(peek(r)) - ord('0')
        r.pos := r.pos + 1
    if r.pos = start then
        return Err(failure(r, "expected a digit"))
    return Ok(n)

{ `n`, read from `start`, or an error there if it is above `high`. }
function check(
    var r: Reader,
    start: Integer,
    n: Integer,
    high: Integer,
    what: String,
): Result[Integer, String]
    if n > high then
        r.pos := start
        return Err(failure(r, "{what} out of range"))
    return Ok(n)

{ Reads a `.` and 1 to 9 digits, if there, as nanoseconds. }
function nanosPart(var r: Reader): Result[Integer, String]
    if peek(r) <> '.' and peek(r) <> ',' then
        return Ok(0)
    r.pos := r.pos + 1
    var n := 0
    var count := 0
    while isDigit(peek(r)) and count < 9 do
        n := n * 10 + ord(peek(r)) - ord('0')
        r.pos := r.pos + 1
        count := count + 1
    if count = 0 then
        return Err(failure(r, "expected a digit"))
    for k := count + 1 to 9 do
        n := n * 10
    return Ok(n)

function readDate(var r: Reader): Result[LocalDate, String]
    let start := r.pos
    var year := 0
    if peek(r) = '+' or peek(r) = '-' then
        let negative := peek(r) = '-'
        r.pos := r.pos + 1
        let digitsAt := r.pos
        year := try number(var r)
        if r.pos - digitsAt < 4 then
            return Err(failure(r, "expected a digit"))
        if negative then
            year := -year
    else
        year := try digits(var r, count: 4)
    if year < -MaxYear or year > MaxYear then
        r.pos := start
        return Err(failure(r, "year out of range"))
    _ := try expect(var r, c: '-')
    let monthAt := r.pos
    let month := try digits(var r, count: 2)
    if month < 1 or month > 12 then
        r.pos := monthAt
        return Err(failure(r, "month out of range"))
    _ := try expect(var r, c: '-')
    let dayAt := r.pos
    let day := try digits(var r, count: 2)
    if day < 1 or day > monthLength(year, month: month) then
        r.pos := dayAt
        return Err(failure(r, "day out of range"))
    return Ok(date(year, month, day))

{ Reads `hh:mm`, then `:ss` and a fraction if there. }
function readTime(var r: Reader): Result[LocalTime, String]
    let hourAt := r.pos
    let hour := try digits(var r, count: 2)
    _ := try check(var r, start: hourAt, n: hour, high: 23, what: "hour")
    _ := try expect(var r, c: ':')
    let minuteAt := r.pos
    let minute := try digits(var r, count: 2)
    _ := try check(var r, start: minuteAt, n: minute, high: 59, what: "minute")
    if peek(r) <> ':' then
        return Ok(time(hour, minute))
    r.pos := r.pos + 1
    let secondAt := r.pos
    let second := try digits(var r, count: 2)
    _ := try check(var r, start: secondAt, n: second, high: 59, what: "second")
    let nano := try nanosPart(var r)
    return Ok(time(hour, minute, second: second, nano: nano))

function readDateTime(var r: Reader): Result[LocalDateTime, String]
    let d := try readDate(var r)
    _ := try expect(var r, c: 'T')
    let t := try readTime(var r)
    return Ok(dateTime(d, time: t))

{ Reads `Z` or an offset `+hh:mm` / `-hh:mm`, as seconds east of UTC. }
function readOffset(var r: Reader): Result[Integer, String]
    if peek(r) = 'Z' then
        r.pos := r.pos + 1
        return Ok(0)
    if peek(r) <> '+' and peek(r) <> '-' then
        return Err(failure(r, "expected 'Z' or an offset"))
    let negative := peek(r) = '-'
    r.pos := r.pos + 1
    let hourAt := r.pos
    let hours := try digits(var r, count: 2)
    _ := try check(var r, start: hourAt, n: hours, high: 18, what: "offset")
    _ := try expect(var r, c: ':')
    let minuteAt := r.pos
    let minutes := try digits(var r, count: 2)
    _ := try check(var r, start: minuteAt, n: minutes, high: 59, what: "offset")
    let s := (hours * 60 + minutes) * 60
    return Ok(if negative then -s else s)

function finish(r: Reader): Result[Integer, String]
    if not atEnd(r) then
        return Err(failure(r, "unexpected text"))
    return Ok(0)

{ Reads ISO-8601 text such as `2026-11-10`. }
export function parseDate(s: String): Result[LocalDate, String]
    var r := reader(s)
    let d := try readDate(var r)
    _ := try finish(r)
    return Ok(d)

{ Reads ISO-8601 text such as `09:30`, `09:30:15` or `09:30:15.250`. }
export function parseTime(s: String): Result[LocalTime, String]
    var r := reader(s)
    let t := try readTime(var r)
    _ := try finish(r)
    return Ok(t)

{ Reads ISO-8601 text such as `2026-11-10T09:30:15`. }
export function parseDateTime(s: String): Result[LocalDateTime, String]
    var r := reader(s)
    let dt := try readDateTime(var r)
    _ := try finish(r)
    return Ok(dt)

{ Reads ISO-8601 text with a `Z` or an offset, such as `2026-11-10T09:30:15Z` or
  `2026-11-10T10:30:15+01:00`. }
export function parseInstant(s: String): Result[Instant, String]
    var r := reader(s)
    let dt := try readDateTime(var r)
    let offset := try readOffset(var r)
    _ := try finish(r)
    return Ok(toInstant(dt, offsetSeconds: offset))

{ Reads an ISO-8601 duration of days, hours, minutes and seconds, such as `PT8H6M12.5S`,
  `P2DT3H` or `-PT1S`. A day is 24 hours. }
export function parseDuration(s: String): Result[Duration, String]
    var r := reader(s)
    let negative := peek(r) = '-'
    if negative or peek(r) = '+' then
        r.pos := r.pos + 1
    _ := try expect(var r, c: 'P')
    var total := ofSeconds(0)
    var seen := false
    if peek(r) <> 'T' then
        let days := try number(var r)
        _ := try expect(var r, c: 'D')
        total := ofDays(days)
        seen := true
    if peek(r) = 'T' then
        r.pos := r.pos + 1
        var units := "HMS"
        while not atEnd(r) do
            let n := try number(var r)
            let nanos := try nanosPart(var r)
            let u := peek(r)
            if u = 'H' and units = "HMS" and nanos = 0 then
                total := plus(total, b: ofHours(n))
                units := "MS"
            else if u = 'M' and (units = "HMS" or units = "MS") and nanos = 0 then
                total := plus(total, b: ofMinutes(n))
                units := "S"
            else if u = 'S' and units <> "" then
                total := plus(total, b: ofSeconds(n, nanos: nanos))
                units := ""
            else
                return Err(failure(r, "expected a unit"))
            r.pos := r.pos + 1
            seen := true
        if units = "HMS" then
            return Err(failure(r, "expected a digit"))
    if not seen then
        return Err(failure(r, "expected a digit"))
    _ := try finish(r)
    return Ok(if negative then negated(total) else total)

{ -------------------------------------------------------------------- time zones }

{ The directory with the tzdata files: `TZDIR`, or `/usr/share/zoneinfo`. }
function zoneDir(): String
    case env("TZDIR") of
        Some(d):
            if byteLen(d.value) > 0 then
                return d.value
        None:
            pass
    return "/usr/share/zoneinfo"

{ Coordinated Universal Time. }
export function utc(): Zone
    return Zone(
        zid: "UTC",
        times: [],
        kinds: [],
        offsets: [0],
        dsts: [false],
        abbrevs: ["UTC"],
        rule: None,
    )

{ A zone that is always `offsetSeconds` east of UTC. Its name is empty. }
export function fixedZone(offsetSeconds: Integer): Zone
    requires offsetSeconds > -SecondsPerDay and offsetSeconds < SecondsPerDay
    return Zone(
        zid: "",
        times: [],
        kinds: [],
        offsets: [offsetSeconds],
        dsts: [false],
        abbrevs: [offsetText(offsetSeconds)],
        rule: None,
    )

{ The IANA time zone `name`, such as `Europe/Amsterdam`, read from the tzdata files. }
export unsafe function zone(name: String): Result[Zone, String]
    if byteLen(name) = 0 or startsWith(name, prefix: "/") or pos(name, sub: "..").isSome() then
        return Err("invalid time zone name '{name}'")
    return readZone("{zoneDir()}/{name}", name: name)

{ The system's time zone: the one `TZ` names (a tzdata name, a file, or a POSIX TZ rule),
  or else the one `/etc/localtime` links to. }
export unsafe function systemZone(): Result[Zone, String]
    var tz := getOr(env("TZ"), default: "")
    if startsWith(tz, prefix: ":") then
        tz := slice(tz, 1, stop: byteLen(tz))
    if byteLen(tz) > 0 then
        if startsWith(tz, prefix: "/") then
            return readZone(tz, name: nameFromPath(tz))
        case zone(tz) of
            Ok(z):
                return Ok(z.value)
            Err(_):
                pass
        let rule := try parseRule(tz)
        return Ok(Zone(
            zid: tz,
            times: [],
            kinds: [],
            offsets: [rule.stdOffset],
            dsts: [false],
            abbrevs: [rule.stdAbbr],
            rule: Some(rule),
        ))
    let path := getOr(realPath("/etc/localtime"), default: "/etc/localtime")
    return readZone(path, name: nameFromPath(path))

{ The zone name in a path under a `zoneinfo` directory, or the path itself. }
function nameFromPath(path: String): String
    case pos(path, sub: "/zoneinfo/") of
        Some(at):
            return slice(path, at.value + 10, stop: byteLen(path))
        None:
            return path

unsafe function readZone(path: String, name: String): Result[Zone, String]
    let f := try open(path)
    let data := try readBytes(f)
    case parseTzif(data, name: name) of
        Ok(z):
            return Ok(z.value)
        Err(e):
            return Err("{path}: {e.error}")

{ The zone's name, such as `Europe/Amsterdam`; empty for a fixed offset. }
export function name(z: Zone): String
    return z.zid

{ The zone's name, or for a fixed offset the offset, such as `+05:30`. }
export function toString(z: Zone): String
    return if byteLen(z.zid) > 0 then z.zid else offsetText(z.offsets[0])

{ The offset of `z` from UTC at `i`, in seconds east. }
export function offsetAt(z: Zone, i: Instant): Integer
    let k := kindAt(z, seconds: i.secs)
    if k >= 0 then
        return z.offsets[k]
    let rule := z.rule.get()
    return if ruleIsDst(rule, seconds: i.secs) then rule.dstOffset else rule.stdOffset

{ Whether `z` is on daylight saving time at `i`. }
export function isDstAt(z: Zone, i: Instant): Boolean
    let k := kindAt(z, seconds: i.secs)
    return if k >= 0 then z.dsts[k] else ruleIsDst(z.rule.get(), seconds: i.secs)

{ The abbreviation `z` uses at `i`, such as `CET` or `-03`. }
export function abbreviationAt(z: Zone, i: Instant): String
    let k := kindAt(z, seconds: i.secs)
    if k >= 0 then
        return z.abbrevs[k]
    let rule := z.rule.get()
    return if ruleIsDst(rule, seconds: i.secs) then rule.dstAbbr else rule.stdAbbr

{ The time type in effect at `seconds`, or -1 when the POSIX rule decides. }
function kindAt(z: Zone, seconds: Integer): Integer
    let n := length(z.times)
    if n = 0 or seconds >= z.times[n - 1] then
        if z.rule.isSome() then
            return -1
    if n = 0 or seconds < z.times[0] then
        return 0
    { The last transition at or before `seconds`. }
    var lo := 0
    var hi := n - 1
    while lo < hi do
        let mid := (lo + hi + 1) div 2
        if z.times[mid] <= seconds then
            lo := mid
        else
            hi := mid - 1
    return z.kinds[lo]

{ ---------------------------------------------------------------------- TZif files }

{ The signed big-endian integer in the `size` bytes at `at`. }
function bigEndian(bs: List[Byte], at, size: Integer): Integer
    var n := Integer(bs[at])
    if n >= 128 then
        n := n - 256
    for k := 1 to size - 1 do
        n := n * 256 + Integer(bs[at + k])
    return n

{ The bytes from `at` up to a NUL or `stop`, as text. }
unsafe function textAt(bs: List[Byte], at, stop: Integer): String
    var part: List[Byte] := []
    var k := at
    while k < stop and bs[k] <> 0 do
        add(var part, bs[k])
        k := k + 1
    return fromBytes(part)

{ Reads a TZif file (RFC 8536), version 1 to 4. Leap second records are ignored. }
unsafe function parseTzif(bs: List[Byte], name: String): Result[Zone, String]
    if length(bs) < 44 or textAt(bs, 0, stop: 4) <> "TZif" then
        return Err("not a TZif file")
    var at := 0
    var size := 4
    if bs[4] >= $32 then
        { Skip the version 1 data, which has 32-bit times. }
        at := 44 + blockSize(bs, at: 0, size: 4)
        size := 8
        if length(bs) < at + 44 or textAt(bs, at, stop: at + 4) <> "TZif" then
            return Err("truncated TZif file")
    let timeCount := bigEndian(bs, at + 32, size: 4)
    let typeCount := bigEndian(bs, at + 36, size: 4)
    let charCount := bigEndian(bs, at + 40, size: 4)
    let base := at + 44
    let stop := base + blockSize(bs, at: at, size: size)
    if typeCount = 0 or length(bs) < stop then
        return Err("truncated TZif file")
    var z := Zone(zid: name, times: [], kinds: [], offsets: [], dsts: [], abbrevs: [], rule: None)
    for k := 0 to timeCount - 1 do
        add(var z.times, bigEndian(bs, base + k * size, size: size))
        let kind := Integer(bs[base + timeCount * size + k])
        if kind >= typeCount then
            return Err("bad time type index")
        add(var z.kinds, kind)
    let types := base + timeCount * (size + 1)
    let chars := types + typeCount * 6
    for k := 0 to typeCount - 1 do
        add(var z.offsets, bigEndian(bs, types + k * 6, size: 4))
        add(var z.dsts, bs[types + k * 6 + 4] <> 0)
        let index := Integer(bs[types + k * 6 + 5])
        add(var z.abbrevs, textAt(bs, chars + index, stop: chars + charCount))
    if size = 8 and stop < length(bs) and bs[stop] = 10 then
        var k := stop + 1
        while k < length(bs) and bs[k] <> 10 do
            k := k + 1
        let footer := textAt(bs, stop + 1, stop: k)
        if byteLen(footer) > 0 then
            let rule := try parseRule(footer)
            z.rule := Some(rule)
    return Ok(z)

{ The size of the data block after the header at `at`, with `size`-byte times. }
function blockSize(bs: List[Byte], at, size: Integer): Integer
    let isUtCount := bigEndian(bs, at + 20, size: 4)
    let isStdCount := bigEndian(bs, at + 24, size: 4)
    let leapCount := bigEndian(bs, at + 28, size: 4)
    let timeCount := bigEndian(bs, at + 32, size: 4)
    let typeCount := bigEndian(bs, at + 36, size: 4)
    let charCount := bigEndian(bs, at + 40, size: 4)
    let leaps := leapCount * (size + 4)
    return timeCount * (size + 1) + typeCount * 6 + charCount + leaps + isStdCount + isUtCount

{ ----------------------------------------------------------------- POSIX TZ rules }

{ Reads a POSIX TZ rule such as `CET-1CEST,M3.5.0,M10.5.0/3` or `<-03>3`. }
function parseRule(s: String): Result[Rule, String]
    var r := reader(s)
    let stdAbbr := try readAbbr(var r)
    let west := try readHms(var r, maxHours: 24)
    let us := DayRule(kind: 'M', n: 3, week: 2, wd: 0, at: 7200)
    var rule := Rule(
        stdAbbr: stdAbbr,
        stdOffset: -west,
        dstAbbr: "",
        dstOffset: -west,
        begins: us,
        ends: DayRule(kind: 'M', n: 11, week: 1, wd: 0, at: 7200),
    )
    if atEnd(r) then
        return Ok(rule)
    let dstAbbr := try readAbbr(var r)
    rule.dstAbbr := dstAbbr
    rule.dstOffset := rule.stdOffset + 3600
    if not atEnd(r) and peek(r) <> ',' then
        let dstWest := try readHms(var r, maxHours: 24)
        rule.dstOffset := -dstWest
    if atEnd(r) then
        return Ok(rule)
    _ := try expect(var r, c: ',')
    let begins := try readDayRule(var r)
    _ := try expect(var r, c: ',')
    let ends := try readDayRule(var r)
    _ := try finish(r)
    rule.begins := begins
    rule.ends := ends
    return Ok(rule)

{ Reads an abbreviation: three or more letters, or anything between `<` and `>`. }
function readAbbr(var r: Reader): Result[String, String]
    let start := r.pos
    var parts: List[String] := []
    if peek(r) = '<' then
        r.pos := r.pos + 1
        while not atEnd(r) and peek(r) <> '>' do
            add(var parts, toString(peek(r)))
            r.pos := r.pos + 1
        _ := try expect(var r, c: '>')
    else
        while (peek(r) >= 'a' and peek(r) <= 'z') or (peek(r) >= 'A' and peek(r) <= 'Z') do
            add(var parts, toString(peek(r)))
            r.pos := r.pos + 1
    if length(parts) < 3 then
        r.pos := start
        return Err(failure(r, "expected a time zone abbreviation"))
    return Ok(join(parts))

{ Reads `[+-]hh[:mm[:ss]]` with at most `maxHours` hours, as seconds. }
function readHms(var r: Reader, maxHours: Integer): Result[Integer, String]
    let negative := peek(r) = '-'
    if negative or peek(r) = '+' then
        r.pos := r.pos + 1
    let hourAt := r.pos
    let hours := try number(var r)
    _ := try check(var r, start: hourAt, n: hours, high: maxHours, what: "hour")
    var s := hours * 3600
    if peek(r) = ':' then
        r.pos := r.pos + 1
        let minuteAt := r.pos
        let minutes := try digits(var r, count: 2)
        _ := try check(var r, start: minuteAt, n: minutes, high: 59, what: "minute")
        s := s + minutes * 60
        if peek(r) = ':' then
            r.pos := r.pos + 1
            let secondAt := r.pos
            let seconds := try digits(var r, count: 2)
            _ := try check(var r, start: secondAt, n: seconds, high: 59, what: "second")
            s := s + seconds
    return Ok(if negative then -s else s)

{ Reads `Jn`, `n` or `Mm.w.d`, then `/time` if there. }
function readDayRule(var r: Reader): Result[DayRule, String]
    var d := DayRule(kind: 'n', n: 0, week: 0, wd: 0, at: 7200)
    let start := r.pos
    if peek(r) = 'J' then
        r.pos := r.pos + 1
        d.kind := 'J'
    else if peek(r) = 'M' then
        r.pos := r.pos + 1
        d.kind := 'M'
    let numberAt := r.pos
    let n := try number(var r)
    d.n := n
    if d.kind = 'M' then
        _ := try expect(var r, c: '.')
        let week := try number(var r)
        _ := try expect(var r, c: '.')
        let wd := try number(var r)
        if n < 1 or n > 12 or week < 1 or week > 5 or wd > 6 then
            r.pos := start
            return Err(failure(r, "day rule out of range"))
        d.week := week
        d.wd := wd
    else if n > 365 or (d.kind = 'J' and n < 1) then
        r.pos := numberAt
        return Err(failure(r, "day out of range"))
    if peek(r) = '/' then
        r.pos := r.pos + 1
        let at := try readHms(var r, maxHours: 167)
        d.at := at
    return Ok(d)

{ The day of `year` that `d` names, as days since 1970-01-01. }
function ruleDay(d: DayRule, year: Integer): Integer
    let jan1 := toEpochDay(date(year, 1, 1))
    if d.kind = 'J' then
        return jan1 + d.n - 1 + (if isLeapYear(year) and d.n >= 60 then 1 else 0)
    if d.kind = 'n' then
        return jan1 + d.n
    let firstWd := (ord(weekday(date(year, d.n, 1))) + 1) mod 7
    var day := 1 + floorMod(d.wd - firstWd, 7) + (d.week - 1) * 7
    if day > monthLength(year, month: d.n) then
        day := day - 7
    return toEpochDay(date(year, d.n, day))

{ Whether `rule` has daylight saving time at `seconds` since 1970. }
function ruleIsDst(rule: Rule, seconds: Integer): Boolean
    if byteLen(rule.dstAbbr) = 0 then
        return false
    let year := ofEpochDay(floorDiv(seconds + rule.stdOffset, SecondsPerDay)).yr
    let begins := ruleDay(rule.begins, year: year) * SecondsPerDay + rule.begins.at - rule.stdOffset
    let ends := ruleDay(rule.ends, year: year) * SecondsPerDay + rule.ends.at - rule.dstOffset
    if begins < ends then
        return seconds >= begins and seconds < ends
    return seconds < ends or seconds >= begins

{ ----------------------------------------------------------------------- date-times }

{ `i` in zone `z`. }
export function inZone(i: Instant, z: Zone): DateTime
    return DateTime(inst: i, tz: z)

{ The current time in zone `z`. }
export unsafe function now(z: Zone): DateTime
    return DateTime(inst: now(), tz: z)

{ `dt` in zone `z`. In a gap (when clocks go forward) the time moves forward by the gap's
  length; in an overlap (when clocks go back) the earlier of the two instants is taken.
  Assumes a zone's offset changes at most once within a day of `dt`. }
export function atZone(dt: LocalDateTime, z: Zone): DateTime
    let local := toInstant(dt)
    let before := offsetAt(z, i: minus(local, d: ofDays(1)))
    let after := offsetAt(z, i: plus(local, d: ofDays(1)))
    var offset := before
    if offsetAt(z, i: minus(local, d: ofSeconds(before))) <> before then
        if offsetAt(z, i: minus(local, d: ofSeconds(after))) = after then
            offset := after
    return DateTime(inst: minus(local, d: ofSeconds(offset)), tz: z)

export function toInstant(dt: DateTime): Instant
    return dt.inst

export function zone(dt: DateTime): Zone
    return dt.tz

{ The offset from UTC at `dt`, in seconds east. }
export function offset(dt: DateTime): Integer
    return offsetAt(dt.tz, i: dt.inst)

export function toLocalDateTime(dt: DateTime): LocalDateTime
    return toLocalDateTime(dt.inst, offsetSeconds: offset(dt))

export function date(dt: DateTime): LocalDate
    return toLocalDateTime(dt).ld

export function time(dt: DateTime): LocalTime
    return toLocalDateTime(dt).lt

{ The year of `dt`'s local date-time in its zone, as are the accessors below. }
export function year(dt: DateTime): Integer
    return year(date(dt))

{ The month, 1 to 12. }
export function month(dt: DateTime): Integer
    return month(date(dt))

{ The day of the month, from 1. }
export function day(dt: DateTime): Integer
    return day(date(dt))

{ The day of the year, 1 to 366. }
export function dayOfYear(dt: DateTime): Integer
    return dayOfYear(date(dt))

export function weekday(dt: DateTime): Weekday
    return weekday(date(dt))

export function hour(dt: DateTime): Integer
    return hour(time(dt))

export function minute(dt: DateTime): Integer
    return minute(time(dt))

export function second(dt: DateTime): Integer
    return second(time(dt))

{ The nanoseconds within the second, 0 to 999_999_999. }
export function nano(dt: DateTime): Integer
    return nano(time(dt))

{ `dt` moved by an exact `d`, so across a change to summer time 24 hours may be 25 on
  the clock. }
export function plus(dt: DateTime, d: Duration): DateTime
    return DateTime(inst: plus(dt.inst, d: d), tz: dt.tz)

export function minus(dt: DateTime, d: Duration): DateTime
    return DateTime(inst: minus(dt.inst, d: d), tz: dt.tz)

{ `dt` moved by calendar days, keeping the local time where it exists (see `atZone`). }
export function plusDays(dt: DateTime, days: Integer): DateTime
    return atZone(plusDays(toLocalDateTime(dt), days: days), z: dt.tz)

export function plusMonths(dt: DateTime, months: Integer): DateTime
    return atZone(plusMonths(toLocalDateTime(dt), months: months), z: dt.tz)

export function plusYears(dt: DateTime, years: Integer): DateTime
    return atZone(plusYears(toLocalDateTime(dt), years: years), z: dt.tz)

{ Compares the instants, whatever the zones. }
export function compare(a, b: DateTime): Integer
    return compare(a.inst, b: b.inst)

export function isBefore(a, b: DateTime): Boolean
    return compare(a, b) < 0

export function isAfter(a, b: DateTime): Boolean
    return compare(a, b) > 0

{ `Z` for 0, else `+hh:mm`, or `+hh:mm:ss` when there are seconds. }
function offsetText(offsetSeconds: Integer): String
    if offsetSeconds = 0 then
        return "Z"
    let a := if offsetSeconds < 0 then -offsetSeconds else offsetSeconds
    let s := a mod 60
    let sign := if offsetSeconds < 0 then "-" else "+"
    let hm := "{sign}{pad(a div 3600, 2)}:{pad(a mod 3600 div 60, 2)}"
    return if s = 0 then hm else "{hm}:{pad(s, 2)}"

{ ISO-8601 text with the offset and, for a named zone, the name in brackets:
  `2026-11-10T09:30:00+01:00[Europe/Amsterdam]`. }
export function toString(dt: DateTime): String
    let text := "{toLocalDateTime(dt)}{offsetText(offset(dt))}"
    return if byteLen(dt.tz.zid) > 0 then "{text}[{dt.tz.zid}]" else text

{ Reads ISO-8601 text with an offset and an optional zone name in brackets, such as
  `2026-11-10T09:30:00+01:00[Europe/Amsterdam]`. Without a name the zone is the fixed
  offset. With one, the instant comes from the offset, and the zone is read with `zone`. }
export unsafe function parseZoned(s: String): Result[DateTime, String]
    var r := reader(s)
    let dt := try readDateTime(var r)
    let offset := try readOffset(var r)
    let i := toInstant(dt, offsetSeconds: offset)
    if atEnd(r) then
        return Ok(DateTime(inst: i, tz: fixedZone(offset)))
    _ := try expect(var r, c: '[')
    var parts: List[String] := []
    while not atEnd(r) and peek(r) <> ']' do
        add(var parts, toString(peek(r)))
        r.pos := r.pos + 1
    _ := try expect(var r, c: ']')
    _ := try finish(r)
    let z := try zone(join(parts))
    return Ok(DateTime(inst: i, tz: z))

{ ------------------------------------------------------------------------- periods }

export function period(years: Integer := 0, months: Integer := 0, days: Integer := 0): Period
    return Period(ys: years, ms: months, ds: days)

export function years(p: Period): Integer
    return p.ys

export function months(p: Period): Integer
    return p.ms

export function days(p: Period): Integer
    return p.ds

export function isZero(p: Period): Boolean
    return p.ys = 0 and p.ms = 0 and p.ds = 0

export function plus(a, b: Period): Period
    return Period(ys: a.ys + b.ys, ms: a.ms + b.ms, ds: a.ds + b.ds)

export function negated(p: Period): Period
    return Period(ys: -p.ys, ms: -p.ms, ds: -p.ds)

{ `p` with whole years taken out of the months, so P1Y14M becomes P2Y2M. The years and
  months keep the same sign; the days don't change. }
export function normalized(p: Period): Period
    let total := p.ys * 12 + p.ms
    return Period(ys: total div 12, ms: total mod 12, ds: p.ds)

{ `d` moved by the years and months of `p` (a day past the new month's end becomes its
  last day), then by its days. }
export function plus(d: LocalDate, p: Period): LocalDate
    return plusDays(plusMonths(d, months: p.ys * 12 + p.ms), days: p.ds)

export function minus(d: LocalDate, p: Period): LocalDate
    return plus(d, p: negated(p))

export function plus(dt: LocalDateTime, p: Period): LocalDateTime
    return LocalDateTime(ld: plus(dt.ld, p: p), lt: dt.lt)

export function minus(dt: LocalDateTime, p: Period): LocalDateTime
    return plus(dt, p: negated(p))

{ `dt` moved by `p` on the calendar, keeping the local time where it exists (see
  `atZone`). }
export function plus(dt: DateTime, p: Period): DateTime
    return atZone(plus(toLocalDateTime(dt), p: p), z: dt.tz)

export function minus(dt: DateTime, p: Period): DateTime
    return plus(dt, p: negated(p))

{ The years, months and days from `a` to `b`, all negative if `b` is before `a`. When `b`
  isn't before `a`, adding it to `a` gives `b`; going back, a month's end can be clamped
  (2024-03-31 minus P1M is 2024-02-29). }
export function between(a, b: LocalDate): Period
    var total := b.yr * 12 + b.mon - (a.yr * 12 + a.mon)
    var days := b.dom - a.dom
    if total > 0 and days < 0 then
        total := total - 1
        days := toEpochDay(b) - toEpochDay(plusMonths(a, months: total))
    else if total < 0 and days > 0 then
        total := total + 1
        days := days - monthLength(b.yr, month: b.mon)
    return Period(ys: total div 12, ms: total mod 12, ds: days)

{ ISO-8601 text such as `P1Y2M3D`, leaving out zero parts; `P0D` when all are zero. }
export function toString(p: Period): String
    if isZero(p) then
        return "P0D"
    var parts := ["P"]
    if p.ys <> 0 then
        add(var parts, "{p.ys}Y")
    if p.ms <> 0 then
        add(var parts, "{p.ms}M")
    if p.ds <> 0 then
        add(var parts, "{p.ds}D")
    return join(parts)

{ Reads an ISO-8601 period of years, months, weeks and days, such as `P1Y2M3D`, `P2W`
  or `-P1M` (which negates every part). A part may have its own sign: `P1Y-2M`. A week
  is 7 days. }
export function parsePeriod(s: String): Result[Period, String]
    var r := reader(s)
    let negative := peek(r) = '-'
    if negative or peek(r) = '+' then
        r.pos := r.pos + 1
    _ := try expect(var r, c: 'P')
    var p := period()
    var units := "YMWD"
    while not atEnd(r) do
        let partNegative := peek(r) = '-'
        if partNegative or peek(r) = '+' then
            r.pos := r.pos + 1
        let raw := try number(var r)
        let n := if partNegative then -raw else raw
        let u := peek(r)
        let at := pos(units, sub: toString(u))
        if u = 'P' or at.isNone() then
            return Err(failure(r, "expected a unit"))
        if u = 'Y' then
            p.ys := n
        else if u = 'M' then
            p.ms := n
        else if u = 'W' then
            p.ds := p.ds + n * 7
        else
            p.ds := p.ds + n
        units := slice(units, at.get() + 1, stop: byteLen(units))
        r.pos := r.pos + 1
    if byteLen(units) = 4 then
        return Err(failure(r, "expected a digit"))
    return Ok(if negative then negated(p) else p)

{ ----------------------------------------------------------------------- intervals }

{ The instants from `start` up to, not including, `end`. }
export function interval(start, end: Instant): Interval
    requires not isAfter(start, b: end)
    return Interval(lo: start, hi: end)

{ The interval of length `d` from `start`. }
export function interval(start: Instant, d: Duration): Interval
    return interval(start, end: plus(start, d: d))

export function start(iv: Interval): Instant
    return iv.lo

{ The first instant after the interval. }
export function end(iv: Interval): Instant
    return iv.hi

export function duration(iv: Interval): Duration
    return between(iv.lo, b: iv.hi)

{ Whether `i` is in `iv`: at or after its start and before its end. }
export function contains(iv: Interval, i: Instant): Boolean
    return not isBefore(i, b: iv.lo) and isBefore(i, b: iv.hi)

{ Whether `a` and `b` share an instant. }
export function overlaps(a, b: Interval): Boolean
    return isBefore(a.lo, b: b.hi) and isBefore(b.lo, b: a.hi)

{ Whether one ends where the other starts. }
export function abuts(a, b: Interval): Boolean
    return a.hi = b.lo or b.hi = a.lo

{ The instants in both `a` and `b`, if they overlap. }
export function overlap(a, b: Interval): Option[Interval]
    if not overlaps(a, b) then
        return None
    let lo := if isAfter(a.lo, b: b.lo) then a.lo else b.lo
    let hi := if isBefore(a.hi, b: b.hi) then a.hi else b.hi
    return Some(Interval(lo: lo, hi: hi))

{ The instants between `a` and `b`, if they neither overlap nor abut. }
export function gap(a, b: Interval): Option[Interval]
    if isBefore(a.hi, b: b.lo) then
        return Some(Interval(lo: a.hi, hi: b.lo))
    if isBefore(b.hi, b: a.lo) then
        return Some(Interval(lo: b.hi, hi: a.lo))
    return None

{ ISO-8601 text: the start and the end, such as
  `2026-11-10T09:00:00Z/2026-11-10T17:00:00Z`. }
export function toString(iv: Interval): String
    return "{iv.lo}/{iv.hi}"

{ Reads an ISO-8601 interval: `start/end`, `start/duration` or `duration/end`, with
  the instants as `parseInstant` reads them and the durations as `parseDuration`. }
export function parseInterval(s: String): Result[Interval, String]
    let parts := split(s, sep: "/")
    if length(parts) <> 2 then
        return Err("expected one '/'")
    let first := parts[0]
    let second := parts[1]
    let a := if startsWith(first, prefix: "P") or startsWith(first, prefix: "-P") then 1 else 0
    let b := if startsWith(second, prefix: "P") or startsWith(second, prefix: "-P") then 1 else 0
    if a = 1 and b = 1 then
        return Err("expected an instant before or after the '/'")
    var lo := ofEpochSecond(0)
    var hi := lo
    if a = 1 then
        let d := try located(parseDuration(first), offset: 0, partEnd: charCount(first))
        hi := try located(parseInstant(second), offset: charCount(first) + 1)
        lo := minus(hi, d: d)
    else if b = 1 then
        lo := try located(parseInstant(first), offset: 0, partEnd: charCount(first))
        let d := try located(parseDuration(second), offset: charCount(first) + 1)
        hi := plus(lo, d: d)
    else
        lo := try located(parseInstant(first), offset: 0, partEnd: charCount(first))
        hi := try located(parseInstant(second), offset: charCount(first) + 1)
    if isAfter(lo, b: hi) then
        return Err("the end is before the start")
    return Ok(Interval(lo: lo, hi: hi))

{ `r`, with `offset` added to the offset in its error. With `partEnd`, an error at the
  end of the text is at that offset instead. }
function located[T](
    r: Result[T, String],
    offset: Integer,
    partEnd: Integer := -1,
): Result[T, String]
    case r of
        Ok(v):
            return Ok(v.value)
        Err(e):
            if partEnd >= 0 and endsWith(e.error, suffix: " at the end of the text") then
                let what := slice(e.error, 0, stop: byteLen(e.error) - 23)
                return Err("{what} at offset {partEnd}")
            let words := split(e.error, sep: " at offset ")
            if length(words) = 2 then
                let n := parseInt(words[1]).get()
                return Err("{words[0]} at offset {n + offset}")
            return Err(e.error)

{ --------------------------------------------------------------------------- tests }

test "durations"
    assert toString(ofSeconds(29_166, nanos: 345_000_000)) = "PT8H6M6.345S"
    assert toString(ofSeconds(0)) = "PT0S" and toString(ofMillis(-1500)) = "-PT1.500S"
    assert toString(ofDays(2)) = "PT48H" and toString(ofNanos(5)) = "PT0.000000005S"
    let d := ofMillis(-1500)
    assert seconds(d) = -2 and nanos(d) = 500_000_000 and toMillis(d) = -1500
    assert plus(ofSeconds(1, nanos: 600_000_000), b: ofMillis(500)) = ofMillis(2100)
    assert isLonger(ofMinutes(1), b: ofSeconds(59)) and isShorter(ofMillis(-1), b: ofSeconds(0))
    assert times(ofMillis(250), n: 6) = ofMillis(1500) and toNanos(ofMillis(3)) = 3_000_000

test "dates"
    assert toEpochDay(date(1970, 1, 1)) = 0 and ofEpochDay(0) = date(1970, 1, 1)
    assert toEpochDay(date(2000, 3, 1)) = 11_017 and ofEpochDay(-1) = date(1969, 12, 31)
    assert ofEpochDay(toEpochDay(date(-4713, 11, 24))) = date(-4713, 11, 24)
    assert weekday(date(2026, 11, 10)) = Weekday.Tuesday
    assert weekday(date(1969, 12, 28)) = Weekday.Sunday
    assert dayOfYear(date(2024, 12, 31)) = 366 and dayOfYear(date(2023, 3, 1)) = 60
    assert plusMonths(date(2024, 1, 31), months: 1) = date(2024, 2, 29)
    assert plusMonths(date(2024, 1, 15), months: -13) = date(2022, 12, 15)
    assert plusYears(date(2024, 2, 29), years: 1) = date(2025, 2, 28)
    assert plusDays(date(2026, 12, 31), days: 1) = date(2027, 1, 1)
    assert daysBetween(date(2026, 1, 1), b: date(2027, 1, 1)) = 365
    assert isBefore(date(1999, 12, 31), b: date(2000, 1, 1))
    assert toString(date(987, 6, 5)) = "0987-06-05"
    assert toString(date(-44, 3, 15)) = "-0044-03-15"
    assert toString(date(12_345, 1, 1)) = "+12345-01-01"
    assert not isValidDate(2023, 2, 29) and not isValidDate(1900, 2, 29)
    assert isValidDate(2000, 2, 29)

test "times"
    assert toString(time(9, 5)) = "09:05:00"
    assert toString(time(23, 59, second: 59, nano: 1)) = "23:59:59.000000001"
    assert toString(time(0, 0, second: 1, nano: 250_000_000)) = "00:00:01.250"
    assert toString(time(0, 0, nano: 120_000)) = "00:00:00.000120"
    assert plus(time(23, 0), d: ofHours(2)) = time(1, 0)
    assert minus(time(1, 0), d: ofHours(2)) = time(23, 0)
    assert plus(time(12, 0), d: ofDays(-3)) = noon() and isBefore(midnight(), b: noon())
    let t := time(13, 14, second: 15, nano: 16)
    assert ofNanoOfDay(toNanoOfDay(t)) = t

test "instants"
    let i := ofEpochSecond(1_700_000_000, nanos: 5_000_000)
    assert toString(i) = "2023-11-14T22:13:20.005Z" and toEpochMilli(i) = 1_700_000_000_005
    assert toString(ofEpochMilli(-1)) = "1969-12-31T23:59:59.999Z"
    assert between(i, b: plus(i, d: ofMinutes(90))) = ofMinutes(90)
    let later := time(23, 13, second: 20, nano: 5_000_000)
    assert toLocalDateTime(i, offsetSeconds: 3600) = dateTime(date(2023, 11, 14), time: later)
    assert toInstant(toLocalDateTime(i, offsetSeconds: -18_000), offsetSeconds: -18_000) = i
    assert isAfter(now(), b: i)
    let dt := dateTime(date(2024, 2, 28), time: time(23, 30))
    assert plus(dt, d: ofHours(1)) = dateTime(date(2024, 2, 29), time: time(0, 30))
    assert toString(plusMonths(dt, months: 12)) = "2025-02-28T23:30:00"

test "parsing"
    assert parseDate("2026-11-10") = Ok(date(2026, 11, 10))
    assert parseDate("+12345-01-01") = Ok(date(12_345, 1, 1))
    assert parseDate("-0044-03-15") = Ok(date(-44, 3, 15))
    assert parseDate("2023-02-29") = Err("day out of range at offset 8")
    assert parseDate("2026-1-10") = Err("expected a digit at offset 6")
    assert parseDate("2026-11-10x") = Err("unexpected text at offset 10")
    assert parseTime("09:30") = Ok(time(9, 30))
    assert parseTime("09:30:15,5") = Ok(time(9, 30, second: 15, nano: 500_000_000))
    assert parseTime("24:00") = Err("hour out of range at offset 0")
    assert parseTime("09:30:") = Err("expected a digit at the end of the text")
    assert parseDateTime("2026-11-10T09:30") = Ok(dateTime(date(2026, 11, 10), time: time(9, 30)))
    let i := ofEpochSecond(1_700_000_000, nanos: 5_000_000)
    assert parseInstant("2023-11-14T22:13:20.005Z") = Ok(i)
    assert parseInstant("2023-11-14T23:13:20+01:00") = Ok(ofEpochSecond(1_700_000_000))
    assert parseInstant("2023-11-14T22:13:20") = Err(
        "expected 'Z' or an offset at the end of the text",
    )
    assert parseDuration("PT8H6M6.345S") = Ok(ofSeconds(29_166, nanos: 345_000_000))
    assert parseDuration("P2DT3H") = Ok(ofHours(51))
    assert parseDuration("-PT1.5S") = Ok(ofMillis(-1500))
    assert parseDuration("PT") = Err("expected a digit at the end of the text")
    assert parseDuration("PT1S2M") = Err("expected a unit at offset 5")
    for s in ["PT0S", "PT48H", "-PT0.000000005S", "PT1H0.5S"] do
        assert toString(parseDuration(s).get()) = (if s = "PT1H0.5S" then "PT1H0.500S" else s)

test "POSIX TZ rules"
    let us := parseRule("EST5EDT,M3.2.0,M11.1.0").get()
    assert us.stdOffset = -18_000 and us.dstOffset = -14_400 and us.dstAbbr = "EDT"
    { 2026-03-08 07:00Z is 02:00 EST, when summer time begins; 2026-11-01 06:00Z ends it. }
    assert not ruleIsDst(us, seconds: 1_772_953_199) and ruleIsDst(us, seconds: 1_772_953_200)
    assert ruleIsDst(us, seconds: 1_793_512_799) and not ruleIsDst(us, seconds: 1_793_512_800)
    let south := parseRule("<+1030>-10:30<+11>-11,M10.1.0,M4.1.0").get()
    assert south.stdAbbr = "+1030" and south.stdOffset = 37_800 and south.dstOffset = 39_600
    assert ruleIsDst(south, seconds: 1_768_478_400) and not ruleIsDst(south, seconds: 1_784_116_800)
    let j := parseRule("XXX3YYY,J60/-1,300/26").get()
    assert j.begins.kind = 'J' and j.begins.at = -3600 and j.ends.n = 300 and j.ends.at = 93_600
    assert ruleDay(j.begins, year: 2024) = toEpochDay(date(2024, 3, 1))
    assert ruleDay(j.ends, year: 2024) = toEpochDay(date(2024, 10, 27))
    assert parseRule("<-03>3").get().dstAbbr = ""
    assert parseRule("AB1") = Err("expected a time zone abbreviation at offset 0")
    assert parseRule("EST5EDT,M13.1.0,M11.1.0") = Err("day rule out of range at offset 8")

test "tzdata zones"
    let ams := zone("Europe/Amsterdam").get()
    let winter := parseInstant("2026-01-15T12:00:00Z").get()
    let summer := parseInstant("2026-07-15T12:00:00Z").get()
    assert offsetAt(ams, i: winter) = 3600 and abbreviationAt(ams, i: winter) = "CET"
    assert offsetAt(ams, i: summer) = 7200 and isDstAt(ams, i: summer)
    assert toString(inZone(summer, z: ams)) = "2026-07-15T14:00:00+02:00[Europe/Amsterdam]"
    let future := parseInstant("2100-07-15T12:00:00Z").get()
    assert offsetAt(ams, i: future) = 7200 and abbreviationAt(ams, i: future) = "CEST"
    let syd := zone("Australia/Sydney").get()
    assert offsetAt(syd, i: winter) = 39_600 and offsetAt(syd, i: summer) = 36_000
    { Past the last transition the rule takes over; it must agree with the transitions. }
    let ny := zone("America/New_York").get()
    for z in [ams, ny, syd] do
        let rule := z.rule.get()
        for day := 0 to 365 do
            let i := plus(
                parseInstant("2027-01-01T00:30:00Z").get(),
                d: ofHours(day * 24 + day mod 24),
            )
            assert offsetAt(z, i: i) = (
                if ruleIsDst(rule, seconds: i.secs) then rule.dstOffset else rule.stdOffset
            )
    assert zone("Nope/Where").isErr() and zone("../etc/passwd").isErr()
    assert zone("zone.tab") = Err("{zoneDir()}/zone.tab: not a TZif file")

test "zoned date-times"
    let ams := zone("Europe/Amsterdam").get()
    let gap := atZone(parseDateTime("2026-03-29T02:30").get(), z: ams)
    assert toString(gap) = "2026-03-29T03:30:00+02:00[Europe/Amsterdam]"
    let overlap := atZone(parseDateTime("2026-10-25T02:30").get(), z: ams)
    assert offset(overlap) = 7200 and offset(plus(overlap, d: ofHours(1))) = 3600
    let noon := atZone(parseDateTime("2026-03-28T12:00").get(), z: ams)
    assert time(plusDays(noon, days: 1)) = time(12, 0)
    assert time(plus(noon, d: ofDays(1))) = time(13, 0)
    assert date(plusMonths(noon, months: 1)) = date(2026, 4, 28)
    let parsed := parseZoned("2026-11-10T09:30:00+01:00[Europe/Amsterdam]").get()
    assert toString(parsed) = "2026-11-10T09:30:00+01:00[Europe/Amsterdam]"
    assert name(zone(parsed)) = "Europe/Amsterdam"
    let fixed := parseZoned("2026-11-10T09:30:00-03:00").get()
    assert toString(fixed) = "2026-11-10T09:30:00-03:00" and compare(fixed, b: parsed) > 0
    assert toString(zone(fixed)) = "-03:00"
    assert toString(inZone(ofEpochSecond(0), z: utc())) = "1970-01-01T00:00:00Z[UTC]"
    assert offsetText(-12_345) = "-03:25:45" and toString(fixedZone(19_800)) = "+05:30"
    let local := toLocalDateTime(parsed)
    assert year(parsed) = 2026 and month(parsed) = 11 and day(parsed) = 10
    assert dayOfYear(parsed) = 314 and weekday(parsed) = Weekday.Tuesday
    assert hour(parsed) = 9 and minute(parsed) = 30 and second(parsed) = 0 and nano(parsed) = 0
    assert year(local) = 2026 and dayOfYear(local) = 314 and weekday(local) = Weekday.Tuesday
    assert hour(local) = 9 and minute(local) = 30 and second(local) = 0 and nano(local) = 0
    assert hour(fixed) = 9 and day(inZone(toInstant(fixed), z: ams)) = 10
    let epoch := inZone(ofEpochSecond(0), z: utc())
    assert name(zone(now(utc()))) = "UTC" and isAfter(now(utc()), b: epoch)

test "periods"
    let p := period(years: 1, months: 2, days: 3)
    assert toString(p) = "P1Y2M3D" and toString(period()) = "P0D"
    assert toString(period(months: -1)) = "P-1M"
    assert toString(normalized(period(months: 26))) = "P2Y2M"
    assert plus(date(2024, 1, 31), p: period(months: 1, days: 1)) = date(2024, 3, 1)
    assert minus(date(2024, 3, 31), p: period(months: 1)) = date(2024, 2, 29)
    assert between(date(2024, 1, 31), b: date(2024, 3, 1)) = period(months: 1, days: 1)
    let back := period(years: -1, months: -1, days: -26)
    assert between(date(2026, 3, 15), b: date(2025, 1, 20)) = back
    let leap := date(2000, 2, 29)
    assert between(leap, b: date(2026, 11, 10)) = period(years: 26, months: 8, days: 12)
    let a := date(1999, 12, 31)
    for k := 0 to 800 do
        let b := plusDays(a, days: k)
        assert plus(a, p: between(a, b: b)) = b
    let ams := zone("Europe/Amsterdam").get()
    let noon := atZone(parseDateTime("2026-03-28T12:00").get(), z: ams)
    assert time(plus(noon, p: period(days: 1))) = time(12, 0)
    assert parsePeriod("P1Y2M3D") = Ok(p) and parsePeriod("P2W1D") = Ok(period(days: 15))
    assert parsePeriod("-P1Y-2M") = Ok(period(years: -1, months: 2))
    assert parsePeriod("P") = Err("expected a digit at the end of the text")
    assert parsePeriod("P1D2Y") = Err("expected a unit at offset 4")
    assert parsePeriod("P1Y1Y") = Err("expected a unit at offset 4")

test "intervals"
    let nine := parseInstant("2026-11-10T09:00:00Z").get()
    let day := interval(nine, d: ofHours(8))
    assert toString(day) = "2026-11-10T09:00:00Z/2026-11-10T17:00:00Z"
    assert duration(day) = ofHours(8) and start(day) = nine and end(day) = plus(nine, d: ofHours(8))
    assert contains(day, i: nine) and not contains(day, i: end(day))
    let lunch := interval(plus(nine, d: ofHours(3)), d: ofHours(1))
    let evening := interval(end(day), d: ofHours(4))
    assert overlaps(day, b: lunch) and not overlaps(day, b: evening) and abuts(day, b: evening)
    assert overlap(day, b: lunch) = Some(lunch) and overlap(day, b: evening).isNone()
    assert gap(lunch, b: evening) = Some(interval(end(lunch), end: end(day)))
    assert parseInterval("2026-11-10T09:00:00Z/2026-11-10T17:00:00Z") = Ok(day)
    assert parseInterval("2026-11-10T09:00:00Z/PT8H") = Ok(day)
    assert parseInterval("PT8H/2026-11-10T17:00:00Z") = Ok(day)
    assert parseInterval(
        "2026-11-10T09:00:00Z/2026-11-10T08:00Z",
    ) = Err("the end is before the start")
    assert parseInterval("2026-11-10T09:00/PT1H") = Err("expected 'Z' or an offset at offset 16")
    assert parseInterval("2026-11-10T09:00:00Z/PT1X") = Err("expected a unit at offset 24")
    assert parseInterval("PT1H/PT1H") = Err("expected an instant before or after the '/'")
