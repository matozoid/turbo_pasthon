unit Math

{ Numeric functions. }

const
    export Pi = 3.141592653589793

external "libm.so.6"
    export function sqrt(x: Real): Real
    export function sin(x: Real): Real
    export function cos(x: Real): Real
    function cFloor(x: Real): Real name "floor"
    function cCeil(x: Real): Real name "ceil"

{ Largest integer not above `x`. }
export function floor(x: Real): Integer
    return toInt(cFloor(x))

{ Smallest integer not below `x`. }
export function ceil(x: Real): Integer
    return toInt(cCeil(x))

export function abs(x: Integer): Integer
    return if x < 0 then -x else x

export function abs(x: Real): Real
    return if x < 0.0 then -x else x

{ The smaller of `a` and `b`. }
export function min[T: Ordered](a, b: T): T
    return if b < a then b else a

{ The larger of `a` and `b`. }
export function max[T: Ordered](a, b: T): T
    return if b > a then b else a

test "integer helpers"
    assert abs(-3) = 3 and abs(4) = 4 and abs(0) = 0
    assert min(2, 7) = 2 and max(2, 7) = 7
    assert min('b', 'a') = 'a'

test "real functions"
    assert sqrt(2.0) * sqrt(2.0) - 2.0 < 1.0e-15 and sqrt(16.0) = 4.0
    assert sin(0.0) = 0.0 and cos(0.0) = 1.0 and abs(sin(Pi)) < 1.0e-15
    assert floor(2.5) = 2 and floor(-2.5) = -3 and ceil(2.5) = 3 and ceil(-2.5) = -2
    assert abs(-1.5) = 1.5 and min(1.5, b: 0.5) = 0.5 and max(1.5, b: 0.5) = 1.5
