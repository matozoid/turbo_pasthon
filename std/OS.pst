unit OS

## The process environment, on libc.

uses C, Bits

extern "libc.so.6"
    function getenv(name: CString): CString
    function getcwd(buf: Pointer, size: CSize): CString
    function cStat(path: CString, st: Ptr[Stat]): CInt as "stat"
    procedure free(p: CString)
    procedure freeMemory(p: Pointer) as "free"
    function malloc(size: CSize): Pointer
    function strdup(s: CString): CString
    function readlink(path: CString, buf: Pointer, size: CSize): CLong
    function realpath(path: CString, resolved: Pointer): CString
    function mkdtemp(template: CString): CString
    function unlink(path: CString): CInt
    function rmdir(path: CString): CInt
    function mkdir(path: CString, mode: CInt): CInt
    function chdir(path: CString): CInt
    function fork(): CInt
    function execv(path: CString, argv: Ptr[CString]): CInt
    procedure cExit(code: CInt) as "_exit"
    function alarm(seconds: CUInt): CUInt
    function waitpid(pid: CInt, status: Ptr[CInt], options: CInt): CInt
    function errnoLocation(): Ptr[CInt] as "__errno_location"
    function cOpen(path: CString, flags: CInt, ...): CInt as "open"
    function dup2(fd: CInt, fd2: CInt): CInt
    function opendir(path: CString): Pointer
    function readdir(dir: Pointer): Ptr[Byte]
    function closedir(dir: Pointer): CInt
    function strerror(code: CInt): CString
    type
        ## glibc's `struct stat` on x86-64: 144 bytes; `st_mode` is the low half of
        ## `w3`.
        Stat = record
            w0: UInt64
            w1: UInt64
            w2: UInt64
            w3: UInt64
            w4: UInt64
            w5: UInt64
            w6: UInt64
            w7: UInt64
            w8: UInt64
            w9: UInt64
            w10: UInt64
            w11: UInt64
            w12: UInt64
            w13: UInt64
            w14: UInt64
            w15: UInt64
            w16: UInt64
            w17: UInt64

extern "pst"
    ## The program's `argv`: a pointer to C strings, the program name first, ending with a
    ## null pointer.
    function argv(): Ptr[CString]

## Command line arguments, without the program name.
export unsafe function args(): List[String]
    var r: List[String] := []
    var p := argv() + 1
    while not isNull(deref(p)) do
        add(var r, fromCString(deref(p)))
        p := p + 1
    return r

## The value of environment variable `name`.
export function env(name: String): Option[String]
    let p := getenv(toCString(name))
    if isNull(p) then
        return None
    return Some(fromCString(p))

## Exits with status `code`, like `halt`.
export procedure exit(code: Integer)
    halt(code)

## The current working directory.
export unsafe function currentDir(): String
    let p := getcwd(cast[Pointer](0), CSize(0))
    if isNull(p) then
        return "."
    let dir := fromCString(p)
    free(p)
    return dir

## The absolute path of `path`, with symbolic links, `.` and `..` resolved.
export unsafe function realPath(path: String): Result[String, String]
    ## A buffer of PATH_MAX bytes: the unversioned symbol is glibc's first `realpath`,
    ## which doesn't allocate one.
    let buf := malloc(CSize(4096))
    if isNull(realpath(toCString(path), buf)) then
        let message := "{path}: {lastError()}"
        freeMemory(buf)
        return Err(message)
    let real := fromCString(cast[CString](buf))
    freeMemory(buf)
    return Ok(real)

## The file type bits of `path` (following symbolic links), or -1 if it doesn't exist.
unsafe function fileType(path: String): Integer
    var st := Stat(
        w0: 0,
        w1: 0,
        w2: 0,
        w3: 0,
        w4: 0,
        w5: 0,
        w6: 0,
        w7: 0,
        w8: 0,
        w9: 0,
        w10: 0,
        w11: 0,
        w12: 0,
        w13: 0,
        w14: 0,
        w15: 0,
        w16: 0,
        w17: 0,
    )
    if cStat(toCString(path), addr(var st)) <> 0 then
        return -1
    return Integer(band(st.w3, $F000))

## Whether `path` names a regular file (following symbolic links).
export function isFile(path: String): Boolean
    return fileType(path) = $8000

## Whether `path` names a directory (following symbolic links).
export function isDir(path: String): Boolean
    return fileType(path) = $4000

## The names of the entries of directory `path`, without `.` and `..`, in no particular
## order.
export unsafe function listDir(path: String): Result[List[String], String]
    let dir := opendir(toCString(path))
    if isNull(dir) then
        return Err("{path}: {lastError()}")
    var names: List[String] := []
    while true do
        let entry := readdir(dir)
        if isNull(entry) then
            break
        let name := fromCString(cast[CString](entry + 19))  # glibc's `d_name`
        if name <> "." and name <> ".." then
            add(var names, name)
    _ := closedir(dir)
    return Ok(names)

## The message for C's `errno`.
unsafe function lastError(): String
    return fromCString(strerror(deref(errnoLocation())))

## The path of the running executable, from `/proc/self/exe`.
export unsafe function programPath(): String
    let size := 4096
    let buf := malloc(CSize(size))
    let n := readlink(toCString("/proc/self/exe"), buf, CSize(size))
    var path := ""
    if n > 0 then
        path := fromCBytes(buf, Integer(n))
    freeMemory(buf)
    return path

## Creates a new directory, readable only by the user, under `TMPDIR` (or `/tmp`) and
## returns its path.
export unsafe function tempDir(): Result[String, String]
    var base := env("TMPDIR").getOr("")
    if base = "" then
        base := "/tmp"
    let template := strdup(toCString("{base}/pst-XXXXXX"))
    if isNull(mkdtemp(template)) then
        let message := "{base}: {lastError()}"
        free(template)
        return Err(message)
    let dir := fromCString(template)
    free(template)
    return Ok(dir)

## Makes `path` the current directory.
export unsafe function changeDir(path: String): Result[Integer, String]
    if chdir(toCString(path)) <> 0 then
        return Err("{path}: {lastError()}")
    return Ok(0)

## Deletes the file at `path`.
export unsafe function removeFile(path: String): Result[Integer, String]
    if unlink(toCString(path)) <> 0 then
        return Err("{path}: {lastError()}")
    return Ok(0)

## Creates the directory `path`, with permissions `mode` less the umask.
export unsafe function makeDir(path: String, mode: Integer := $1ED): Result[Integer, String]
    if mkdir(toCString(path), CInt(mode)) <> 0 then
        return Err("{path}: {lastError()}")
    return Ok(0)

## Deletes the empty directory at `path`.
export unsafe function removeDir(path: String): Result[Integer, String]
    if rmdir(toCString(path)) <> 0 then
        return Err("{path}: {lastError()}")
    return Ok(0)

## Runs the executable at `path` with arguments `args` and waits for it to finish. The
## result is its exit status, or minus the signal that ended it. If the program can't be
## started, the child process exits with status 127. With `output`, the program's standard
## output goes to that file, created or emptied, and so does its standard error unless
## `errors` names another file for it. With `input`, the program reads that file as its
## standard input. With `dir`, it runs in that directory; the paths of the files are
## relative to the current directory, not to `dir`.
export function run(
    path: String,
    args: List[String],
    output: String := "",
    errors: String := "",
    input: String := "",
    dir: String := "",
): Result[Integer, String]
    return launch(path, args, files: [output, errors, input, dir], timeout: 0)

## Runs a program like `run`, in the current directory, and ends it with the signal
## SIGALRM (14) if it is still running after `timeout` seconds.
export function runFor(
    path: String,
    args: List[String],
    timeout: Integer,
    output: String := "",
    errors: String := "",
    input: String := "",
): Result[Integer, String]
    return launch(path, args, files: [output, errors, input, ""], timeout: timeout)

## `run`, with its `output`, `errors`, `input` and `dir` in `files`, and the alarm after
## `timeout` seconds unless it is 0.
unsafe function launch(
    path: String,
    args: List[String],
    files: List[String],
    timeout: Integer,
): Result[Integer, String]
    let output := files[0]
    let errors := files[1]
    let input := files[2]
    let dir := files[3]
    let n := len(args)
    let argv := cast[Ptr[CString]](malloc(CSize(8 * (n + 2))))
    deref(argv) := strdup(toCString(path))
    for i := 0 to n - 1 do
        deref(argv + (i + 1)) := strdup(toCString(args[i]))
    deref(argv + (n + 1)) := cast[CString](0)
    let out := toCString(output)
    let err := toCString(errors)
    let inp := toCString(input)
    let cwd := toCString(dir)
    let pid := fork()
    if pid = 0 then
        if input <> "" then
            let fd := cOpen(inp, CInt(0))
            if fd < 0 or dup2(fd, fd2: CInt(0)) < 0 then
                cExit(CInt(127))
        if output <> "" then
            let fd := cOpen(out, CInt(1 + $40 + $200), CInt($1A4))
            if fd < 0 or dup2(fd, fd2: CInt(1)) < 0 then
                cExit(CInt(127))
            if errors = "" and dup2(fd, fd2: CInt(2)) < 0 then
                cExit(CInt(127))
        if errors <> "" then
            let fd := cOpen(err, CInt(1 + $40 + $200), CInt($1A4))
            if fd < 0 or dup2(fd, fd2: CInt(2)) < 0 then
                cExit(CInt(127))
        if dir <> "" and chdir(cwd) <> 0 then
            cExit(CInt(127))
        if timeout > 0 then
            _ := alarm(CUInt(timeout))
        _ := execv(deref(argv), argv)
        cExit(CInt(127))
    var message := ""
    if pid < 0 then
        message := lastError()
    var status := CInt(0)
    if pid > 0 and waitpid(pid, addr(var status), options: CInt(0)) < 0 then
        message := lastError()
    for i := 0 to n do
        free(deref(argv + i))
    freeMemory(cast[Pointer](argv))
    if message <> "" then
        return Err("{path}: {message}")
    let s := Integer(status)
    if band(s, $7F) = 0 then
        return Ok(band(shr(s, 8), $FF))
    return Ok(-band(s, $7F))

test "directories"
    let dir := tempDir().get()
    assert isDir(dir) and not isFile(dir)
    assert realPath("{dir}/.").get() = realPath(dir).get()
    assert makeDir("{dir}/sub").isOk()
    assert makeDir("{dir}/sub").isErr()
    assert listDir(dir).get() = ["sub"]
    assert removeDir("{dir}/sub").isOk()
    assert len(listDir(dir).get()) = 0
    assert removeDir(dir).isOk()
    assert not isDir(dir)
    assert realPath(dir).isErr()

test "running a program"
    let dir := tempDir().get()
    let out := "{dir}/out"
    assert run("/bin/sh", ["-c", "pwd; echo err >&2; exit 3"], output: out, dir: "/") = Ok(3)
    assert isFile(out)
    assert run("/nonexistent", []) = Ok(127)
    assert runFor("/bin/sh", ["-c", "while true; do :; done"], timeout: 1) = Ok(-14)
    assert runFor("/bin/sh", ["-c", "exit 4"], timeout: 1) = Ok(4)
    assert removeFile(out).isOk()
    assert removeFile(out).isErr()
    assert removeDir(dir).isOk()

test "environment"
    assert env("PATH").isSome()
    assert env("PST_NO_SUCH_VARIABLE").isNone()
    assert currentDir() <> ""
